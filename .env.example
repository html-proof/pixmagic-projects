# Repo-root .env: read by tools run on this machine, never by the app itself.
#   docker compose      POSTGRES_PASSWORD, PG_PORT
#   Prisma CLI          DATABASE_URL (pnpm db:migrate)
#   maintenance tasks   DATABASE_URL and the secrets below (pnpm --filter @app/worker ops:*, docs/RUNBOOK.md)
#
# The app's own settings live elsewhere (docs/architecture.md, "Configuration"):
#   App (API, jobs, schedules)  apps/aws/src/settings.ts + the environment's secrets (infra/cdk);
#                               locally apps/aws/.env (copy .env.example)
#   UI build                    nothing: the same build works everywhere (sign-in config is the API's)

# ---- Database: the owner role (migrations, maintenance tasks) ----
# Local development uses app_dev (`pnpm db:migrate` creates it). On the PC that still hosts the old
# deployment's database, `app` on this server is that production data: point DATABASE_URL at it only
# on purpose (docs/RUNBOOK.md), and set it back afterwards.
DATABASE_URL=postgresql://app:app@localhost:5434/app_dev

# ---- docker compose ----
# Only read when the Postgres volume is first created. Anything reachable from elsewhere needs a
# real password: docs/security.md, "Database credentials".
# POSTGRES_PASSWORD=
# PG_PORT=5434

# ---- Maintenance tasks ----
# They load @app/core, whose config check requires these. TOKEN_ENCRYPTION_KEYS must be the
# deployed app's own value, or stored tokens can't be decrypted.
# Format: "<version>:<base64 32-byte key>[,...]"; first is active. openssl rand -base64 32
TOKEN_ENCRYPTION_KEYS=1:REPLACE_WITH_openssl_rand_base64_32
SESSION_SECRET=change-me-32-bytes-minimum-random-string
OTP_PEPPER=change-me-otp-pepper
