# ---- Core ----
NODE_ENV=development
APP_URL=http://localhost:3001
API_URL=http://localhost:4000
DATABASE_URL=postgresql://app:app@localhost:5434/app
# Non-superuser role used by the API/worker so Postgres RLS is enforced
APP_DATABASE_URL=postgresql://app_rls:app_rls@localhost:5434/app
REDIS_URL=redis://localhost:6380
SESSION_SECRET=change-me-32-bytes-minimum-random-string
# 32-byte base64 key(s). Format: "<version>:<base64key>[,<version>:<base64key>]" ; first is active
TOKEN_ENCRYPTION_KEYS=1:REPLACE_WITH_openssl_rand_base64_32
OTP_PEPPER=change-me-otp-pepper

# ---- Firebase ----
FIREBASE_PROJECT_ID=demo-insights
# Service account JSON (base64) - not needed when using the emulator
FIREBASE_SERVICE_ACCOUNT_B64=
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Public Firebase web API key (same value as NEXT_PUBLIC_FIREBASE_API_KEY); redeems emailed sign-in links
FIREBASE_WEB_API_KEY=
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-insights.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-insights
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR=http://127.0.0.1:9099
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- Shopify (Partner dashboard -> app -> Client credentials) ----
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Must mirror [access_scopes] in shopify-app/shopify.app.toml exactly: under Shopify managed
# installation the toml is what merchants are asked to grant, and these vars only record what we
# think we asked for. Changing them never changes an install (docs/shopify-setup.md section 3e).
SHOPIFY_SCOPES=read_orders,read_products
# Empty until protected customer data access is granted AND the dynamic scope request is built.
SHOPIFY_OPTIONAL_SCOPES=read_customers,write_pixels,read_customer_events
SHOPIFY_API_VERSION=2025-10
# Stores the main app may be installed on, comma separated. Leave empty once the app is approved
# for public distribution; until then Shopify refuses it on stores outside your developer
# organization, so list them here and give every other merchant their own app (below).
SHOPIFY_DEFAULT_APP_SHOPS=
# A client's store with its own custom-distribution app (docs/shopify-setup.md). One entry per app;
# each one's client secret goes in SHOPIFY_APP_SECRET_<KEY> (key uppercased).
# SHOPIFY_EXTRA_APPS=[{"key":"pixmagic","clientId":"","shops":["pixmagic.myshopify.com"]}]
# SHOPIFY_APP_SECRET_PIXMAGIC=

# ---- Email ----
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="Insights <no-reply@localhost>"

# ---- Alerts ----
ALERT_SLACK_WEBHOOK_URL=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
