# Repo-root .env: read by tools run on this machine, never by the app itself.
#   docker compose      POSTGRES_PASSWORD, PG_PORT, CLOUDFLARE_TUNNEL_TOKEN
#   Prisma CLI          DATABASE_URL (pnpm db:migrate)
#   maintenance tasks   DATABASE_URL and the secrets below (pnpm --filter @app/worker ops:*, docs/RUNBOOK.md)
#
# The app's own settings live elsewhere (docs/architecture.md, "Configuration"):
#   Worker (API, queues, cron)  apps/cloudflare/wrangler.jsonc "vars" + `wrangler secret put`;
#                               locally apps/cloudflare/.dev.vars (copy .dev.vars.example)
#   UI build                    nothing: the same build works everywhere (sign-in config is the Worker's)

# ---- Database: the owner role (migrations, maintenance tasks) ----
# Local development uses app_dev (`pnpm db:migrate` creates it). Production's database is `app`:
# point DATABASE_URL at it only on purpose, for a maintenance task or a migration before a deploy
# (docs/RUNBOOK.md), and set it back afterwards.
DATABASE_URL=postgresql://app:app@localhost:5434/app_dev

# ---- docker compose ----
# Only read when the Postgres volume is first created. Anything reachable from elsewhere (the
# tunnel to Hyperdrive) needs a real password: docs/security.md, "Database credentials".
# POSTGRES_PASSWORD=
# PG_PORT=5434
# Run token for `docker compose --profile tunnel up -d cloudflared` (docs/deployment-cloudflare.md).
# CLOUDFLARE_TUNNEL_TOKEN=

# ---- Maintenance tasks ----
# They load @app/core, whose config check requires these. TOKEN_ENCRYPTION_KEYS must be the
# deployed Worker's own value, or stored tokens can't be decrypted.
# Format: "<version>:<base64 32-byte key>[,...]"; first is active. openssl rand -base64 32
TOKEN_ENCRYPTION_KEYS=1:REPLACE_WITH_openssl_rand_base64_32
SESSION_SECRET=change-me-32-bytes-minimum-random-string
OTP_PEPPER=change-me-otp-pepper
# Only if the Worker sets EMAIL_CREDENTIAL_KEYS (docs/email.md): the same value, so ops:reencrypt can
# re-wrap stored email credentials.
# EMAIL_CREDENTIAL_KEYS=
