# Local server configuration for Playwright runs and the demos (test values only).
NODE_ENV=development
APP_URL=http://localhost:8789
API_URL=http://localhost:8789/api
MAILPIT_URL=http://localhost:8025
SESSION_SECRET=e2e-session-secret-0123456789
TOKEN_ENCRYPTION_KEYS=1:MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE=
OTP_PEPPER=e2e-pepper-123
# The Cognito emulator's fixed pool and client (infra/cognito-local); its port follows E2E_COGNITO_PORT.
COGNITO_USER_POOL_ID=local_insights
COGNITO_CLIENT_ID=insightslocalwebclient00
COGNITO_CLIENT_SECRET=insights-local-client-secret
COGNITO_ADMIN_ACCESS_KEY_ID=local
COGNITO_ADMIN_SECRET_ACCESS_KEY=local
SHOPIFY_API_KEY=e2e_key
SHOPIFY_API_SECRET=e2e_secret
SHOPIFY_SCOPES=read_orders,read_products
# Declares ONE optional scope, so a single dashboard shows all three locked-module states:
# read_products reconnectable, read_customers requestable ("Enable"), the funnel's scopes neither.
# Test values only - production ships SHOPIFY_OPTIONAL_SCOPES empty until Shopify approves the
# app for protected customer data (docs/shopify-setup.md 3e, enforced by appConfig.test.ts).
SHOPIFY_OPTIONAL_SCOPES=read_customers
LOG_LEVEL=warn
# WhatsApp Automation: Meta's Graph API is e2e/meta-graph-stub.mjs (the server sends Meta's calls to
# LOCAL_GRAPH_URL, from playwright.config.ts, E2E_GRAPH_PORT), and the Meta values below are its app's
# test values, so e2e/whatsapp.spec.ts connects through Embedded Signup end to end and nothing reaches
# Meta. Evolution API (e2e/evolution-stub.mjs) is only what is left of QR linking. (Ad platforms stay
# unset: a test that needs their Connect stubs it.)
EVOLUTION_API_KEY=e2e-evolution-key
EVOLUTION_SHARD=a
WHATSAPP_APP_ID=e2e_meta_app
WHATSAPP_CONFIG_ID=e2e_config
WHATSAPP_APP_SECRET=e2e_meta_secret
WHATSAPP_WEBHOOK_VERIFY_TOKEN=e2e_verify_token
# The Google Ads demo ("Try demo"): a simulated account, nothing reaches Google (docs/ads-demo.md).
GOOGLE_ADS_DEMO_ENABLED=1
# Customer Messaging runs in test mode here (texts to customers are recorded, test texts reach the
# stand-in for AWS), with marketing texts off: production is live (apps/aws/src/settings.ts), and
# apps/api/test/smsReadiness.test.ts drives the live path.
SMS_MODE=sandbox
SMS_MARKETING_ENABLED=
