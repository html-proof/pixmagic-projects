# Firebase web config, baked into the static UI at build time (copy to .env.local for local builds,
# .env.production or CI variables for deploys). Public values: they ship to every browser.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-insights.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-insights
# Local only: sign in against the Firebase Auth emulator (docker compose). A build into `out` or
# `out-deploy` (what gets deployed) refuses to run with this set: build with NEXT_EXPORT_DIR=out-local.
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR=http://127.0.0.1:9099
