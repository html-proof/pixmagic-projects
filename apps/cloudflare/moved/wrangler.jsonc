{
  "$schema": "../node_modules/wrangler/config-schema.json",
  // The old address after the move to AWS (moved/index.ts, docs/aws-deployment.md "Cutover").
  // Same Worker as the app ("insights"), uploaded as a version and deployed in its place:
  //   npx wrangler versions upload --config moved/wrangler.jsonc --var MOVE_PHASE:maintenance
  // Never `wrangler deploy` this: that would also replace the app's triggers and queue consumers.
  "name": "insights",
  "main": "index.ts",
  "compatibility_date": "2026-10-01",

  "vars": {
    "MOVED_TO": "https://d2mr8m2p1qkh58.cloudfront.net",
    "MOVE_PHASE": "maintenance"
  },

  // The app's Durable Object, kept valid (and its data kept) for a rollback.
  "durable_objects": { "bindings": [{ "name": "COORD", "class_name": "Coordinator" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Coordinator"] }],

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": true }
  }
}
