{
  "$schema": "node_modules/wrangler/config-schema.json",
  // One Worker serves everything:
  //   - the web UI (static Next.js export) from Workers Static Assets
  //   - the API under /api/* (and un-prefixed /webhooks, /pixel, /shopify for a dedicated API hostname)
  //   - Queue consumers (sync, webhooks, aggregate) and Cron Triggers (reconcile, token refresh)
  "name": "insights",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "../web/out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/webhooks/*", "/pixel/*", "/shopify/*", "/healthz", "/readyz"]
  },

  // Non-secret configuration. Secrets (SESSION_SECRET, TOKEN_ENCRYPTION_KEYS, OTP_PEPPER,
  // SHOPIFY_API_SECRET, FIREBASE_SERVICE_ACCOUNT_B64, ALERT_SLACK_WEBHOOK_URL, for ad accounts
  // META_APP_SECRET, GOOGLE_ADS_CLIENT_SECRET, and for WhatsApp
  // WHATSAPP_APP_SECRET, WHATSAPP_WEBHOOK_VERIFY_TOKEN) are set with
  // `wrangler secret put`; for local dev put everything in apps/cloudflare/.dev.vars.
  "vars": {
    "NODE_ENV": "production",
    "APP_URL": "https://bizinsights.io",
    "API_URL": "https://bizinsights.io/api",
    "FIREBASE_PROJECT_ID": "saas-89329",
    // Public web API key (same as NEXT_PUBLIC_FIREBASE_API_KEY): redeems emailed sign-in links.
    "FIREBASE_WEB_API_KEY": "AIzaSyDsrFIOe52bv3ZD0PM_h_l6_Tm9q7Uzq4s",
    "SHOPIFY_API_KEY": "57e9ef75435db908617fdd46099afe0e",
    "SHOPIFY_SCOPES": "read_orders,read_products",
    // NOTE: under Shopify managed installation (use_legacy_install_flow = false) these two vars do
    // NOT decide what merchants are asked to grant - shopify-app/shopify.app.toml does, and only
    // `shopify app deploy` changes it. Clearing this var does not stop Shopify requesting a scope;
    // removing it from the toml and redeploying does. Keep both in step: the build fails otherwise
    // (packages/core/test/appConfig.test.ts). See docs/shopify-setup.md section 3e.
    "SHOPIFY_OPTIONAL_SCOPES": "read_customers,write_pixels,read_customer_events",
    "SHOPIFY_API_VERSION": "2025-10",
    // Stores the main app may be installed on. Empty means any store, which only holds once
    // Shopify has approved it for public distribution: until then it installs only on stores in
    // our developer organization, and anyone else gets "This installation link can't be used".
    // List those stores here and a merchant we can't serve is told so, instead of being sent to
    // a Shopify page that cannot work. Client stores get their own app below.
    "SHOPIFY_DEFAULT_APP_SHOPS": "",
    // Client stores with their own custom-distribution app (docs/shopify-setup.md, "A client's
    // store with its own app"). Fill in the client id from the Dev Dashboard and set the secret
    // with `npx wrangler secret put SHOPIFY_APP_SECRET_PIXMAGIC`, then deploy.
    "SHOPIFY_EXTRA_APPS": "[{\"key\":\"pixmagic\",\"clientId\":\"bb0ea9e4ad8939a6a1513e4dbf8cbbf1\",\"shops\":[\"pixmagic.myshopify.com\"]}]",
    // Must be an address on a domain onboarded to Cloudflare Email Sending. Until then, sign-in
    // codes fall back to one-click links that Firebase emails (see docs/shopify-setup.md).
    "EMAIL_FROM": "Insights <no-reply@example.com>",
    // Ad accounts ("Continue with Meta" / "Continue with Google Ads" / "Continue with Google AdSense"
    // on Settings → Ad accounts). Empty until the apps exist: the buttons then say the platform isn't
    // set up. GOOGLE_ADS_CLIENT_ID is the Google Cloud OAuth client "Insights web" (project
    // insights-511119), shared by Google Ads and AdSense. Set the secrets, then deploy.
    // docs/ads-setup.md walks through all three.
    // Meta Ads: the Meta app "Insights" (971575545351940, Facebook account sebanceo@gmail.com, created 2026-10-11; use case
    // "Measure ad performance data with Marketing API"). Meta Ads stays "Coming soon" until META_APP_SECRET is set
    // (wrangler secret put). WhatsApp runs on its own app (WHATSAPP_APP_ID below) and never borrows this app's secret.
    "META_APP_ID": "971575545351940",
    "META_API_VERSION": "v25.0",
    // Facebook Login for Business configuration "Insights ads reporting": user access token, ads_read only.
    "META_CONFIG_ID": "1521935306664882",
    "GOOGLE_ADS_CLIENT_ID": "534794119904-9esdp8dhskcupf6ekbb0iej2dr10gomf.apps.googleusercontent.com",
    "GOOGLE_ADS_API_VERSION": "v25",
    // "1" once project insights-511119 has Google Ads API access for real accounts (Explorer or above,
    // Cloud console → Google Ads API → Overview) and the adwords scope is on its consent screen. Google
    // retired developer tokens on 2026-09-09, so there is no token to set. Empty: "Coming soon".
    // Explorer granted 2026-10-11 (2,880 operations a day on real accounts).
    "GOOGLE_ADS_ENABLED": "1",
    // WhatsApp Business Platform (Cloud API), docs/whatsapp.md. "Connect WhatsApp Business" (Meta's
    // Embedded Signup) needs the Meta app id (empty: META_APP_ID is used), the Facebook Login for
    // Business configuration id of its WhatsApp Embedded Signup variation, and the secrets
    // WHATSAPP_APP_SECRET (or META_APP_SECRET) and WHATSAPP_WEBHOOK_VERIFY_TOKEN. Until then the
    // dashboard says it isn't set up, and merchants can still connect with their own Meta app.
    // WhatsApp's Meta app: "pixmagic" (1799660384680551, portfolio "Testbusiness", the imeseban@gmail.com Facebook account).
    "WHATSAPP_APP_ID": "1799660384680551",
    "WHATSAPP_CONFIG_ID": "",
    "WHATSAPP_API_VERSION": "v25.0"
  },

  // Postgres through Hyperdrive: owner role (migrations/system paths) and the RLS-enforced app_rls role.
  // Create with `wrangler hyperdrive create ...` (see docs/deployment-cloudflare.md) and paste the ids.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "eec0593e76144cbcb0c4bb653a0cb647",
      "localConnectionString": "postgresql://app:app@localhost:5434/app"
    },
    {
      "binding": "HYPERDRIVE_RLS",
      "id": "5646bc5ea5424144bf2f12167be10dec",
      "localConnectionString": "postgresql://app_rls:app_rls@localhost:5434/app"
    }
  ],

  "queues": {
    "producers": [
      { "binding": "SYNC_QUEUE", "queue": "insights-sync" },
      { "binding": "WEBHOOK_QUEUE", "queue": "insights-webhooks" },
      { "binding": "AGGREGATE_QUEUE", "queue": "insights-aggregate" }
    ],
    // max_retries + 1 must equal MAX_ATTEMPTS in packages/core/src/queues.ts.
    // Shopify limits are per shop and the GraphQL client paces itself, so concurrency stays modest.
    "consumers": [
      { "queue": "insights-sync", "max_batch_size": 1, "max_concurrency": 4, "max_retries": 5, "dead_letter_queue": "insights-dlq" },
      { "queue": "insights-webhooks", "max_batch_size": 10, "max_batch_timeout": 2, "max_concurrency": 10, "max_retries": 5, "dead_letter_queue": "insights-dlq" },
      // max_batch_timeout 1, not 5: day totals are the last step of an import, so this timeout
      // was up to 5s of an otherwise finished import spent waiting for a batch to fill.
      { "queue": "insights-aggregate", "max_batch_size": 5, "max_batch_timeout": 1, "max_concurrency": 4, "max_retries": 5, "dead_letter_queue": "insights-dlq" }
    ]
  },

  // Webhook payloads too large for a queue message (deleted once processed).
  // TODO: re-enable once R2 is active on the account (wrangler r2 bucket create insights-webhook-payloads).
  // "r2_buckets": [{ "binding": "PAYLOADS", "bucket_name": "insights-webhook-payloads" }],

  // Rate-limit counters, one-time OAuth state and token-refresh locks (one object per key).
  "durable_objects": { "bindings": [{ "name": "COORD", "class_name": "Coordinator" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Coordinator"] }],

  // Coarse per-IP API limit (replaces the 300/min global limiter).
  "ratelimits": [{ "name": "GLOBAL_LIMITER", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } }],

  // Transactional email (OTP codes, invitations, alerts). The EMAIL_FROM domain must be onboarded.
  "send_email": [{ "name": "EMAIL" }],

  // Keep in sync with CRON in apps/worker/src/index.ts.
  "triggers": { "crons": ["15 3 * * *", "*/15 * * * *"] },

  // The Free plan caps a request at 10 ms of CPU, and this app needs ~15 ms for a signed-in
  // request (Firebase session verify + a few Prisma queries), so a share of them is killed with
  // "Worker exceeded resource limits" (Cloudflare error 1102) - see docs/deployment-cloudflare.md.
  // On the Workers Paid plan the default becomes 30 s; uncomment this for the long sync pages,
  // which wait on Shopify's rate limiter.
  // "limits": { "cpu_ms": 120000 },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }

  // Custom domain (uncomment after the zone is on Cloudflare):
  // "routes": [{ "pattern": "app.example.com", "custom_domain": true }]
}
