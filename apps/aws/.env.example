# Settings for the local server, `pnpm --filter @app/aws dev` (copy to apps/aws/.env; never commit
# it). Values here override the shared settings in src/settings.ts; the shell's environment
# overrides both.
NODE_ENV=development
APP_URL=http://localhost:8787
API_URL=http://localhost:8787/api

# Postgres: the owner role and the RLS-enforced app_rls role, on the local database app_dev, never
# `app` (docs/local-dev.md).
DATABASE_URL=postgresql://app:app@localhost:5434/app_dev
APP_DATABASE_URL=postgresql://app_rls:app_rls@localhost:5434/app_dev

SESSION_SECRET=change-me-32-bytes-minimum-random-string
# Format: "<version>:<base64 32-byte key>[,...]"; first is active. openssl rand -base64 32
TOKEN_ENCRYPTION_KEYS=1:REPLACE_WITH_openssl_rand_base64_32
OTP_PEPPER=change-me-otp-pepper
# Key of stored customer and WhatsApp-number hashes; empty means OTP_PEPPER (see docs/RUNBOOK.md
# before rotating OTP_PEPPER).
CUSTOMER_HASH_KEY=

# Sign-in: the local Cognito emulator (docker compose up -d cognito, or node infra/cognito-local/start.mjs),
# whose pool and client are fixed (infra/cognito-local/README.md). For a real user pool instead, drop
# COGNITO_ENDPOINT and use the stack's outputs and secrets (docs/cognito-setup.md).
COGNITO_ENDPOINT=http://127.0.0.1:9229
COGNITO_USER_POOL_ID=local_insights
COGNITO_CLIENT_ID=insightslocalwebclient00
COGNITO_CLIENT_SECRET=insights-local-client-secret
COGNITO_ADMIN_ACCESS_KEY_ID=local
COGNITO_ADMIN_SECRET_ACCESS_KEY=local
# Google needs a real pool's domain (the emulator has no managed login).
COGNITO_DOMAIN=
COGNITO_IDENTITY_PROVIDERS=

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Ad accounts (optional; docs/ads-setup.md): bizinsights' own Meta app and Google OAuth client, which
# bizinsights signs in with itself. Redirect URIs to register: <APP_URL>/api/ads/meta/callback (Meta app →
# Facebook Login for Business → Settings), <APP_URL>/api/ads/google/callback and
# <APP_URL>/api/ads/adsense/callback (the Google OAuth client). META_APP_SECRET signs every Meta call.
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
# "1" once the Meta app has Advanced Access to ads_read; empty: only the app's testers can connect.
META_ADS_ADVANCED_ACCESS=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_ENABLED=
# Google Ads API operations a day for the whole project; empty: Explorer access's 2,880.
GOOGLE_ADS_DAILY_OPERATIONS=
# "1": the Google Ads card offers "Try demo", a simulated account (docs/ads-demo.md); needs no Google settings.
GOOGLE_ADS_DEMO_ENABLED=1
# Meta's deauthorize and data deletion callbacks (Meta app → Facebook Login for Business → Settings,
# and App settings → Basic): <API_URL>/webhooks/meta/deauthorize and <API_URL>/webhooks/meta/data-deletion.
# WhatsApp Automation (optional; docs/whatsapp.md). Connections run on Evolution API: locally the
# docker-compose service "evolution" (docker compose up evolution). EVOLUTION_API_URL is its address,
# EVOLUTION_API_KEY its global key (the compose file's EVOLUTION_API_KEY), EVOLUTION_WEBHOOK_URL where
# the container reaches this server's API (its webhooks go to <that>/webhooks/whatsapp/evolution/...).
# Without the URL and key, connecting WhatsApp is off and the page says so.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_SHARD=a
EVOLUTION_WEBHOOK_URL=
# The Cloud API option (Meta's Embedded Signup). Meta webhook callback URL: <API_URL>/webhooks/whatsapp.
# Locally, use a Meta app of your own (a test app), never production's values; production's live in
# AWS Secrets Manager.
# - WHATSAPP_APP_ID: the Meta app stores connect through (App settings → Basic → App ID); empty
#   uses META_APP_ID.
# - WHATSAPP_APP_SECRET: that app's secret (App settings → Basic); empty uses META_APP_SECRET only
#   when WhatsApp runs on the Meta Ads app. Meta signs every webhook with it. Secret.
# - WHATSAPP_CONFIG_ID: the id of the app's Facebook Login for Business configuration of the
#   "WhatsApp Embedded Signup" login variation, v4 (not a secret: Meta's SDK needs it in the page).
# - WHATSAPP_WEBHOOK_VERIFY_TOKEN: a long random string Meta repeats back when it checks the webhook
#   address (e.g. `openssl rand -hex 32`). Secret.
# - WHATSAPP_API_VERSION: the Graph API version (default v26.0).
# - WHATSAPP_TOKEN_CONNECT_WORKSPACES: workspace ids (comma-separated) that may also connect with a
#   token of that app made in Meta's dashboard instead of Meta's window; empty: no one.
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_CONFIG_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v26.0
WHATSAPP_TOKEN_CONNECT_WORKSPACES=
EMAIL_FROM="bizinsights <no-reply@localhost>"
# Zapier (optional; docs/zapier.md). bizinsights is the OAuth provider of its Zapier app: the client id and
# secret are values you choose and also enter in the Zapier app's environment (CLIENT_ID, CLIENT_SECRET);
# the redirect URI is the one the Zapier app shows (exact match). Empty: every Zapier endpoint answers
# not_configured. ZAPIER_INVITE_URL: the app's invite link, what Settings → Integrations' Connect opens.
# ZAPIER_CLIENT_SECRET_PREVIOUS: only during a secret rotation, the old secret (docs/RUNBOOK.md).
ZAPIER_CLIENT_ID=
ZAPIER_CLIENT_SECRET=
ZAPIER_CLIENT_SECRET_PREVIOUS=
ZAPIER_REDIRECT_URI=
ZAPIER_INVITE_URL=
# Local only: deliver mail to Mailpit (docker compose). Without it, mail is only logged.
MAILPIT_URL=http://localhost:8025
ALERT_SLACK_WEBHOOK_URL=
LOG_LEVEL=debug
