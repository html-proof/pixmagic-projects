// Tenant model: Workspace -> Membership(User, role) -> Store -> store-scoped data.
// Every store-scoped table carries workspace_id so Postgres RLS can enforce
// isolation without joins (see migrations/*_rls). No customer PII is stored:
// customers are reduced to a salted hash (customer_key).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  // Node everywhere: the Lambda functions, the local server, tests and scripts.
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Owners and admins run the workspace. Every other role sees exactly the permissions granted to it
/// (memberships.permissions, packages/shared/src/access.ts); the role is the template they came from.
enum Role {
  owner
  admin
  analyst
  viewer
  manager
  custom
}

/// A member's role in Staff Management, on top of their workspace role (owners and admins have
/// every staff permission already). See packages/shared/src/staff/access.ts.
enum StaffRole {
  hr_manager
  payroll_manager
  supervisor
}

enum StoreStatus {
  pending
  syncing
  active
  uninstalled
  error
}

enum JobStatus {
  queued
  running
  succeeded
  failed
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  emailVerified Boolean      @default(false) @map("email_verified")
  displayName   String?      @map("display_name")
  /// The profile picture's address, from the Google account the account was made with or signs in
  /// with under its own address (apps/api/src/identity.ts). https only; null when there is none.
  avatarUrl     String?      @map("avatar_url")
  timezone      String       @default("UTC")
  /// "Sign out everywhere": sessions issued before this instant are no longer accepted.
  sessionsValidAfter DateTime? @map("sessions_valid_after")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  memberships   Membership[]
  identities    AuthIdentity[]
  /// Where this account is signed in (Settings → Security).
  sessions      UserSession[]
  /// Members and invitations this person brought into a workspace (Team & Access).
  invitedMembers     Membership[] @relation("MembershipInviter")
  sentInvitations    Invitation[] @relation("InvitationInviter")
  /// Employee records this account signs in as (employee portal).
  employments   Employee[]   @relation("EmployeeAccount")
  /// Employees this person is the assigned manager of.
  managedStaff  Employee[]   @relation("EmployeeManager")

  @@map("users")
}

/// A sign-in identity of a user: one Cognito user (password or Google). Several can point at
/// the same user, which is how an account is linked across sign-in methods; users.id never changes.
model AuthIdentity {
  id                String    @id @default(cuid())
  userId            String    @map("user_id")
  /// "cognito".
  provider          String
  /// The Cognito user's `sub`.
  subject           String
  /// The Cognito user name (what refresh and admin calls address it by).
  username          String
  /// How this Cognito user signs in: "password" or "google".
  method            String
  email             String?
  createdAt         DateTime  @default(now()) @map("created_at")
  lastUsedAt        DateTime? @map("last_used_at")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
  @@map("auth_identities")
}

/// Account-level security events (sign-in identity linked, password or email changed, signed out
/// everywhere, account deleted). Workspace actions go to audit_logs.
model AuthEvent {
  id        String   @id @default(cuid())
  /// Null once the account is deleted (the row stays, with no link to a person).
  userId    String?  @map("user_id")
  type      String
  ip        String?
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("auth_events")
}

/// A signed-in browser: one row per session (apps/api/src/session.ts), for the device list in
/// Settings → Security and for signing one device out. The session itself is the cookie; this row
/// only describes it. Ended rows (signed out, removed, or past expires_at) are deleted by a sweep.
model UserSession {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  /// The session's id (SessionClaims.sid): what signing this device out retires.
  sid        String    @unique
  /// How it signed in: "password" or "google".
  method     String
  /// What the browser says about itself (DeviceInfo in @app/shared/device).
  device     Json?
  /// Where it was last seen from: its address, and the country (ISO code), region and city the
  /// edge read from it. Approximate, for recognising a device only.
  ip         String?
  country    String?
  region     String?
  city       String?
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  expiresAt  DateTime  @map("expires_at")
  /// Signed out on that device, or removed from another one.
  endedAt    DateTime? @map("ended_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastSeenAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

model Workspace {
  id           String        @id @default(cuid())
  name         String
  createdAt    DateTime      @default(now()) @map("created_at")
  /// Made for a store installed from Shopify before anyone had a login for it, and not claimed yet
  /// (apps/api/src/routes/shopify.ts). Only such a workspace can be claimed, or left for another.
  awaitingClaim Boolean      @default(false) @map("awaiting_claim")
  memberships  Membership[]
  stores       Store[]
  apiKeys      ApiKey[]
  auditLogs    AuditLog[]
  alerts       Alert[]
  invitations  Invitation[]
  subscription Subscription?
  staffSettings      StaffSettings?
  employees          Employee[]
  departments        Department[]
  overtimePolicies   OvertimePolicy[]
  breakPolicies      BreakPolicy[]
  staffHolidays      StaffHoliday[]
  payrollPeriods     PayrollPeriod[]
  emailSettings      EmailSettings?
  emailAccounts      EmailAccount[]
  emailDomains       EmailDomain[]
  emailTemplates     EmailTemplate[]
  emailRules         EmailAutomationRule[]
  emailEvents        EmailBusinessEvent[]
  emailSuppressions  EmailSuppression[]
  dataRequests       DataRequest[]
  emailIngestKeys    EmailIngestKey[]
  emailDeliveries    EmailDelivery[]

  @@map("workspaces")
}

model Membership {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  userId      String    @map("user_id")
  role        Role
  /// Staff Management role for members who are not owners or admins (null: no staff access).
  staffRole   StaffRole? @map("staff_role")
  /// Team & Access: the permissions granted to a restricted role (packages/shared/src/access.ts).
  /// Owners and admins have every permission and keep this empty.
  permissions String[]  @default([])
  /// Access revoked by an owner or admin: the membership stays, so it can be restored, but grants
  /// nothing until then. Every access check refuses a revoked membership.
  revokedAt   DateTime? @map("revoked_at")
  /// Who invited them (null for a workspace's creator and members from before Team & Access).
  invitedById String?   @map("invited_by_id")
  /// When their role or permissions last changed.
  accessChangedAt DateTime? @map("access_changed_at")
  /// Access given by an invitation ends here (60 days unless the inviter chose less) until an owner
  /// or admin renews it; null: no end (owners, and members from before invitations expired).
  accessExpiresAt DateTime? @map("access_expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy   User?     @relation("MembershipInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([invitedById])
  @@map("memberships")
}

/// An invitation to a workspace (Team & Access). Single use: only the token's hash is stored, and
/// accepting, revoking or expiry ends it for good. Kept after it ends, for the team page's counts and
/// the audit trail, until the daily retention sweep removes it (apps/worker, pruneTeamRecords).
model Invitation {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  email       String
  role        Role
  staffRole   StaffRole? @map("staff_role")
  /// The permissions the member will have once they accept (restricted roles only).
  permissions String[]  @default([])
  /// The inviter's note, shown in the email and on the invitation page.
  message     String?
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  acceptedById String?  @map("accepted_by_id")
  revokedAt   DateTime? @map("revoked_at")
  invitedById String?   @map("invited_by_id")
  /// The last time the email went out, and the last time sending it failed.
  sentAt      DateTime? @map("sent_at")
  sendFailedAt DateTime? @map("send_failed_at")
  sendCount   Int       @default(0) @map("send_count")
  /// The link's token, encrypted with the app's keyring (AES-256-GCM, bound to this invitation), so an
  /// owner or admin can copy the same link again. Never stored in the clear: a copy of the database
  /// alone opens nothing. Null for invitations from before (their link can only be replaced).
  tokenSealed String?   @map("token_sealed")
  /// The last time the link opened the dashboard, and how many times it has.
  lastOpenedAt DateTime? @map("last_opened_at")
  openCount   Int       @default(0) @map("open_count")
  createdAt   DateTime  @default(now()) @map("created_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy   User?     @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  deliveries  EmailDelivery[]

  @@index([workspaceId])
  @@index([workspaceId, email])
  @@index([invitedById])
  @@map("invitations")
}

/// One transactional email handed to the mail provider (a Team & Access invitation for now): which
/// provider took it, its id there, and what the provider has reported since (delivered, bounced,
/// marked as spam). No address or content is kept here; the invitation holds the address.
model EmailDelivery {
  id                String    @id @default(cuid())
  workspaceId       String    @map("workspace_id")
  invitationId      String?   @map("invitation_id")
  /// "team_invitation"
  kind              String
  /// "resend", "ses", "mailpit", "log"
  provider          String
  providerMessageId String?   @map("provider_message_id")
  /// queued, sent, delivered, delayed, bounced, complained, failed, not_allowed (packages/core/src/mail)
  status            String
  errorCode         String?   @map("error_code")
  /// What the provider said, without the recipient's address.
  errorMessage      String?   @map("error_message")
  attempts          Int       @default(0)
  sentAt            DateTime? @map("sent_at")
  deliveredAt       DateTime? @map("delivered_at")
  /// The provider's last event (delivered, bounced, complained) as it timed it.
  lastEventAt       DateTime? @map("last_event_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  workspace         Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitation        Invitation? @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@unique([provider, providerMessageId])
  @@index([invitationId, createdAt])
  @@index([workspaceId])
  @@map("email_deliveries")
}

model NotificationPreference {
  userId       String  @map("user_id")
  workspaceId  String  @map("workspace_id")
  syncFailures Boolean @default(true) @map("sync_failures")
  weeklyDigest Boolean @default(false) @map("weekly_digest")
  productNews  Boolean @default(false) @map("product_news")
  // Low-stock and out-of-stock emails (the Inventory module's alerts).
  stockAlerts  Boolean @default(true) @map("stock_alerts")

  @@id([userId, workspaceId])
  @@map("notification_preferences")
}

model Store {
  id                    String      @id @default(cuid())
  workspaceId           String      @map("workspace_id")
  shopDomain            String      @unique @map("shop_domain")
  // Which of our Shopify apps the store is connected through ("default" = SHOPIFY_API_KEY;
  // others come from SHOPIFY_EXTRA_APPS, e.g. a custom-distribution app for one client).
  shopifyAppKey         String      @default("default") @map("shopify_app_key")
  name                  String?
  timezone              String      @default("UTC")
  currency              String      @default("USD")
  status                StoreStatus @default(pending)
  // AES-256-GCM ciphertexts (packages/shared/crypto.ts); never returned by the API.
  accessTokenEnc        String?     @map("access_token_enc")
  refreshTokenEnc       String?     @map("refresh_token_enc")
  accessTokenExpiresAt  DateTime?   @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime?   @map("refresh_token_expires_at")
  tokenKeyVersion       Int?        @map("token_key_version")
  grantedScopes         String[]    @map("granted_scopes")
  pixelInstalled        Boolean     @default(false) @map("pixel_installed")
  // From when the web pixel counts the store's visits: when bizinsights first had it in place (the
  // install_pixel job, or the first event accepted before it), keeping the earliest; null with no
  // pixel yet. The dashboard compares visits only with dates from then on ("No earlier data").
  pixelInstalledAt      DateTime?   @map("pixel_installed_at")
  pixelIngestKey        String?     @unique @map("pixel_ingest_key")
  installedAt           DateTime?   @map("installed_at")
  uninstalledAt         DateTime?   @map("uninstalled_at")
  lastSyncedAt          DateTime?   @map("last_synced_at")
  // From when every Shopify order of the store is imported: the start of the earliest completed
  // import window (Shopify shares 60 days without read_all_orders), the epoch when the whole
  // history was imported, null when no import has recorded it. Set by the worker's orders sync.
  ordersHistoryFrom     DateTime?   @map("orders_history_from")
  // From when every stored order carries its customer (read_customers; docs/customer-analytics.md):
  // the moment the store granted it (core `customersFromChange`), moved back to the start of the
  // first full orders import queued since then once it is in (the epoch for the whole history; the
  // worker's orders sync). Null without read_customers, and for a store that granted it before this
  // column existed: the customer report then infers the day from the orders (`customersKnownDay`).
  customersFrom         DateTime?   @map("customers_from")
  // When Shopify created the store (Shop.createdAt), read with its details by the "shop" sync job;
  // null until it has been. The dashboard's dates begin on its day, or an earlier order's
  // (storeStartDay in @app/shared/dates): the earliest day custom dates may start, the years offered.
  shopCreatedAt         DateTime?   @map("shop_created_at")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")
  workspace             Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  billedSubscriptions   Subscription[]
  shopifyReports        ShopifyReport[]
  reconciliations       Reconciliation[]
  inventoryLocations    InventoryLocation[]
  inventoryLevels       InventoryLevel[]
  inventoryMovements    InventoryMovement[]
  inventorySnapshots    InventorySnapshot[]
  inventoryAdjustments  InventoryAdjustment[]
  inventorySettings     InventorySettings?
  salesCalculation      SalesCalculation?
  inventoryAlerts       InventoryAlert[]
  inventorySyncRuns     InventorySyncRun[]
  expenses              StoreExpense[]
  expenseSettings       StoreExpenseSettings?
  businessEvents        BusinessEvent[]

  @@index([workspaceId])
  @@map("stores")
}

model WebhookEvent {
  id          String    @id @default(cuid())
  webhookId   String    @unique @map("webhook_id")
  shopDomain  String    @map("shop_domain")
  topic       String
  storeId     String?   @map("store_id")
  workspaceId String?   @map("workspace_id")
  status      JobStatus @default(queued)
  attempts    Int       @default(0)
  error       String?
  receivedAt  DateTime  @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")

  @@index([shopDomain, topic])
  @@index([status])
  // The dashboard's freshness (reports/overview.ts dataFreshness) reads one store's recent events on every poll.
  @@index([storeId, receivedAt])
  @@map("webhook_events")
}

model Product {
  id                String    @id @default(cuid())
  workspaceId       String    @map("workspace_id")
  storeId           String    @map("store_id")
  shopifyId         String    @map("shopify_id")
  title             String
  status            String?
  vendor            String?
  productType       String?   @map("product_type")
  shopifyCreatedAt  DateTime? @map("shopify_created_at")
  shopifyUpdatedAt  DateTime  @map("shopify_updated_at")
  // Product information for the Inventory module (null on rows stored before it read them; the
  // next catalog sync fills them in). `description` is Shopify's plain-text description, cut at
  // 5,000 characters; `category` the taxonomy category's full name; `collections` [{id, title}]
  // (the first 10, numeric ids); `imageUrl` the featured image.
  handle            String?
  description       String?
  tags              String[]  @default([])
  category          String?
  collections       Json?
  imageUrl          String?   @map("image_url")
  onlineStoreUrl    String?   @map("online_store_url")
  // The merchant's own low-stock threshold for every variant of the product (null: the store's).
  lowStockThreshold Int?      @map("low_stock_threshold")

  @@unique([storeId, shopifyId])
  @@index([workspaceId])
  @@map("products")
}

// One row per product variant: price, stock and unit cost (inventory module).
model ProductVariant {
  id                String    @id @default(cuid())
  workspaceId       String    @map("workspace_id")
  storeId           String    @map("store_id")
  productShopifyId  String    @map("product_shopify_id")
  shopifyId         String    @map("shopify_id")
  title             String
  sku               String?
  price             Decimal   @db.Decimal(18, 2)
  // Total sellable quantity across locations; null when Shopify doesn't track inventory for it.
  inventoryQuantity Int?      @map("inventory_quantity")
  unitCost          Decimal?  @map("unit_cost") @db.Decimal(18, 2)
  shopifyUpdatedAt  DateTime  @map("shopify_updated_at")
  // The variant's InventoryItem (numeric id; one per variant): what its stock levels are keyed by
  // (inventory_levels.inventory_item_id). Null until a catalog sync since the Inventory module read it.
  inventoryItemId   String?   @map("inventory_item_id")
  barcode           String?
  compareAtPrice    Decimal?  @map("compare_at_price") @db.Decimal(18, 2)
  // [{name, value}]: size, colour, material...
  options           Json?
  taxable           Boolean?
  // "deny" | "continue": whether Shopify keeps selling it when it is out of stock.
  inventoryPolicy   String?   @map("inventory_policy")
  requiresShipping  Boolean?  @map("requires_shipping")
  weight            Decimal?  @db.Decimal(18, 4)
  // GRAMS | KILOGRAMS | OUNCES | POUNDS, as Shopify names them.
  weightUnit        String?   @map("weight_unit")
  position          Int?
  shopifyCreatedAt  DateTime? @map("shopify_created_at")
  // The merchant's own low-stock threshold for this variant (null: the product's, else the store's).
  lowStockThreshold Int?      @map("low_stock_threshold")

  @@unique([storeId, shopifyId])
  @@index([storeId, productShopifyId])
  @@index([storeId, inventoryItemId])
  @@index([workspaceId])
  @@map("product_variants")
}

// ------------------------------------------------------------------ Inventory module
// docs/inventory.md. Shopify keeps stock per InventoryItem (one per variant) per Location, in
// separate quantity states; these tables mirror that and nothing is ever derived from guesses.
// Ids are Shopify's numeric ids (gid://shopify/<Type>/<id> without the prefix), as elsewhere.

// A Shopify location (warehouse, shop, app-managed). Kept with `deletedAt` once Shopify drops it,
// so the stock history that names it still can.
model InventoryLocation {
  id                   String    @id @default(cuid())
  workspaceId          String    @map("workspace_id")
  storeId              String    @map("store_id")
  shopifyId            String    @map("shopify_id")
  name                 String
  isActive             Boolean   @map("is_active")
  // Managed by a fulfillment service app (Shopify's "legacy" locations).
  isFulfillmentService Boolean   @default(false) @map("is_fulfillment_service")
  fulfillsOnlineOrders Boolean?  @map("fulfills_online_orders")
  // {address1, address2, city, province, zip, country, countryCode}; null when Shopify gave none.
  address              Json?
  formattedAddress     String?   @map("formatted_address")
  syncedAt             DateTime  @map("synced_at")
  deletedAt            DateTime? @map("deleted_at")
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, shopifyId])
  @@index([workspaceId])
  @@map("inventory_locations")
}

// One inventory item at one location, with every quantity state Shopify reports for it, as last
// read from Shopify. `on_hand` = available + committed + reserved + damaged + safety_stock +
// quality_control (Shopify's rule); `incoming` is separate.
model InventoryLevel {
  id                String   @id @default(cuid())
  workspaceId       String   @map("workspace_id")
  storeId           String   @map("store_id")
  inventoryItemId   String   @map("inventory_item_id")
  locationShopifyId String   @map("location_shopify_id")
  available         Int
  onHand            Int      @map("on_hand")
  committed         Int
  incoming          Int
  reserved          Int
  damaged           Int
  safetyStock       Int      @map("safety_stock")
  qualityControl    Int      @map("quality_control")
  // InventoryLevel.updatedAt: older reads never overwrite newer ones (webhooks arrive out of order).
  shopifyUpdatedAt  DateTime @map("shopify_updated_at")
  // When bizinsights last read it from Shopify (a sync, a check, a webhook's re-read).
  syncedAt          DateTime @map("synced_at")
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, inventoryItemId, locationShopifyId])
  @@index([storeId, locationShopifyId])
  @@index([workspaceId])
  @@map("inventory_levels")
}

// A change in a quantity state that bizinsights saw: the value before (null the first time it was
// seen) and after. `source` says how it was seen: "webhook" (Shopify announced it and we read the
// level), "sync" (an import or refresh found it), "reconcile" (the scheduled check found a change no
// webhook had reported), "adjustment" (made in bizinsights and confirmed by Shopify:
// `adjustmentId`). Shopify's own adjustment history is not readable through its API, so every row
// here is an observation of Shopify's state, never a reconstruction. Names are copied in so the
// history still reads after a product or location is deleted.
model InventoryMovement {
  id                String   @id @default(cuid())
  workspaceId       String   @map("workspace_id")
  storeId           String   @map("store_id")
  inventoryItemId   String   @map("inventory_item_id")
  locationShopifyId String   @map("location_shopify_id")
  variantShopifyId  String?  @map("variant_shopify_id")
  productShopifyId  String?  @map("product_shopify_id")
  productTitle      String?  @map("product_title")
  variantTitle      String?  @map("variant_title")
  sku               String?
  locationName      String?  @map("location_name")
  // available | on_hand | committed | incoming | reserved | damaged | safety_stock | quality_control
  quantityName      String   @map("quantity_name")
  before            Int?
  after             Int
  delta             Int
  source            String
  adjustmentId      String?  @map("adjustment_id")
  shopifyUpdatedAt  DateTime @map("shopify_updated_at")
  observedAt        DateTime @default(now()) @map("observed_at")
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, observedAt])
  @@index([storeId, variantShopifyId, observedAt])
  @@index([workspaceId])
  @@map("inventory_movements")
}

// The store's stock at the end of a store-local day (updated through the day; the last write is the
// day's close), storewide (`locationKey` "all") and per location (its numeric id). Trend charts
// read these and only these: a day without one shows as not recorded.
model InventorySnapshot {
  id                String   @id @default(cuid())
  workspaceId       String   @map("workspace_id")
  storeId           String   @map("store_id")
  day               String
  locationKey       String   @map("location_key")
  trackedVariants   Int      @map("tracked_variants")
  untrackedVariants Int      @map("untracked_variants")
  available         Int
  onHand            Int      @map("on_hand")
  committed         Int
  incoming          Int
  lowStock          Int      @map("low_stock")
  outOfStock        Int      @map("out_of_stock")
  // Cost of the units on hand, for the variants whose cost is known (`variantsWithCost` of
  // `variantsInStock`); null when none is.
  costValue         Decimal? @map("cost_value") @db.Decimal(18, 2)
  variantsWithCost  Int      @map("variants_with_cost")
  variantsInStock   Int      @map("variants_in_stock")
  retailValue       Decimal  @map("retail_value") @db.Decimal(18, 2)
  takenAt           DateTime @map("taken_at")
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, day, locationKey])
  @@index([workspaceId])
  @@map("inventory_snapshots")
}

// A stock change asked for in bizinsights, and what Shopify said. Written "pending" before the
// mutation is sent and settled once (confirmed | failed | unknown), never edited after: a database
// trigger refuses any other update (migration 20261019120000), and the tenant role may only read.
// `idempotencyKey` is the client's, sent to Shopify as @idempotent(key:), so a retried request
// changes stock once.
model InventoryAdjustment {
  id                String    @id @default(cuid())
  workspaceId       String    @map("workspace_id")
  storeId           String    @map("store_id")
  idempotencyKey    String    @map("idempotency_key")
  actorUserId       String?   @map("actor_user_id")
  inventoryItemId   String    @map("inventory_item_id")
  locationShopifyId String    @map("location_shopify_id")
  variantShopifyId  String?   @map("variant_shopify_id")
  productShopifyId  String?   @map("product_shopify_id")
  productTitle      String?   @map("product_title")
  variantTitle      String?   @map("variant_title")
  sku               String?
  locationName      String?   @map("location_name")
  // increase | decrease | set | correction | damaged | stocktake
  kind              String
  // The quantity state changed: available, on_hand (stocktake), damaged (moved from available).
  quantityName      String    @map("quantity_name")
  // Shopify's reason code (correction, received, damaged, cycle_count_available, ...).
  reason            String
  note              String?
  referenceId       String?   @map("reference_id")
  // The change asked for: a delta (increase, decrease, correction, damaged) or a new quantity (set, stocktake).
  delta             Int?
  quantity          Int?
  // The quantity the person saw when they asked; sent as changeFromQuantity, so Shopify refuses
  // the change if the stock moved in the meantime.
  expectedBefore    Int?      @map("expected_before")
  status            String
  errorCode         String?   @map("error_code")
  // inventoryAdjustmentGroup.id from Shopify's answer.
  shopifyGroupId    String?   @map("shopify_group_id")
  // The quantity read back from Shopify right after it confirmed the change.
  resultQuantity    Int?      @map("result_quantity")
  createdAt         DateTime  @default(now()) @map("created_at")
  completedAt       DateTime? @map("completed_at")
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, idempotencyKey])
  @@index([storeId, createdAt])
  @@index([workspaceId])
  @@map("inventory_adjustments")
}

// The store's inventory settings (thresholds, alerts, the check's schedule). No row = defaults
// (@app/shared/inventory INVENTORY_DEFAULTS).
model InventorySettings {
  storeId           String   @id @map("store_id")
  workspaceId       String   @map("workspace_id")
  lowStockThreshold Int      @default(10) @map("low_stock_threshold")
  emailAlerts       Boolean  @default(true) @map("email_alerts")
  dashboardAlerts   Boolean  @default(true) @map("dashboard_alerts")
  whatsappAlerts    Boolean  @default(false) @map("whatsapp_alerts")
  // The approved WhatsApp template the alert is sent with, and the numbers it goes to
  // (AES-256-GCM, never returned: the API sends them masked).
  whatsappTemplate  String?  @map("whatsapp_template")
  whatsappToEnc     String?  @map("whatsapp_to_enc")
  // Hours between full checks of every stock level against Shopify (1 to 24).
  reconcileHours    Int      @default(6) @map("reconcile_hours")
  // For restock suggestions: days a reorder takes to arrive, and days of sales it should cover.
  leadTimeDays      Int      @default(14) @map("lead_time_days")
  coverDays         Int      @default(30) @map("cover_days")
  updatedAt         DateTime @updatedAt @map("updated_at")
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("inventory_settings")
}

// A variant's stock alert (out_of_stock | low_stock | fast_movement): one row per variant and kind,
// opened when the variant crosses into it and resolved when it leaves. `notifiedAt` is when people
// were told, so an alert that stays open is announced once (and one that flaps at most once a day).
model InventoryAlert {
  id               String    @id @default(cuid())
  workspaceId      String    @map("workspace_id")
  storeId          String    @map("store_id")
  variantShopifyId String    @map("variant_shopify_id")
  kind             String
  available        Int
  threshold        Int?
  openedAt         DateTime  @map("opened_at")
  resolvedAt       DateTime? @map("resolved_at")
  notifiedAt       DateTime? @map("notified_at")
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, variantShopifyId, kind])
  @@index([storeId, resolvedAt])
  @@index([workspaceId])
  @@map("inventory_alerts")
}

// One full pass over a store's stock (the import, a manual refresh, or the scheduled check against
// Shopify): how many levels it read and how many differed from what bizinsights held.
model InventorySyncRun {
  id            String    @id @default(cuid())
  workspaceId   String    @map("workspace_id")
  storeId       String    @map("store_id")
  // import | manual | reconcile
  trigger       String
  status        String
  locations     Int       @default(0)
  levelsChecked Int       @default(0) @map("levels_checked")
  differences   Int       @default(0)
  // Up to 20 of the differences: [{inventoryItemId, locationId, name, ours, shopify}].
  sample        Json?
  error         String?
  startedAt     DateTime  @map("started_at")
  finishedAt    DateTime? @map("finished_at")
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, startedAt])
  @@index([workspaceId])
  @@map("inventory_sync_runs")
}

model Order {
  id                  String          @id @default(cuid())
  workspaceId         String          @map("workspace_id")
  storeId             String          @map("store_id")
  shopifyId           String          @map("shopify_id")
  name                String
  currency            String
  /// Store-local day of shopifyProcessedAt (shopifyCreatedAt while that is null), as Shopify's reports date the order.
  localDay            String          @map("local_day")
  shopifyCreatedAt    DateTime        @map("shopify_created_at")
  /// Order.processedAt: when the sale happened, the date Shopify's reports use. Earlier than
  /// shopifyCreatedAt for an imported, POS-offline or marketplace order. Null on orders stored
  /// before it was read (the re-read fills it in).
  shopifyProcessedAt  DateTime?       @map("shopify_processed_at")
  shopifyUpdatedAt    DateTime        @map("shopify_updated_at")
  /// Every item a gift card. Shopify's reports count neither the order nor its customer.
  giftCardOnly        Boolean         @default(false) @map("gift_card_only")
  cancelledAt         DateTime?       @map("cancelled_at")
  financialStatus     String?         @map("financial_status")
  subtotal            Decimal         @db.Decimal(18, 2)
  totalDiscounts      Decimal         @map("total_discounts") @db.Decimal(18, 2)
  totalTax            Decimal         @map("total_tax") @db.Decimal(18, 2)
  totalShipping       Decimal         @map("total_shipping") @db.Decimal(18, 2)
  totalPrice          Decimal         @map("total_price") @db.Decimal(18, 2)
  customerKey         String?         @map("customer_key")
  isReturningCustomer Boolean         @default(false) @map("is_returning_customer")
  // Sales channel as Shopify reports it (web, pos, shopify_draft_order, an app id, ...).
  sourceName          String?         @map("source_name")
  // Lowercase: fulfilled | partially_fulfilled | unfulfilled | ... (GraphQL displayFulfillmentStatus).
  fulfillmentStatus   String?         @map("fulfillment_status")
  // When the first fulfillment was created (time-to-ship).
  fulfilledAt         DateTime?       @map("fulfilled_at")
  discountCodes       String[]        @default([]) @map("discount_codes")
  /// Where the customer came from (packages/shared/src/traffic.ts): facebook | instagram | google | ... | direct | other | unknown.
  /// Null on orders stored before bizinsights recorded it (the dashboard re-reads those once).
  trafficSource       String?         @map("traffic_source")
  /// paid | unpaid | email | direct | referral | unknown
  trafficMedium       String?         @map("traffic_medium")
  /// The link's utm_campaign. Never the URL itself.
  trafficCampaign     String?         @map("traffic_campaign")
  /// The referring site's host only.
  referrerHost        String?         @map("referrer_host")
  /// The order's Shopify updated_at when its sales (order_sales) were last read from Shopify; null
  /// while they never were (an order known only from a webhook, or stored before sales were read).
  salesUpdatedAt      DateTime?       @map("sales_updated_at")
  /// The money state of the REST payload the stored sales were read for (`salesKey` in
  /// packages/core/src/normalize.ts): a webhook whose state matches needs no new read.
  salesKey            String?         @map("sales_key")
  /// Shopify's position of this order in its customer's order history (CustomerJourneySummary
  /// .customerOrderIndex: 1 = the customer's first purchase; test orders not counted). Null when
  /// Shopify gave none (no journey, e.g. POS) or the order was only seen in a webhook so far.
  customerOrderIndex  Int?            @map("customer_order_index")
  /// The customer's lifetime order count (Customer.numberOfOrders) when this order was read; a
  /// fallback for orders without customerOrderIndex (settleReturningCustomers in core).
  customerOrderCount  Int?            @map("customer_order_count")
  lineItems           OrderLineItem[]
  /// No longer written: returns are read from Shopify's sales (order_sales) instead.
  refunds             Refund[]
  sales               OrderSale[]

  @@unique([storeId, shopifyId])
  @@index([storeId, localDay])
  // A customer's earlier orders (returning-customer flag, redaction, campaign audiences).
  @@index([storeId, customerKey, shopifyCreatedAt])
  // The orders cancelled in the dates asked about (recent orders), and a history year's orders by creation.
  @@index([storeId, cancelledAt])
  @@index([storeId, shopifyCreatedAt])
  @@index([workspaceId])
  @@map("orders")
}

model OrderLineItem {
  id               String  @id @default(cuid())
  workspaceId      String  @map("workspace_id")
  storeId          String  @map("store_id")
  orderId          String  @map("order_id")
  shopifyId        String  @map("shopify_id")
  productShopifyId String? @map("product_shopify_id")
  variantShopifyId String? @map("variant_shopify_id")
  sku              String?
  title            String
  quantity         Int
  price            Decimal @db.Decimal(18, 2)
  discount         Decimal @db.Decimal(18, 2)
  order            Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([storeId, shopifyId])
  @@index([orderId])
  @@map("order_line_items")
}

model Refund {
  id               String   @id @default(cuid())
  workspaceId      String   @map("workspace_id")
  storeId          String   @map("store_id")
  orderId          String   @map("order_id")
  shopifyId        String   @map("shopify_id")
  localDay         String   @map("local_day")
  shopifyCreatedAt DateTime @map("shopify_created_at")
  lineSubtotal     Decimal  @map("line_subtotal") @db.Decimal(18, 2)
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([storeId, shopifyId])
  @@index([storeId, localDay])
  @@map("refunds")
}

// A store's full order history (read_all_orders), imported one store-local calendar year at a time,
// newest first (packages/core/src/orderHistory.ts): one row per year of the import's plan, so the
// dashboard can say which years are in, an import that stopped resumes at the year it stopped in,
// and a year that failed says why. By order creation date, as Shopify's order search filters: the
// newest year runs on to now (`toAt` null), the oldest from the store's first order back (its
// search has no lower bound). A newer plan replaces the rows (one per store and year).
model OrderHistoryWindow {
  id               String    @id @default(cuid())
  workspaceId      String    @map("workspace_id")
  storeId          String    @map("store_id")
  // The import (sync_jobs.id) that planned the years, and the one working on this year now.
  planJobId        String    @map("plan_job_id")
  syncJobId        String    @map("sync_job_id")
  year             Int
  fromAt           DateTime  @map("from_at")
  toAt             DateTime? @map("to_at")
  // queued | running | done | failed
  status           String    @default("queued")
  // Orders created in the window and held once it was done.
  orders           Int       @default(0)
  // Whether the plan read customers with the orders (read_customers): a plan read without them is
  // started over, not resumed, when the scope arrives, since its orders lack the customer.
  withCustomers    Boolean   @map("with_customers")
  // The bulk export submitted for this year: a finished export of another year is never read as this one's.
  bulkOperationId  String?   @map("bulk_operation_id")
  attempts         Int       @default(0)
  error            String?
  startedAt        DateTime? @map("started_at")
  finishedAt       DateTime? @map("finished_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@unique([storeId, year])
  @@index([workspaceId])
  @@map("order_history_windows")
}

// Shopify's own report figures (ShopifyQL, scope read_reports; packages/core/src/shopifyReports.ts):
// one answer per store, dataset ("sales" | "profit" | "sessions") and store-local window
// ("from|to|until"), kept so the dashboard's polls never wait on Shopify. `values` holds the figures
// in our names; `error` why Shopify gave none ("access_denied" | "unsupported" | "failed"), next to
// the last figures it did give when a refresh failed.
model ShopifyReport {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  storeId     String   @map("store_id")
  dataset     String
  window      String   @map("time_window")
  values      Json?
  error       String?
  fetchedAt   DateTime @map("fetched_at")
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, dataset, window])
  @@index([workspaceId])
  @@index([fetchedAt])
  @@map("shopify_reports")
}

// One check of a store's figures against Shopify for a window of store-local days
// (packages/core/src/reconcile.ts, docs/kpis.md "Checked against Shopify"). `source` is what the
// figures were checked against: "shopify_records" (Shopify's orders and sales records, read again)
// or "shopify_reports" (Shopify's own report totals, ShopifyQL). `findings` holds the order-level
// causes found (missing, outdated, deleted orders, sales that differ, stale day totals) with a few
// order ids each; `actions` what was repaired. Kept 90 days.
model Reconciliation {
  id            String                 @id @default(cuid())
  workspaceId   String                 @map("workspace_id")
  storeId       String                 @map("store_id")
  source        String
  trigger       String
  fromDay       String                 @map("from_day")
  toDay         String                 @map("to_day")
  timezone      String
  currency      String
  /// running | verified | repaired | differences | incomplete | failed
  status        String
  ordersChecked Int                    @default(0) @map("orders_checked")
  findings      Json?
  actions       Json?
  /// Where a running check has got to (its cursor, Shopify's totals so far): cleared when it ends.
  state         Json?
  error         String?
  startedAt     DateTime               @map("started_at")
  finishedAt    DateTime?              @map("finished_at")
  store         Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  results       ReconciliationResult[]

  @@index([storeId, startedAt])
  @@index([workspaceId])
  @@map("reconciliations")
}

// One metric of a reconciliation: Shopify's figure, ours before and after any repair, and why
// they differed. Money in the store's currency.
model ReconciliationResult {
  id               String         @id @default(cuid())
  workspaceId      String         @map("workspace_id")
  reconciliationId String         @map("reconciliation_id")
  metric           String
  shopifyValue     Decimal?       @map("shopify_value") @db.Decimal(18, 2)
  beforeValue      Decimal?       @map("before_value") @db.Decimal(18, 2)
  afterValue       Decimal?       @map("after_value") @db.Decimal(18, 2)
  /// match | repaired | difference | sync_delay | not_verifiable
  status           String
  cause            String?
  reconciliation   Reconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)

  @@unique([reconciliationId, metric])
  @@index([workspaceId])
  @@map("reconciliation_results")
}

// One of Shopify's sales records for an order (Order.agreements → sales): what was sold, returned
// or changed, on the day it happened. Shopify's own reports are built from these, so the dashboard's
// sales totals are too (docs/kpis.md). Amounts are in the store's currency and signed as Shopify
// sends them; a return is negative.
model OrderSale {
  id                String   @id @default(cuid())
  workspaceId       String   @map("workspace_id")
  storeId           String   @map("store_id")
  orderId           String   @map("order_id")
  shopifyId         String   @map("shopify_id")
  /// Store-local day of `happenedAt`.
  localDay          String   @map("local_day")
  happenedAt        DateTime @map("happened_at")
  /// order | return | update | unknown (Shopify's SaleActionType, lowercase).
  actionType        String   @map("action_type")
  /// product | shipping | gift_card | tip | duty | fee | additional_fee | adjustment | unknown (SaleLineType).
  lineType          String   @map("line_type")
  /// The line item of a product sale (OrderLineItem.shopifyId).
  lineItemShopifyId String?  @map("line_item_shopify_id")
  quantity          Int?
  /// totalAmount: after discounts, taxes included.
  amount            Decimal  @db.Decimal(18, 2)
  /// totalDiscountAmountBeforeTaxes.
  discount          Decimal  @db.Decimal(18, 2)
  /// totalTaxAmount.
  tax               Decimal  @db.Decimal(18, 2)
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([storeId, shopifyId])
  @@index([storeId, localDay])
  @@index([orderId])
  @@index([workspaceId])
  @@map("order_sales")
}

model DailyStoreMetrics {
  workspaceId             String  @map("workspace_id")
  storeId                 String  @map("store_id")
  day                     String
  grossSales              Decimal @default(0) @map("gross_sales") @db.Decimal(18, 2)
  discounts               Decimal @default(0) @db.Decimal(18, 2)
  /// Returns: what refunds, cancellations and edits took back (Shopify's "sales reversals").
  refunds                 Decimal @default(0) @db.Decimal(18, 2)
  /// Shipping charged after shipping discounts and refunds, before tax.
  shipping                Decimal @default(0) @db.Decimal(18, 2)
  taxes                   Decimal @default(0) @db.Decimal(18, 2)
  /// Import duties charged, before tax.
  duties                  Decimal @default(0) @db.Decimal(18, 2)
  /// Shopify's fees and additional fees (and any sale it gives no type), before tax.
  additionalFees          Decimal @default(0) @map("additional_fees") @db.Decimal(18, 2)
  /// Net sales + shipping + taxes + duties + additional fees: Shopify's "Total sales".
  totalSales              Decimal @default(0) @map("total_sales") @db.Decimal(18, 2)
  /// What refunds, returns and cancellations took off total sales that day: their sales with tax,
  /// shipping, duties and fees in (gift cards and tips aside, as total sales leaves them out).
  totalRefunded           Decimal @default(0) @map("total_refunded") @db.Decimal(18, 2)
  /// Orders placed that day, gift-card-only orders left out (as Shopify's reports count them).
  orders                  Int     @default(0)
  /// What those orders sold on the day they were placed (items after discounts, before tax; no gift
  /// cards, no edits made on a later day): average order value's numerator. Null on rows from before
  /// it was kept.
  orderValue              Decimal? @map("order_value") @db.Decimal(18, 2)
  /// Items sold less items returned, gift cards included (Shopify's net items sold).
  units                   Int     @default(0)
  ordersWithCustomer      Int     @default(0) @map("orders_with_customer")
  returningCustomerOrders Int     @default(0) @map("returning_customer_orders")
  refundedOrders          Int     @default(0) @map("refunded_orders")

  @@id([storeId, day])
  @@index([workspaceId])
  @@map("daily_store_metrics")
}

// A store's own sales calculation ("Custom sales", docs/kpis.md): which lines of Shopify's total
// sales it counts, and whether the dashboard shows it. Only the choice is kept, never an amount:
// the figures always come from the store's sales records for the dates on screen.
model SalesCalculation {
  storeId          String   @id @map("store_id")
  workspaceId      String   @map("workspace_id")
  /// { netSales, additionalFees, duties, shipping, taxes } as booleans (salesCalculationInput in @app/shared).
  components       Json
  /// The merchant's name for a calculation of their own.
  label            String?
  applyToDashboard Boolean  @default(false) @map("apply_to_dashboard")
  /// Calculations kept to switch between: [{ name, components }], at most 10.
  presets          Json     @default("[]")
  updatedByUserId  String?  @map("updated_by_user_id")
  updatedAt        DateTime @updatedAt @map("updated_at")
  store            Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("sales_calculations")
}

// A cost the store's owner keeps in bizinsights (Settings → Costs, docs/kpis.md "Costs and net
// profit"): what Shopify, its profit report and the ad platforms can't say (the Shopify plan, apps,
// staff, rent, shipping labels, fees...). The dashboard spreads it over the days it covers
// (expenseInRange in @app/shared/expenses); only the owner's own figure is kept.
model StoreExpense {
  id              String   @id @default(cuid())
  workspaceId     String   @map("workspace_id")
  storeId         String   @map("store_id")
  name            String
  /// shopify_plan | shopify_apps | software | staff | rent | shipping | payment_fees | marketing | other (EXPENSE_CATEGORIES)
  category        String
  /// In the store's currency.
  amount          Decimal  @db.Decimal(18, 2)
  /// once | weekly | monthly | yearly (EXPENSE_CADENCES)
  cadence         String
  /// The store-local day it starts, YYYY-MM-DD (paid once: the day it was paid).
  startsOn        String   @map("starts_on")
  /// The last store-local day it applies to; null while it goes on.
  endsOn          String?  @map("ends_on")
  note            String?
  createdByUserId String?  @map("created_by_user_id")
  updatedByUserId String?  @map("updated_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([storeId])
  @@map("store_expenses")
}

// Whether the store's costs list holds every cost, and from which day: net profit is given only for
// dates from then on (expensesComplete in @app/shared/expenses). One row per store, once said.
model StoreExpenseSettings {
  storeId         String   @id @map("store_id")
  workspaceId     String   @map("workspace_id")
  /// The first store-local day the list holds every cost from; null: not said, or taken back.
  completeFrom    String?  @map("complete_from")
  updatedByUserId String?  @map("updated_by_user_id")
  updatedAt       DateTime @updatedAt @map("updated_at")
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("store_expense_settings")
}

model FunnelDaily {
  workspaceId        String @map("workspace_id")
  storeId            String @map("store_id")
  day                String
  sessions           Int    @default(0)
  productViews       Int    @default(0) @map("product_views")
  addToCarts         Int    @default(0) @map("add_to_carts")
  checkoutsStarted   Int    @default(0) @map("checkouts_started")
  checkoutsCompleted Int    @default(0) @map("checkouts_completed")

  @@id([storeId, day])
  @@index([workspaceId])
  @@map("funnel_daily")
}

// One storefront visit: a shopper (hashed Shopify client id) on one store-local day. Where they
// landed, where they were last seen, how far down the funnel they got (0 visited … 4 purchased)
// and which site sections they saw (bitmask). Paths are cleaned of tokens and query strings
// before they get here; see packages/shared/src/journey.ts.
model FunnelVisit {
  workspaceId  String    @map("workspace_id")
  storeId      String    @map("store_id")
  day          String
  visitor      String
  enteredAt    DateTime? @map("entered_at")
  entrySection String?   @map("entry_section")
  entryPath    String?   @map("entry_path")
  exitedAt     DateTime? @map("exited_at")
  exitSection  String?   @map("exit_section")
  exitPath     String?   @map("exit_path")
  furthestStep Int       @default(0) @map("furthest_step") @db.SmallInt
  sections     Int       @default(0)
  pageViews    Int       @default(0) @map("page_views")
  // The kind of device ("mobile", "tablet", "desktop", "unknown"), read from the browser's own
  // User-Agent on the visit's first batch, and the country (ISO 3166 code) the edge placed that
  // request in; nothing else of either is kept. Null on visits recorded before they were
  // (2026-10-24): `device` is always set from then on, so it also says whether a visit has them.
  device       String?
  country      String?
  // Where the visit came from: one of TRAFFIC_SOURCES (packages/shared/src/traffic.ts), classified by
  // arrivalSource from the first arrival the pixel reports (a referring host, a link's utm_source,
  // utm_medium and click id names; none of them kept). Null: the pixel reported no arrival, as every
  // pixel did before it sent them.
  source       String?

  @@id([storeId, day, visitor])
  @@index([workspaceId])
  // "Returning" visits: the same browser on an earlier day.
  @@index([storeId, visitor, day])
  @@map("funnel_visits")
}

// Which products a visit looked at, added, took to checkout and bought: one row per visit (as in
// funnel_visits) and product.
// `handle` is the product's from its storefront address (/products/<handle>); `steps` bit 0: the
// product page was viewed, bit 1: added to cart from that page, bit 2: added to cart elsewhere (a
// quick add), bit 3: in a checkout the visit started, bit 4: in one it completed. Bits 2-4 only from
// pixels that name the products (packages/shared/src/funnel.ts, productStepsOf).
model FunnelProductVisit {
  workspaceId String @map("workspace_id")
  storeId     String @map("store_id")
  day         String
  visitor     String
  handle      String
  steps       Int    @default(0) @db.SmallInt

  @@id([storeId, day, visitor, handle])
  @@index([workspaceId])
  @@map("funnel_product_visits")
}

// The Shopping Funnel's checklist: a recommended action a member marked as done for a store
// (packages/shared/src/funnel.ts, FUNNEL_ACTIONS). No row: not done.
model FunnelActionCheck {
  workspaceId String   @map("workspace_id")
  storeId     String   @map("store_id")
  actionId    String   @map("action_id")
  doneAt      DateTime @default(now()) @map("done_at")
  // The member who marked it (a user id; kept if they leave).
  doneBy      String?  @map("done_by")

  @@id([storeId, actionId])
  @@index([workspaceId])
  @@map("funnel_action_checks")
}

// A business event the team marked on the Profit sheet (/sheet; packages/shared/src/businessEvents.ts):
// a sale, an ad campaign, a product launch... from one store-local day to another (YYYY-MM-DD, both
// included). The sheet shows it on its days and filters days by it. A note only: no figure is
// worked out from it.
model BusinessEvent {
  id              String   @id @default(cuid())
  workspaceId     String   @map("workspace_id")
  storeId         String   @map("store_id")
  kind            String
  title           String
  startsOn        String   @map("starts_on")
  endsOn          String   @map("ends_on")
  note            String?
  // Who added it and who changed it last (user ids; kept if they leave).
  createdByUserId String?  @map("created_by_user_id")
  updatedByUserId String?  @map("updated_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([storeId, startsOn])
  @@map("business_events")
}

// An ad account (Meta Ads, Google Ads, or a Google AdSense account) connected to a store with
// "Continue with Meta/Google Ads/Google AdSense". One row per account. The token belongs to the
// person who connected: every account they connected in one go shares it, encrypted with the same
// AAD (`ads:<provider>:<storeId>:<kind>`).
model AdConnection {
  id                   String    @id @default(cuid())
  workspaceId          String    @map("workspace_id")
  storeId              String    @map("store_id")
  provider             String // "meta" | "google" | "adsense"
  accountId            String    @map("account_id")
  accountName          String?   @map("account_name")
  currency             String?
  timezone             String?
  /** Google: the manager account the client account is reached through. */
  loginCustomerId      String?   @map("login_customer_id")
  /** Shown on the dashboard and synced. Turned off from Settings without losing the connection. */
  enabled              Boolean   @default(true)
  /**
   * "active" | "reconnect" (access ended: connect again) | "permission" (this login lost access to
   * this one account; connect with a login that has it) | "unavailable" (the platform won't report on
   * the account: closed, disabled, sign-up unfinished) | "error" (a failure a retry may fix).
   * AD_CONNECTION_STATUSES in @app/shared/ads.
   */
  status               String    @default("active")
  /** Why it isn't active, as a code the UI words (AD_ERROR_CODES in @app/shared/ads); null when active. */
  errorCode            String?   @map("error_code")
  /** The platform's own reason, through providerDetail(): for the logs and support, never shown raw. */
  lastError            String?   @map("last_error")
  lastSyncedAt         DateTime? @map("last_synced_at")
  /**
   * The ad account's own health at the platform, normalized (AD_ACCOUNT_STATUSES in @app/shared/ads):
   * Meta's account_status, AdSense's state and pending tasks. Null until read.
   */
  accountStatus        String?   @map("account_status")
  /** What the platform says about that status (Meta's disable reason, AdSense's pending tasks). */
  accountStatusDetail  String?   @map("account_status_detail")
  /** AdSense: the sites (DOMAIN_CODE) whose earnings belong to this store; empty = every site. */
  sites                String[]  @default([])
  /**
   * The last day (the account's own, YYYY-MM-DD) up to which every day from history_from on is
   * stored without a gap. A sync that leaves a gap after it fetches the gap first.
   */
  syncedThrough        String?   @map("synced_through")
  /** A sync was asked for (connect, Refresh) and hasn't finished yet: the card says "Synchronizing". */
  syncRequestedAt      DateTime? @map("sync_requested_at")
  /** Syncs that failed in a row; reset by one that works. Failing accounts are tried less often. */
  consecutiveFailures  Int       @default(0) @map("consecutive_failures")
  /**
   * The first day (the account's own, YYYY-MM-DD) from which every day's figures are stored: the
   * start of the earliest window a sync fetched in full (the first sync fetches 90 days), keeping
   * the earliest; null before any sync worked. The dashboard compares only from then on.
   */
  historyFrom          String?   @map("history_from")
  accessTokenEnc       String    @map("access_token_enc")
  refreshTokenEnc      String?   @map("refresh_token_enc")
  accessTokenExpiresAt DateTime? @map("access_token_expires_at")
  tokenKeyVersion      Int       @map("token_key_version")
  connectedByUserId    String?   @map("connected_by_user_id")
  /** The platform's id for the person who granted access (Google `sub`, Meta app-scoped user id). */
  externalUserId       String?   @map("external_user_id")
  /** The permissions that person granted (checked when connecting). */
  grantedScopes        String[]  @default([]) @map("granted_scopes")
  /**
   * A demo connection ("Try demo" on the Google Ads card, docs/ads-demo.md): its figures are generated
   * by bizinsights from demoSeed, never read from Google; it holds no token, and nothing it shows is
   * Google-verified. Added by migration 20261020150000 (the same rules as every other column).
   */
  isDemo               Boolean   @default(false) @map("is_demo")
  demoSeed             Int?      @map("demo_seed")
  /**
   * No longer used, dropped by a later migration (kept so a rollback still reads them): every row is
   * bizinsights' own sign-in ("direct", sourceLoginId null) since the connections made through Nango
   * (2026-10-22 to 2026-10-28) were moved off it (docs/ads-setup.md, "Leaving Nango"). Until then a
   * connect writes "direct", syncs record it (ad_sync_runs.source), and a row with anything else is
   * never read: it waits for a reconnect (adConnections/credentials.ts holdsOwnSignIn).
   * Added by migration 20261022120000 (the same rules as every other column).
   */
  source               String    @default("direct")
  sourceLoginId        String?   @map("source_login_id")
  /** When a sync of this account last started, whatever came of it (lastSyncedAt is the last that worked). */
  lastSyncAttemptAt    DateTime? @map("last_sync_attempt_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  campaignDays         AdCampaignDaily[]
  campaigns            AdCampaign[]
  adsenseDays          AdsenseDaily[]
  syncRuns             AdSyncRun[]

  @@unique([storeId, provider, accountId])
  @@index([workspaceId])
  @@index([externalUserId])
  @@map("ad_connections")
}

// A platform sign-in that reaches no ad account yet, kept connected rather than refused (Meta: the
// Facebook login has no ad account, its accounts sit in a business portfolio it isn't assigned to, it
// shared none on Facebook's screen, or Meta didn't list them in time). The card says who is connected;
// the cron tick asks the platform again (adConnections/logins.ts) and connects the login's ad accounts
// once it lists some, and then this row goes. One per store and platform. Added by migration
// 20261026150000 (the same rules as ad_connections: tenant rows); its token by 20261028100000.
model AdLogin {
  id                   String    @id @default(cuid())
  workspaceId          String    @map("workspace_id")
  storeId              String    @map("store_id")
  provider             String // "meta"
  /** The person's token to bizinsights' own app, encrypted like a connection's (logins.ts). A login without one ends at its next check. */
  accessTokenEnc       String    @default("") @map("access_token_enc")
  tokenKeyVersion      Int?      @map("token_key_version")
  /**
   * No longer used, dropped by a later migration (kept so a rollback still reads them): the Nango
   * connection of a login made through Nango (2026-10-26 to 2026-10-28), emptied when it was moved off it.
   */
  sourceLoginId        String?   @map("source_login_id")
  nangoIntegrationKey  String?   @map("nango_integration_key")
  /** The platform's id for the person who signed in (Meta's app-scoped user id), when it was learned. */
  externalUserId       String?   @map("external_user_id")
  /** The name the platform's sign-in went by (Meta's profile name), for "Connected as …" on the card. */
  loginName            String?   @map("login_name")
  /** The permissions that person granted. */
  grantedScopes        String[]  @default([]) @map("granted_scopes")
  accessTokenExpiresAt DateTime? @map("access_token_expires_at")
  connectedByUserId    String?   @map("connected_by_user_id")
  /**
   * Why no ad account is connected yet (AD_LOGIN_REASONS in @app/shared/ads): "no_ads_account" (the login
   * reaches none), "none_shared" (none was ticked on the platform's screen), "unanswered" (the platform
   * didn't list them in time) or "choose" (it lists more than are connected without asking).
   */
  reason               String
  /** When the platform was last asked for the login's ad accounts. */
  checkedAt            DateTime  @default(now()) @map("checked_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@unique([storeId, provider])
  @@index([workspaceId])
  @@index([externalUserId])
  @@index([sourceLoginId])
  @@map("ad_logins")
}

// Each sync of one ad account, as it ended: when, what it was asked to fetch and by whom, and what came
// of it. The settings cards show the last few; kept 90 days (pruned by the daily sweep).
model AdSyncRun {
  id           String   @id @default(cuid())
  workspaceId  String   @map("workspace_id")
  storeId      String   @map("store_id")
  connectionId String   @map("connection_id")
  provider     String
  // ad_connections.source when it ran: "direct" (a run from before 2026-10-28 may hold the old value until pruned)
  source       String
  // request | schedule | history (AdsSyncTrigger)
  trigger      String
  /** The days fetched (the account's own), when the sync got that far. */
  since        String?
  until        String?
  // synced | skipped | failed
  outcome      String
  rows         Int      @default(0)
  /** A skipped sync's reason, or a failed one's error code (AD_ERROR_CODES in @app/shared/ads). */
  reason       String?
  startedAt    DateTime @map("started_at")
  finishedAt   DateTime @map("finished_at")
  connection   AdConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, startedAt])
  @@index([workspaceId])
  @@map("ad_sync_runs")
}

// What an ad platform reports for one campaign on one day (the ad account's own calendar day).
model AdCampaignDaily {
  workspaceId     String   @map("workspace_id")
  storeId         String   @map("store_id")
  connectionId    String   @map("connection_id")
  provider        String
  accountId       String   @map("account_id")
  campaignId      String   @map("campaign_id")
  campaignName    String   @map("campaign_name")
  day             String
  spend           Decimal  @default(0) @db.Decimal(18, 2)
  impressions     Int      @default(0)
  /** Every click the platform counts (Meta's "clicks (all)" include likes, comments and profile clicks). */
  clicks          Int      @default(0)
  /** Clicks on the ad's link: Meta's inline_link_clicks, Google's clicks. Null until read (rows from before 2026-10-19). */
  linkClicks      Int?     @map("link_clicks")
  /** The platform's own conversions: Meta's purchases, Google's every primary conversion action (leads, calls...). */
  conversions     Decimal  @default(0) @db.Decimal(18, 2)
  conversionValue Decimal  @default(0) @map("conversion_value") @db.Decimal(18, 2)
  /** Purchases only, as the platform credits them (Google: conversion actions of category PURCHASE). Null until read. */
  purchases       Decimal? @db.Decimal(18, 2)
  purchaseValue   Decimal? @map("purchase_value") @db.Decimal(18, 2)
  leads           Int      @default(0)
  currency        String?
  updatedAt       DateTime @updatedAt @map("updated_at")
  connection      AdConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@id([connectionId, campaignId, day])
  @@index([workspaceId])
  @@index([storeId, day])
  @@map("ad_campaign_daily")
}

// A campaign as its platform last described it to a sync: its name and delivery status, for the
// Advertising pages' campaign filters. Its days are in ad_campaign_daily; one row per campaign an
// account's syncs have seen, kept when the campaign stops spending (its status says why).
model AdCampaign {
  workspaceId  String   @map("workspace_id")
  storeId      String   @map("store_id")
  connectionId String   @map("connection_id")
  provider     String
  accountId    String   @map("account_id")
  campaignId   String   @map("campaign_id")
  name         String
  /** The platform's own word: Google's campaign.status (ENABLED, PAUSED, REMOVED), Meta's effective_status (ACTIVE, PAUSED, ARCHIVED, WITH_ISSUES...). Null: not read yet. */
  status       String?
  /** Google's campaign.advertising_channel_type (SEARCH, SHOPPING, PERFORMANCE_MAX...). Null for Meta, and until read. */
  channelType  String?  @map("channel_type")
  /** Google's campaign.primary_status (ELIGIBLE, LIMITED, LEARNING, NOT_ELIGIBLE...): how it serves now. Null for Meta, and until read. */
  primaryStatus String? @map("primary_status")
  /** Google's campaign.primary_status_reasons (BUDGET_CONSTRAINED...); empty when none, for Meta, and until read. */
  primaryStatusReasons String[] @default([]) @map("primary_status_reasons")
  /** The budget's period as the platform says it: DAILY; Google's CUSTOM_PERIOD (one total over the campaign's own dates); Meta's LIFETIME. Null: none on the campaign (a Meta campaign whose budgets are its ad sets'), or not read. */
  budgetPeriod String?  @map("budget_period")
  /** The budget for that period, in the account's currency. */
  budgetAmount Decimal? @map("budget_amount") @db.Decimal(18, 2)
  /** When a sync last read the status (and the fields above, when its platform gives them). */
  checkedAt    DateTime @map("checked_at")
  connection   AdConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@id([connectionId, campaignId])
  @@index([workspaceId])
  @@index([storeId])
  @@map("ad_campaigns")
}

// What an AdSense account earned from ads shown on one site on one day (the account's own
// calendar day). Earnings, never spend: kept apart from ad_campaign_daily so the two can't be summed.
model AdsenseDaily {
  workspaceId  String   @map("workspace_id")
  storeId      String   @map("store_id")
  connectionId String   @map("connection_id")
  accountId    String   @map("account_id")
  /** The host the ads were shown on (AdSense DOMAIN_CODE); "" when the report isn't split by site. */
  site         String
  day          String
  earnings     Decimal  @default(0) @db.Decimal(18, 2)
  pageViews    Int      @default(0) @map("page_views")
  impressions  Int      @default(0)
  clicks       Int      @default(0)
  currency     String?
  updatedAt    DateTime @updatedAt @map("updated_at")
  connection   AdConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@id([connectionId, site, day])
  @@index([workspaceId])
  @@index([storeId, day])
  @@map("adsense_daily")
}

// Dedupe table for pixel events (Shopify may redeliver) and sessions.
model PixelEventSeen {
  storeId  String   @map("store_id")
  eventId  String   @map("event_id")
  seenAt   DateTime @default(now()) @map("seen_at")

  @@id([storeId, eventId])
  @@index([seenAt])
  @@map("pixel_events_seen")
}

model SyncJob {
  id             String    @id @default(cuid())
  workspaceId    String    @map("workspace_id")
  storeId        String    @map("store_id")
  kind           String
  status         JobStatus @default(queued)
  attempts       Int       @default(0)
  progress       Int       @default(0)
  error          String?
  startedAt      DateTime? @map("started_at")
  // Last sign of life from the chain working on the job: its first message, every page or bulk
  // step. startedAt is only stamped once, so on its own it cannot tell a long import from a dead one.
  lastActivityAt DateTime? @map("last_activity_at")
  finishedAt     DateTime? @map("finished_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([storeId, kind])
  // The 15-minute sweep for stalled jobs reads the few that are queued or running.
  @@index([status])
  @@index([workspaceId])
  @@map("sync_jobs")
}

model Alert {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  storeId     String?   @map("store_id")
  severity    String
  code        String
  message     String
  createdAt   DateTime  @default(now()) @map("created_at")
  resolvedAt  DateTime? @map("resolved_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, resolvedAt])
  @@map("alerts")
}

model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  name        String
  prefix      String
  keyHash     String    @unique @map("key_hash")
  createdById String    @map("created_by_id")
  lastUsedAt  DateTime? @map("last_used_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("api_keys")
}

model AuditLog {
  id          String    @id @default(cuid())
  /// Null for a system record that outlives the workspace it was about: a GDPR shop/redact that
  /// erased the store's unclaimed workspace with it (apps/worker/src/handlers/webhooks.ts). RLS shows
  /// such a row to no workspace, and a deleted workspace's own rows still go with it (Cascade).
  workspaceId String?   @map("workspace_id")
  actorUserId String?   @map("actor_user_id")
  action      String
  targetType  String?   @map("target_type")
  targetId    String?   @map("target_id")
  metadata    Json?
  ip          String?
  createdAt   DateTime  @default(now()) @map("created_at")
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("audit_logs")
}

model Subscription {
  workspaceId      String    @id @map("workspace_id")
  plan             String    @default("free")
  status           String    @default("active")
  shopifyChargeId  String?   @map("shopify_charge_id")
  currentPeriodEnd DateTime? @map("current_period_end")
  /// A plan change the merchant has been sent to Shopify to approve. `plan` stays the plan they
  /// actually have until Shopify reports this charge active; a declined or abandoned change
  /// leaves it untouched.
  pendingPlan      String?   @map("pending_plan")
  pendingChargeId  String?   @map("pending_charge_id")
  /// The store whose Shopify bill carries the charges above (Shopify bills an app per store, and
  /// only that store's token can cancel them). Both the charge in force and a pending one live
  /// there: a plan change is always made through it while a charge is in force.
  billingStoreId   String?   @map("billing_store_id")
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  billingStore     Store?    @relation(fields: [billingStoreId], references: [id], onDelete: SetNull)

  @@index([billingStoreId])
  @@map("subscriptions")
}

model EmailOtp {
  id         String    @id @default(cuid())
  email      String
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at")
  ip         String?
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@map("email_otps")
}

// ---------------------------------------------------------------------------------------------
// LEGACY WhatsApp (2026-10-10 to 2026-10-24), replaced by WhatsApp Automation (the wa_* tables below).
// No code reads or writes these any more, except to erase a store or a customer (shop/redact,
// customers/redact: packages/core/src/whatsapp/legacy.ts) and to tell a store its old connection was
// retired. They are kept, untouched, so a rollback to the release before the rebuild still works; a
// later migration drops them (docs/whatsapp.md, "The old WhatsApp tables").
//
// WhatsApp (Cloud API). Unlike the analytics tables, these hold what messaging a customer needs:
// their WhatsApp number and first name, ENCRYPTED (AES-256-GCM, AAD bound to the store), with a
// keyed hash for lookups and a masked form for the dashboard. Retention is enforced by the worker
// (packages/core/src/whatsapp/retention.ts); customers/redact and shop/redact delete them.
// ---------------------------------------------------------------------------------------------

// The store's WhatsApp Business phone number. One per store.
model WhatsappConnection {
  id                 String    @id @default(cuid())
  workspaceId        String    @map("workspace_id")
  storeId            String    @unique @map("store_id")
  /** "embedded" (Embedded Signup through bizinsights' Meta app) | "manual" (the merchant's own app and system-user token). */
  mode               String
  businessId         String?   @map("business_id")
  wabaId             String    @map("waba_id")
  wabaName           String?   @map("waba_name")
  phoneNumberId      String    @map("phone_number_id")
  displayPhoneNumber String?   @map("display_phone_number")
  verifiedName       String?   @map("verified_name")
  nameStatus         String?   @map("name_status")
  qualityRating      String?   @map("quality_rating")
  /** TIER_250, TIER_1K, ... : how many customers a day the number may start conversations with. */
  messagingLimitTier String?   @map("messaging_limit_tier")
  /** Whether the number is registered with the Cloud API (it can't send until it is). */
  registered         Boolean   @default(false)
  /** "active" | "pending" (number not registered yet) | "reconnect" (Meta rejected the token) | "error". */
  status             String    @default("active")
  lastError          String?   @map("last_error")
  accessTokenEnc     String    @map("access_token_enc")
  /** Manual mode: the merchant's Meta app secret, which signs their webhooks. */
  appSecretEnc       String?   @map("app_secret_enc")
  /** Manual mode: the verify token the merchant enters in their Meta app's webhook settings. */
  verifyTokenEnc     String?   @map("verify_token_enc")
  verifyTokenHash    String?   @unique @map("verify_token_hash")
  /** The number's two-step verification PIN, encrypted: the one bizinsights set when registering it, or the one the merchant entered. */
  pinEnc             String?   @map("pin_enc")
  tokenKeyVersion    Int       @map("token_key_version")
  /** When Meta last proved it can reach our webhook for this number (challenge or signed delivery). */
  webhookVerifiedAt  DateTime? @map("webhook_verified_at")
  lastWebhookAt      DateTime? @map("last_webhook_at")
  lastSyncedAt       DateTime? @map("last_synced_at")
  connectedByUserId  String?   @map("connected_by_user_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([wabaId])
  @@index([phoneNumberId])
  @@map("whatsapp_connections")
}

// What the store sends, when, and to whom (validated by whatsappConfigSchema in packages/shared).
// A row existing is what "WhatsApp is turned on for this store" means to the event handlers.
model WhatsappSettings {
  storeId          String    @id @map("store_id")
  workspaceId      String    @map("workspace_id")
  config           Json      @default("{}")
  /** Who chose the consent basis for order updates, and when (also in the audit log). */
  basisSetByUserId String?   @map("basis_set_by_user_id")
  basisSetAt       DateTime? @map("basis_set_at")
  updatedByUserId  String?   @map("updated_by_user_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@map("whatsapp_settings")
}

// Message templates in the store's WhatsApp Business Account, as Meta last reported them.
model WhatsappTemplate {
  id             String   @id @default(cuid())
  workspaceId    String   @map("workspace_id")
  storeId        String   @map("store_id")
  connectionId   String   @map("connection_id")
  metaId         String   @map("meta_id")
  name           String
  language       String
  /** UTILITY | MARKETING | AUTHENTICATION (Meta's, which may differ from what was asked for). */
  category       String
  /** APPROVED | PENDING | REJECTED | PAUSED | DISABLED | IN_APPEAL ... */
  status         String
  components     Json
  rejectedReason String?  @map("rejected_reason")
  qualityScore   String?  @map("quality_score")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([connectionId, name, language])
  @@index([storeId])
  @@index([workspaceId])
  @@map("whatsapp_templates")
}

// A customer's WhatsApp number and what they agreed to. Opt-outs are kept for as long as the store
// uses WhatsApp, so a customer who said STOP is never messaged again.
model WhatsappContact {
  id                 String    @id @default(cuid())
  workspaceId        String    @map("workspace_id")
  storeId            String    @map("store_id")
  /** HMAC(OTP_PEPPER, "wa:<storeId>:<wa_id>"): finds the contact from a webhook without decrypting anything. */
  phoneHash          String    @map("phone_hash")
  phoneEnc           String    @map("phone_enc")
  phoneMasked        String    @map("phone_masked")
  country            String?
  /** Same keyed hash as orders.customer_key, when Shopify said which customer this is. */
  customerKey        String?   @map("customer_key")
  firstNameEnc       String?   @map("first_name_enc")
  /** "opted_in" | "opted_out" | "unknown" (never asked: no marketing). */
  marketingStatus    String    @default("unknown") @map("marketing_status")
  marketingSource    String?   @map("marketing_source")
  marketingUpdatedAt DateTime? @map("marketing_updated_at")
  /** Replied STOP: nothing at all is sent to this number any more, order updates included. */
  optedOut           Boolean   @default(false) @map("opted_out")
  optedOutAt         DateTime? @map("opted_out_at")
  optOutSource       String?   @map("opt_out_source")
  /** Last message from the customer (opens WhatsApp's 24-hour customer service window). */
  lastInboundAt      DateTime? @map("last_inbound_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@unique([storeId, phoneHash])
  @@index([storeId, customerKey])
  @@index([storeId, marketingStatus])
  @@index([workspaceId])
  @@map("whatsapp_contacts")
}

// Every WhatsApp message: the queue (scheduled → sending) and the history (sent → delivered → read,
// or failed / cancelled / skipped with the reason). Campaign recipients are the rows with a campaign_id.
model WhatsappMessage {
  id                String    @id @default(cuid())
  workspaceId       String    @map("workspace_id")
  storeId           String    @map("store_id")
  contactId         String?   @map("contact_id")
  /** order_confirmation, order_shipped, abandoned_cart_1, review_request, campaign, automation, test, ... */
  kind              String
  /** utility | marketing | authentication | unknown: from the template Meta approved. */
  category          String    @default("unknown")
  templateName      String?   @map("template_name")
  templateLanguage  String?   @map("template_language")
  /** What the send needs that only the triggering event knew (customer name, address, ...), encrypted; cleared once sent. */
  paramsEnc         String?   @map("params_enc")
  /** One message per purpose: "order:<id>:order_shipped", "cart:<token>:1", "campaign:<id>:<contact>". */
  dedupeKey         String    @map("dedupe_key")
  phoneMasked       String?   @map("phone_masked")
  trackingId        String?   @map("tracking_id")
  orderName         String?   @map("order_name")
  checkoutId        String?   @map("checkout_id")
  campaignId        String?   @map("campaign_id")
  ruleId            String?   @map("rule_id")
  /** scheduled | sending | sent | delivered | read | failed | cancelled | skipped */
  status            String    @default("scheduled")
  scheduledFor      DateTime  @map("scheduled_for")
  enqueuedAt        DateTime? @map("enqueued_at")
  attempts          Int       @default(0)
  providerMessageId String?   @unique @map("provider_message_id")
  errorCode         String?   @map("error_code")
  errorTitle        String?   @map("error_title")
  /** Why it was skipped or cancelled (no_phone, opted_out, no_marketing_consent, checkout_completed, ...). */
  reason            String?
  sentAt            DateTime? @map("sent_at")
  deliveredAt       DateTime? @map("delivered_at")
  readAt            DateTime? @map("read_at")
  failedAt          DateTime? @map("failed_at")
  cancelledAt       DateTime? @map("cancelled_at")
  pricingCategory   String?   @map("pricing_category")
  billable          Boolean?
  /** Short code of this message's tracked link (/api/r/<code>), and when it was first opened. */
  clickCode         String?   @unique @map("click_code")
  clickUrlEnc       String?   @map("click_url_enc")
  clickedAt         DateTime? @map("clicked_at")
  /** The order this message is credited with (each order at most once; see docs/whatsapp.md, Attribution). */
  attributedOrderId String?   @map("attributed_order_id")
  attributedRevenue Decimal?  @map("attributed_revenue") @db.Decimal(18, 2)
  attributedAt      DateTime? @map("attributed_at")
  test              Boolean   @default(false)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([storeId, dedupeKey])
  @@unique([storeId, attributedOrderId])
  @@index([status, scheduledFor])
  @@index([storeId, createdAt])
  @@index([campaignId])
  @@index([trackingId])
  @@index([checkoutId])
  @@index([contactId, sentAt])
  @@index([workspaceId])
  @@map("whatsapp_messages")
}

// Delivery callbacks as Meta sent them (one row per message and status).
model WhatsappMessageEvent {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  storeId     String   @map("store_id")
  messageId   String   @map("message_id")
  status      String
  occurredAt  DateTime @map("occurred_at")
  errorCode   String?  @map("error_code")
  errorTitle  String?  @map("error_title")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([messageId, status])
  @@index([storeId])
  @@index([workspaceId])
  @@map("whatsapp_message_events")
}

// An order as the customer's tracking page shows it. The link carries a random token (only its
// hash is looked up); the order id is never enough to see an order.
model OrderTracking {
  id              String    @id @default(cuid())
  workspaceId     String    @map("workspace_id")
  storeId         String    @map("store_id")
  shopifyOrderId  String    @map("shopify_order_id")
  orderName       String    @map("order_name")
  contactId       String?   @map("contact_id")
  tokenHash       String    @unique @map("token_hash")
  tokenEnc        String    @map("token_enc")
  reviewTokenHash String    @unique @map("review_token_hash")
  reviewTokenEnc  String    @map("review_token_enc")
  currency        String
  totalPrice      Decimal   @map("total_price") @db.Decimal(18, 2)
  /** [{ productId, title, quantity }]: product data only. */
  items           Json
  financialStatus String?   @map("financial_status")
  /** placed | paid | processing | packed | shipped | in_transit | out_for_delivery | delivered | delivery_failed | cancelled | refunded */
  status          String    @default("placed")
  /** SHIPMENT_RANK of the furthest parcel stage seen (notifications never go backwards). */
  shipmentRank    Int       @default(0) @map("shipment_rank")
  /** Whether a courier has ever reported progress (else the page says live tracking isn't available). */
  carrierEvents   Boolean   @default(false) @map("carrier_events")
  tags            String[]  @default([])
  checkoutToken   String?   @map("checkout_token")
  /** What the order said about consent: the whatsapp_opt_in cart attribute, Shopify SMS marketing consent. */
  cartOptIn       Boolean   @default(false) @map("cart_opt_in")
  smsConsent      Boolean   @default(false) @map("sms_consent")
  country         String?
  orderCreatedAt  DateTime  @map("order_created_at")
  paidAt          DateTime? @map("paid_at")
  deliveredAt     DateTime? @map("delivered_at")
  cancelledAt     DateTime? @map("cancelled_at")
  /** The link stops working after this; the row goes a year after the order. */
  expiresAt       DateTime  @map("expires_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([storeId, shopifyOrderId])
  @@index([storeId, orderCreatedAt])
  @@index([contactId])
  @@index([workspaceId])
  @@map("order_trackings")
}

// The order's timeline: what happened, when, and who said so (shopify | carrier | merchant).
model OrderTrackingEvent {
  id                  String    @id @default(cuid())
  workspaceId         String    @map("workspace_id")
  storeId             String    @map("store_id")
  trackingId          String    @map("tracking_id")
  type                String
  occurredAt          DateTime  @map("occurred_at")
  source              String
  fulfillmentId       String?   @map("fulfillment_id")
  courier             String?
  trackingNumber      String?   @map("tracking_number")
  trackingUrl         String?   @map("tracking_url")
  estimatedDeliveryAt DateTime? @map("estimated_delivery_at")
  dedupeKey           String    @map("dedupe_key")
  createdAt           DateTime  @default(now()) @map("created_at")

  @@unique([trackingId, dedupeKey])
  @@index([storeId])
  @@index([workspaceId])
  @@map("order_tracking_events")
}

// A checkout someone started and (so far) didn't finish, from Shopify's checkouts/* webhooks.
model AbandonedCheckout {
  id                 String    @id @default(cuid())
  workspaceId        String    @map("workspace_id")
  storeId            String    @map("store_id")
  checkoutToken      String    @map("checkout_token")
  contactId          String?   @map("contact_id")
  customerNameEnc    String?   @map("customer_name_enc")
  phoneMasked        String?   @map("phone_masked")
  currency           String
  totalPrice         Decimal   @map("total_price") @db.Decimal(18, 2)
  /** [{ title, quantity, price }]: product data only. */
  items              Json
  /** Shopify's recovery link (it opens the customer's checkout, so it is encrypted). */
  recoveryUrlEnc     String?   @map("recovery_url_enc")
  marketingConsent   Boolean   @default(false) @map("marketing_consent")
  /** open | reminded | recovered | completed | expired | ineligible */
  status             String    @default("open")
  ineligibleReason   String?   @map("ineligible_reason")
  checkoutCreatedAt  DateTime  @map("checkout_created_at")
  lastActivityAt     DateTime  @map("last_activity_at")
  completedAt        DateTime? @map("completed_at")
  recoveredOrderId   String?   @map("recovered_order_id")
  recoveredOrderName String?   @map("recovered_order_name")
  recoveredRevenue   Decimal?  @map("recovered_revenue") @db.Decimal(18, 2)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@unique([storeId, checkoutToken])
  @@index([storeId, lastActivityAt])
  @@index([workspaceId])
  @@map("abandoned_checkouts")
}

// A marketing campaign the merchant wrote, scheduled and authorized. Nothing is sent because a date approaches.
model WhatsappCampaign {
  id                  String    @id @default(cuid())
  workspaceId         String    @map("workspace_id")
  storeId             String    @map("store_id")
  name                String
  occasion            String
  objective           String?
  templateName        String    @map("template_name")
  templateLanguage    String    @map("template_language")
  mapping             Json      @default("{}")
  /** Values for the campaign's own variables: { greeting, discountPercentage, endDate }. */
  variables           Json      @default("{}")
  mediaUrl            String?   @map("media_url")
  linkUrl             String?   @map("link_url")
  discountCode        String?   @map("discount_code")
  audience            Json      @default("{}")
  startAt             DateTime  @map("start_at")
  endAt               DateTime? @map("end_at")
  /** draft | scheduled | sending | paused | completed | cancelled */
  status              String    @default("draft")
  estimatedRecipients Int?      @map("estimated_recipients")
  createdByUserId     String?   @map("created_by_user_id")
  approvedByUserId    String?   @map("approved_by_user_id")
  approvedAt          DateTime? @map("approved_at")
  startedAt           DateTime? @map("started_at")
  completedAt         DateTime? @map("completed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([storeId, status])
  @@index([workspaceId])
  @@map("whatsapp_campaigns")
}

// A customer's rating of an order, or of one product in it. One per order and product (editable).
model CustomerReview {
  id                String    @id @default(cuid())
  workspaceId       String    @map("workspace_id")
  storeId           String    @map("store_id")
  trackingId        String    @map("tracking_id")
  shopifyOrderId    String    @map("shopify_order_id")
  orderName         String    @map("order_name")
  /** "" for the order as a whole. */
  productId         String    @default("") @map("product_id")
  productTitle      String?   @map("product_title")
  rating            Int
  body              String?
  reviewerName      String?   @map("reviewer_name")
  /** pending | published | rejected */
  status            String    @default("pending")
