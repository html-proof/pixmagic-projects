// Tenant model: Workspace -> Membership(User, role) -> Store -> store-scoped data.
// Every store-scoped table carries workspace_id so Postgres RLS can enforce
// isolation without joins (see migrations/*_rls). No customer PII is stored:
// customers are reduced to a salted hash (customer_key).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated"
  // Node everywhere: the Lambda functions, the local server, tests and scripts.
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Owners and admins run the workspace. Every other role sees exactly the permissions granted to it
/// (memberships.permissions, packages/shared/src/access.ts); the role is the template they came from.
enum Role {
  owner
  admin
  analyst
  viewer
  manager
  custom
}

/// A member's role in Staff Management, on top of their workspace role (owners and admins have
/// every staff permission already). See packages/shared/src/staff/access.ts.
enum StaffRole {
  hr_manager
  payroll_manager
  supervisor
}

enum StoreStatus {
  pending
  syncing
  active
  uninstalled
  error
}

enum JobStatus {
  queued
  running
  succeeded
  failed
}

model User {
  id                 String         @id @default(cuid())
  email              String         @unique
  emailVerified      Boolean        @default(false) @map("email_verified")
  displayName        String?        @map("display_name")
  /// The profile picture's address, from the Google account the account was made with or signs in
  /// with under its own address (apps/api/src/identity.ts). https only; null when there is none.
  avatarUrl          String?        @map("avatar_url")
  timezone           String         @default("UTC")
  /// "Sign out everywhere": sessions issued before this instant are no longer accepted.
  sessionsValidAfter DateTime?      @map("sessions_valid_after")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  memberships        Membership[]
  identities         AuthIdentity[]
  /// Where this account is signed in (Settings → Security).
  sessions           UserSession[]
  /// Members and invitations this person brought into a workspace (Team & Access).
  invitedMembers     Membership[]   @relation("MembershipInviter")
  sentInvitations    Invitation[]   @relation("InvitationInviter")
  /// Employee records this account signs in as (employee portal).
  employments        Employee[]     @relation("EmployeeAccount")
  /// Employees this person is the assigned manager of.
  managedStaff       Employee[]     @relation("EmployeeManager")

  @@map("users")
}

/// A sign-in identity of a user: one Cognito user (password or Google). Several can point at
/// the same user, which is how an account is linked across sign-in methods; users.id never changes.
model AuthIdentity {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  /// "cognito".
  provider   String
  /// The Cognito user's `sub`.
  subject    String
  /// The Cognito user name (what refresh and admin calls address it by).
  username   String
  /// How this Cognito user signs in: "password" or "google".
  method     String
  email      String?
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
  @@map("auth_identities")
}

/// The app's own sign-in directory (apps/api/src/localAuth.ts), which takes over from Cognito's
/// user pool (docs/ikorex-migration): one row per sign-in identity, under the sub Cognito gave it
/// when it came from there (auth_identities.subject), so moving someone over changes nothing else.
model AuthAccount {
  sub              String             @id
  /// What admin calls and refreshes address it by: the sub for a password account, "google_<Google
  /// sub>" for a Google one (Cognito's own names, kept).
  username         String             @unique
  /// Password accounts only, lower case: what a sign-in with an address finds.
  loginEmail       String?            @unique @map("login_email")
  email            String
  emailVerified    Boolean            @default(false) @map("email_verified")
  /// A new address waiting for its code.
  pendingEmail     String?            @map("pending_email")
  name             String?
  picture          String?
  /// "password" or "google".
  method           String
  /// argon2id (a PHC string, apps/api/src/passwords.ts). Null for Google accounts, and for a
  /// password account moved over before it has one here (it gets one at "Forgot password?").
  passwordHash     String?            @map("password_hash")
  googleSub        String?            @unique @map("google_sub")
  /// false until the sign-up code (Cognito's UNCONFIRMED).
  confirmed        Boolean            @default(false)
  enabled          Boolean            @default(true)
  /// Two-step verification: the authenticator app's secret, encrypted with TOKEN_ENCRYPTION_KEYS,
  /// and a new one waiting for its first code.
  totpSecret       String?            @map("totp_secret")
  totpPending      String?            @map("totp_pending")
  totpEnabled      Boolean            @default(false) @map("totp_enabled")
  /// Refresh tokens issued before this are refused (sign out everywhere).
  tokensValidAfter DateTime           @default(now()) @map("tokens_valid_after")
  /// "cognito": moved over from the user pool, at movedAt.
  movedFrom        String?            @map("moved_from")
  movedAt          DateTime?          @map("moved_at")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  refreshTokens    AuthRefreshToken[]

  @@map("auth_accounts")
}

/// A refresh token the app's own sign-in issued: only its SHA-256 is kept.
model AuthRefreshToken {
  tokenHash String      @id @map("token_hash")
  sub       String
  createdAt DateTime    @default(now()) @map("created_at")
  expiresAt DateTime    @map("expires_at")
  revokedAt DateTime?   @map("revoked_at")
  account   AuthAccount @relation(fields: [sub], references: [sub], onDelete: Cascade)

  @@index([sub])
  @@index([expiresAt])
  @@map("auth_refresh_tokens")
}

/// Account-level security events (sign-in identity linked, password or email changed, signed out
/// everywhere, account deleted). Workspace actions go to audit_logs.
model AuthEvent {
  id        String   @id @default(cuid())
  /// Null once the account is deleted (the row stays, with no link to a person).
  userId    String?  @map("user_id")
  type      String
  ip        String?
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("auth_events")
}

/// A signed-in browser: one row per session (apps/api/src/session.ts), for the device list in
/// Settings → Security and for signing one device out. The session itself is the cookie; this row
/// only describes it. Ended rows (signed out, removed, or past expires_at) are deleted by a sweep.
model UserSession {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  /// The session's id (SessionClaims.sid): what signing this device out retires.
  sid        String    @unique
  /// How it signed in: "password" or "google".
  method     String
  /// What the browser says about itself (DeviceInfo in @app/shared/device).
  device     Json?
  /// Where it was last seen from: its address, and the country (ISO code), region and city the
  /// edge read from it. Approximate, for recognising a device only.
  ip         String?
  country    String?
  region     String?
  city       String?
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  expiresAt  DateTime  @map("expires_at")
  /// Signed out on that device, or removed from another one.
  endedAt    DateTime? @map("ended_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastSeenAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

model Workspace {
  id               String           @id @default(cuid())
  name             String
  createdAt        DateTime         @default(now()) @map("created_at")
  /// Made for a store installed from Shopify before anyone had a login for it, and not claimed yet
  /// (apps/api/src/routes/shopify.ts). Only such a workspace can be claimed, or left for another.
  awaitingClaim    Boolean          @default(false) @map("awaiting_claim")
  memberships      Membership[]
  stores           Store[]
  apiKeys          ApiKey[]
  auditLogs        AuditLog[]
  alerts           Alert[]
  invitations      Invitation[]
  subscription     Subscription?
  staffSettings    StaffSettings?
  employees        Employee[]
  departments      Department[]
  overtimePolicies OvertimePolicy[]
  breakPolicies    BreakPolicy[]
  staffHolidays    StaffHoliday[]
  payrollPeriods   PayrollPeriod[]
  dataRequests     DataRequest[]
  emailDeliveries  EmailDelivery[]

  @@map("workspaces")
}

model Membership {
  id              String     @id @default(cuid())
  workspaceId     String     @map("workspace_id")
  userId          String     @map("user_id")
  role            Role
  /// Staff Management role for members who are not owners or admins (null: no staff access).
  staffRole       StaffRole? @map("staff_role")
  /// Team & Access: the permissions granted to a restricted role (packages/shared/src/access.ts).
  /// Owners and admins have every permission and keep this empty.
  permissions     String[]   @default([])
  /// Access revoked by an owner or admin: the membership stays, so it can be restored, but grants
  /// nothing until then. Every access check refuses a revoked membership.
  revokedAt       DateTime?  @map("revoked_at")
  /// Who invited them (null for a workspace's creator and members from before Team & Access).
  invitedById     String?    @map("invited_by_id")
  /// When their role or permissions last changed.
  accessChangedAt DateTime?  @map("access_changed_at")
  /// Access given by an invitation ends here (60 days unless the inviter chose less) until an owner
  /// or admin renews it; null: no end (owners, and members from before invitations expired).
  accessExpiresAt DateTime?  @map("access_expires_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  workspace       Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy       User?      @relation("MembershipInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([invitedById])
  @@map("memberships")
}

/// An invitation to a workspace (Team & Access). Single use: only the token's hash is stored, and
/// accepting, revoking or expiry ends it for good. Kept after it ends, for the team page's counts and
/// the audit trail, until the daily retention sweep removes it (apps/worker, pruneTeamRecords).
model Invitation {
  id           String          @id @default(cuid())
  workspaceId  String          @map("workspace_id")
  email        String
  role         Role
  staffRole    StaffRole?      @map("staff_role")
  /// The permissions the member will have once they accept (restricted roles only).
  permissions  String[]        @default([])
  /// The inviter's note, shown in the email and on the invitation page.
  message      String?
  tokenHash    String          @unique @map("token_hash")
  expiresAt    DateTime        @map("expires_at")
  acceptedAt   DateTime?       @map("accepted_at")
  acceptedById String?         @map("accepted_by_id")
  revokedAt    DateTime?       @map("revoked_at")
  invitedById  String?         @map("invited_by_id")
  /// The last time the email went out, and the last time sending it failed.
  sentAt       DateTime?       @map("sent_at")
  sendFailedAt DateTime?       @map("send_failed_at")
  sendCount    Int             @default(0) @map("send_count")
  /// The link's token, encrypted with the app's keyring (AES-256-GCM, bound to this invitation), so an
  /// owner or admin can copy the same link again. Never stored in the clear: a copy of the database
  /// alone opens nothing. Null for invitations from before (their link can only be replaced).
  tokenSealed  String?         @map("token_sealed")
  /// The last time the link opened the dashboard, and how many times it has.
  lastOpenedAt DateTime?       @map("last_opened_at")
  openCount    Int             @default(0) @map("open_count")
  createdAt    DateTime        @default(now()) @map("created_at")
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy    User?           @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  deliveries   EmailDelivery[]

  @@index([workspaceId])
  @@index([workspaceId, email])
  @@index([invitedById])
  @@map("invitations")
}

/// One transactional email handed to the mail provider (a Team & Access invitation for now): which
/// provider took it, its id there, and what the provider has reported since (delivered, bounced,
/// marked as spam). No address or content is kept here; the invitation holds the address.
model EmailDelivery {
  id                String      @id @default(cuid())
  workspaceId       String      @map("workspace_id")
  invitationId      String?     @map("invitation_id")
  /// "team_invitation"
  kind              String
  /// "resend", "ses", "mailpit", "log"
  provider          String
  providerMessageId String?     @map("provider_message_id")
  /// queued, sent, delivered, delayed, bounced, complained, failed, not_allowed (packages/core/src/mail)
  status            String
  errorCode         String?     @map("error_code")
  /// What the provider said, without the recipient's address.
  errorMessage      String?     @map("error_message")
  attempts          Int         @default(0)
  sentAt            DateTime?   @map("sent_at")
  deliveredAt       DateTime?   @map("delivered_at")
  /// The provider's last event (delivered, bounced, complained) as it timed it.
  lastEventAt       DateTime?   @map("last_event_at")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  workspace         Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitation        Invitation? @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@unique([provider, providerMessageId])
  @@index([invitationId, createdAt])
  @@index([workspaceId])
  @@map("email_deliveries")
}

model NotificationPreference {
  userId       String  @map("user_id")
  workspaceId  String  @map("workspace_id")
  syncFailures Boolean @default(true) @map("sync_failures")
  weeklyDigest Boolean @default(false) @map("weekly_digest")
  productNews  Boolean @default(false) @map("product_news")
  // Low-stock and out-of-stock emails (the Inventory module's alerts).
  stockAlerts  Boolean @default(true) @map("stock_alerts")

  @@id([userId, workspaceId])
  @@map("notification_preferences")
}

model Store {
  id                    String                @id @default(cuid())
  workspaceId           String                @map("workspace_id")
  shopDomain            String                @unique @map("shop_domain")
  // Which of our Shopify apps the store is connected through ("default" = SHOPIFY_API_KEY;
  // others come from SHOPIFY_EXTRA_APPS, e.g. a custom-distribution app for one client).
  shopifyAppKey         String                @default("default") @map("shopify_app_key")
  name                  String?
  timezone              String                @default("UTC")
  currency              String                @default("USD")
  status                StoreStatus           @default(pending)
  // AES-256-GCM ciphertexts (packages/shared/crypto.ts); never returned by the API.
  accessTokenEnc        String?               @map("access_token_enc")
  refreshTokenEnc       String?               @map("refresh_token_enc")
  accessTokenExpiresAt  DateTime?             @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime?             @map("refresh_token_expires_at")
  tokenKeyVersion       Int?                  @map("token_key_version")
  grantedScopes         String[]              @map("granted_scopes")
  pixelInstalled        Boolean               @default(false) @map("pixel_installed")
  // From when the web pixel counts the store's visits: when bizinsights first had it in place (the
  // install_pixel job, or the first event accepted before it), keeping the earliest; null with no
  // pixel yet. The dashboard compares visits only with dates from then on ("No earlier data").
  pixelInstalledAt      DateTime?             @map("pixel_installed_at")
  pixelIngestKey        String?               @unique @map("pixel_ingest_key")
  installedAt           DateTime?             @map("installed_at")
  uninstalledAt         DateTime?             @map("uninstalled_at")
  // When someone disconnected the store in bizinsights (Settings → Stores), which leaves the app
  // installed in Shopify, and any charge on the store's bill with it. Null for a store Shopify
  // uninstalled the app from (app/uninstalled clears it), which cancelled every such charge, and
  // for one connected again. Status `uninstalled` covers both; billing tells them apart by this.
  // Stores disconnected before it existed read as uninstalled in Shopify.
  disconnectedAt        DateTime?             @map("disconnected_at")
  lastSyncedAt          DateTime?             @map("last_synced_at")
  // From when every Shopify order of the store is imported: the start of the earliest completed
  // import window (Shopify shares 60 days without read_all_orders), the epoch when the whole
  // history was imported, null when no import has recorded it. Set by the worker's orders sync.
  ordersHistoryFrom     DateTime?             @map("orders_history_from")
  // From when every stored order carries its customer (read_customers; docs/customer-analytics.md):
  // the moment the store granted it (core `customersFromChange`), moved back to the start of the
  // first full orders import queued since then once it is in (the epoch for the whole history; the
  // worker's orders sync). Null without read_customers, and for a store that granted it before this
  // column existed: the customer report then infers the day from the orders (`customersKnownDay`).
  customersFrom         DateTime?             @map("customers_from")
  // When Shopify created the store (Shop.createdAt), read with its details by the "shop" sync job;
  // null until it has been. The dashboard's dates begin on its day, or an earlier order's
  // (storeStartDay in @app/shared/dates): the earliest day custom dates may start, the years offered.
  shopCreatedAt         DateTime?             @map("shop_created_at")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  workspace             Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  billedSubscriptions   Subscription[]
  shopifyReports        ShopifyReport[]
  shopifyMarketingDays  ShopifyMarketingDay[]
  shopifyMarketingSync  ShopifyMarketingSync?
  reconciliations       Reconciliation[]
  inventoryLocations    InventoryLocation[]
  inventoryLevels       InventoryLevel[]
  inventoryMovements    InventoryMovement[]
  inventorySnapshots    InventorySnapshot[]
  inventoryAdjustments  InventoryAdjustment[]
  inventorySettings     InventorySettings?
  salesCalculation      SalesCalculation?
  inventoryAlerts       InventoryAlert[]
  inventorySyncRuns     InventorySyncRun[]
  expenses              StoreExpense[]
  expenseSettings       StoreExpenseSettings?
  expenseCategories     ExpenseCategory[]
  expenseEntries        ExpenseEntry[]
  businessEvents        BusinessEvent[]

  @@index([workspaceId])
  @@map("stores")
}

model WebhookEvent {
  id          String    @id @default(cuid())
  webhookId   String    @unique @map("webhook_id")
  shopDomain  String    @map("shop_domain")
  topic       String
  storeId     String?   @map("store_id")
  workspaceId String?   @map("workspace_id")
  status      JobStatus @default(queued)
  attempts    Int       @default(0)
  error       String?
  receivedAt  DateTime  @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")

  @@index([shopDomain, topic])
  @@index([status])
  // The dashboard's freshness (reports/overview.ts dataFreshness) reads one store's recent events on every poll.
  @@index([storeId, receivedAt])
  @@map("webhook_events")
}

model Product {
  id                String    @id @default(cuid())
  workspaceId       String    @map("workspace_id")
  storeId           String    @map("store_id")
  shopifyId         String    @map("shopify_id")
  title             String
  status            String?
  vendor            String?
  productType       String?   @map("product_type")
  shopifyCreatedAt  DateTime? @map("shopify_created_at")
  shopifyUpdatedAt  DateTime  @map("shopify_updated_at")
  // Product information for the Inventory module (null on rows stored before it read them; the
  // next catalog sync fills them in). `description` is Shopify's plain-text description, cut at
  // 5,000 characters; `category` the taxonomy category's full name; `collections` [{id, title}]
  // (the first 10, numeric ids); `imageUrl` the featured image.
  handle            String?
  description       String?
  tags              String[]  @default([])
  category          String?
  collections       Json?
  imageUrl          String?   @map("image_url")
  onlineStoreUrl    String?   @map("online_store_url")
  // The merchant's own low-stock threshold for every variant of the product (null: the store's).
  lowStockThreshold Int?      @map("low_stock_threshold")

  @@unique([storeId, shopifyId])
  @@index([workspaceId])
  @@map("products")
}

// One row per product variant: price, stock and unit cost (inventory module).
model ProductVariant {
  id                String    @id @default(cuid())
  workspaceId       String    @map("workspace_id")
  storeId           String    @map("store_id")
  productShopifyId  String    @map("product_shopify_id")
  shopifyId         String    @map("shopify_id")
  title             String
  sku               String?
  price             Decimal   @db.Decimal(18, 2)
  // Total sellable quantity across locations; null when Shopify doesn't track inventory for it.
  inventoryQuantity Int?      @map("inventory_quantity")
  unitCost          Decimal?  @map("unit_cost") @db.Decimal(18, 2)
  shopifyUpdatedAt  DateTime  @map("shopify_updated_at")
  // The variant's InventoryItem (numeric id; one per variant): what its stock levels are keyed by
  // (inventory_levels.inventory_item_id). Null until a catalog sync since the Inventory module read it.
  inventoryItemId   String?   @map("inventory_item_id")
  barcode           String?
  compareAtPrice    Decimal?  @map("compare_at_price") @db.Decimal(18, 2)
  // [{name, value}]: size, colour, material...
  options           Json?
  taxable           Boolean?
  // "deny" | "continue": whether Shopify keeps selling it when it is out of stock.
  inventoryPolicy   String?   @map("inventory_policy")
  requiresShipping  Boolean?  @map("requires_shipping")
  weight            Decimal?  @db.Decimal(18, 4)
  // GRAMS | KILOGRAMS | OUNCES | POUNDS, as Shopify names them.
  weightUnit        String?   @map("weight_unit")
  position          Int?
  shopifyCreatedAt  DateTime? @map("shopify_created_at")
  // The merchant's own low-stock threshold for this variant (null: the product's, else the store's).
  lowStockThreshold Int?      @map("low_stock_threshold")

  @@unique([storeId, shopifyId])
  @@index([storeId, productShopifyId])
  @@index([storeId, inventoryItemId])
  @@index([workspaceId])
  @@map("product_variants")
}

// ------------------------------------------------------------------ Inventory module
// docs/inventory.md. Shopify keeps stock per InventoryItem (one per variant) per Location, in
// separate quantity states; these tables mirror that and nothing is ever derived from guesses.
// Ids are Shopify's numeric ids (gid://shopify/<Type>/<id> without the prefix), as elsewhere.

// A Shopify location (warehouse, shop, app-managed). Kept with `deletedAt` once Shopify drops it,
// so the stock history that names it still can.
model InventoryLocation {
  id                   String    @id @default(cuid())
  workspaceId          String    @map("workspace_id")
  storeId              String    @map("store_id")
  shopifyId            String    @map("shopify_id")
  name                 String
  isActive             Boolean   @map("is_active")
  // Managed by a fulfillment service app (Shopify's "legacy" locations).
  isFulfillmentService Boolean   @default(false) @map("is_fulfillment_service")
  fulfillsOnlineOrders Boolean?  @map("fulfills_online_orders")
  // {address1, address2, city, province, zip, country, countryCode}; null when Shopify gave none.
  address              Json?
  formattedAddress     String?   @map("formatted_address")
  syncedAt             DateTime  @map("synced_at")
  deletedAt            DateTime? @map("deleted_at")
  store                Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, shopifyId])
  @@index([workspaceId])
  @@map("inventory_locations")
}

// One inventory item at one location, with every quantity state Shopify reports for it, as last
// read from Shopify. `on_hand` = available + committed + reserved + damaged + safety_stock +
// quality_control (Shopify's rule); `incoming` is separate.
model InventoryLevel {
  id                String   @id @default(cuid())
  workspaceId       String   @map("workspace_id")
  storeId           String   @map("store_id")
  inventoryItemId   String   @map("inventory_item_id")
  locationShopifyId String   @map("location_shopify_id")
  available         Int
  onHand            Int      @map("on_hand")
  committed         Int
  incoming          Int
  reserved          Int
  damaged           Int
  safetyStock       Int      @map("safety_stock")
  qualityControl    Int      @map("quality_control")
  // InventoryLevel.updatedAt: older reads never overwrite newer ones (webhooks arrive out of order).
  shopifyUpdatedAt  DateTime @map("shopify_updated_at")
  // When bizinsights last read it from Shopify (a sync, a check, a webhook's re-read).
  syncedAt          DateTime @map("synced_at")
  store             Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, inventoryItemId, locationShopifyId])
  @@index([storeId, locationShopifyId])
  @@index([workspaceId])
  @@map("inventory_levels")
}

// A change in a quantity state that bizinsights saw: the value before (null the first time it was
// seen) and after. `source` says how it was seen: "webhook" (Shopify announced it and we read the
// level), "sync" (an import or refresh found it), "reconcile" (the scheduled check found a change no
// webhook had reported), "adjustment" (made in bizinsights and confirmed by Shopify:
// `adjustmentId`). Shopify's own adjustment history is not readable through its API, so every row
// here is an observation of Shopify's state, never a reconstruction. Names are copied in so the
// history still reads after a product or location is deleted.
model InventoryMovement {
  id                String   @id @default(cuid())
  workspaceId       String   @map("workspace_id")
  storeId           String   @map("store_id")
  inventoryItemId   String   @map("inventory_item_id")
  locationShopifyId String   @map("location_shopify_id")
  variantShopifyId  String?  @map("variant_shopify_id")
  productShopifyId  String?  @map("product_shopify_id")
  productTitle      String?  @map("product_title")
  variantTitle      String?  @map("variant_title")
  sku               String?
  locationName      String?  @map("location_name")
  // available | on_hand | committed | incoming | reserved | damaged | safety_stock | quality_control
  quantityName      String   @map("quantity_name")
  before            Int?
  after             Int
  delta             Int
  source            String
  adjustmentId      String?  @map("adjustment_id")
  shopifyUpdatedAt  DateTime @map("shopify_updated_at")
  observedAt        DateTime @default(now()) @map("observed_at")
  store             Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, observedAt])
  @@index([storeId, variantShopifyId, observedAt])
  @@index([workspaceId])
  @@map("inventory_movements")
}

// The store's stock at the end of a store-local day (updated through the day; the last write is the
// day's close), storewide (`locationKey` "all") and per location (its numeric id). Trend charts
// read these and only these: a day without one shows as not recorded.
model InventorySnapshot {
  id                String   @id @default(cuid())
  workspaceId       String   @map("workspace_id")
  storeId           String   @map("store_id")
  day               String
  locationKey       String   @map("location_key")
  trackedVariants   Int      @map("tracked_variants")
  untrackedVariants Int      @map("untracked_variants")
  available         Int
  onHand            Int      @map("on_hand")
  committed         Int
  incoming          Int
  lowStock          Int      @map("low_stock")
  outOfStock        Int      @map("out_of_stock")
  // Cost of the units on hand, for the variants whose cost is known (`variantsWithCost` of
  // `variantsInStock`); null when none is.
  costValue         Decimal? @map("cost_value") @db.Decimal(18, 2)
  variantsWithCost  Int      @map("variants_with_cost")
  variantsInStock   Int      @map("variants_in_stock")
  retailValue       Decimal  @map("retail_value") @db.Decimal(18, 2)
  takenAt           DateTime @map("taken_at")
  store             Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, day, locationKey])
  @@index([workspaceId])
  @@map("inventory_snapshots")
}

// A stock change asked for in bizinsights, and what Shopify said. Written "pending" before the
// mutation is sent and settled once (confirmed | failed | unknown), never edited after: a database
// trigger refuses any other update (migration 20261019120000), and the tenant role may only read.
// `idempotencyKey` is the client's, sent to Shopify as @idempotent(key:), so a retried request
// changes stock once.
model InventoryAdjustment {
  id                String    @id @default(cuid())
  workspaceId       String    @map("workspace_id")
  storeId           String    @map("store_id")
  idempotencyKey    String    @map("idempotency_key")
  actorUserId       String?   @map("actor_user_id")
  inventoryItemId   String    @map("inventory_item_id")
  locationShopifyId String    @map("location_shopify_id")
  variantShopifyId  String?   @map("variant_shopify_id")
  productShopifyId  String?   @map("product_shopify_id")
  productTitle      String?   @map("product_title")
  variantTitle      String?   @map("variant_title")
  sku               String?
  locationName      String?   @map("location_name")
  // increase | decrease | set | correction | damaged | stocktake
  kind              String
  // The quantity state changed: available, on_hand (stocktake), damaged (moved from available).
  quantityName      String    @map("quantity_name")
  // Shopify's reason code (correction, received, damaged, cycle_count_available, ...).
  reason            String
  note              String?
  referenceId       String?   @map("reference_id")
  // The change asked for: a delta (increase, decrease, correction, damaged) or a new quantity (set, stocktake).
  delta             Int?
  quantity          Int?
  // The quantity the person saw when they asked; sent as changeFromQuantity, so Shopify refuses
  // the change if the stock moved in the meantime.
  expectedBefore    Int?      @map("expected_before")
  status            String
  errorCode         String?   @map("error_code")
  // inventoryAdjustmentGroup.id from Shopify's answer.
  shopifyGroupId    String?   @map("shopify_group_id")
  // The quantity read back from Shopify right after it confirmed the change.
  resultQuantity    Int?      @map("result_quantity")
  createdAt         DateTime  @default(now()) @map("created_at")
  completedAt       DateTime? @map("completed_at")
  store             Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, idempotencyKey])
  @@index([storeId, createdAt])
  @@index([workspaceId])
  @@map("inventory_adjustments")
}

// The store's inventory settings (thresholds, alerts, the check's schedule). No row = defaults
// (@app/shared/inventory INVENTORY_DEFAULTS).
model InventorySettings {
  storeId           String   @id @map("store_id")
  workspaceId       String   @map("workspace_id")
  lowStockThreshold Int      @default(10) @map("low_stock_threshold")
  emailAlerts       Boolean  @default(true) @map("email_alerts")
  dashboardAlerts   Boolean  @default(true) @map("dashboard_alerts")
  whatsappAlerts    Boolean  @default(false) @map("whatsapp_alerts")
  // The approved WhatsApp template the alert is sent with, and the numbers it goes to
  // (AES-256-GCM, never returned: the API sends them masked).
  whatsappTemplate  String?  @map("whatsapp_template")
  whatsappToEnc     String?  @map("whatsapp_to_enc")
  // Hours between full checks of every stock level against Shopify (1 to 24).
  reconcileHours    Int      @default(6) @map("reconcile_hours")
  // For restock suggestions: days a reorder takes to arrive, and days of sales it should cover.
  leadTimeDays      Int      @default(14) @map("lead_time_days")
  coverDays         Int      @default(30) @map("cover_days")
  updatedAt         DateTime @updatedAt @map("updated_at")
  store             Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("inventory_settings")
}

// A variant's stock alert (out_of_stock | low_stock | fast_movement): one row per variant and kind,
// opened when the variant crosses into it and resolved when it leaves. `notifiedAt` is when people
// were told, so an alert that stays open is announced once (and one that flaps at most once a day).
model InventoryAlert {
  id               String    @id @default(cuid())
  workspaceId      String    @map("workspace_id")
  storeId          String    @map("store_id")
  variantShopifyId String    @map("variant_shopify_id")
  kind             String
  available        Int
  threshold        Int?
  openedAt         DateTime  @map("opened_at")
  resolvedAt       DateTime? @map("resolved_at")
  notifiedAt       DateTime? @map("notified_at")
  store            Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, variantShopifyId, kind])
  @@index([storeId, resolvedAt])
  @@index([workspaceId])
  @@map("inventory_alerts")
}

// One full pass over a store's stock (the import, a manual refresh, or the scheduled check against
// Shopify): how many levels it read and how many differed from what bizinsights held.
model InventorySyncRun {
  id            String    @id @default(cuid())
  workspaceId   String    @map("workspace_id")
  storeId       String    @map("store_id")
  // import | manual | reconcile
  trigger       String
  status        String
  locations     Int       @default(0)
  levelsChecked Int       @default(0) @map("levels_checked")
  differences   Int       @default(0)
  // Up to 20 of the differences: [{inventoryItemId, locationId, name, ours, shopify}].
  sample        Json?
  error         String?
  startedAt     DateTime  @map("started_at")
  finishedAt    DateTime? @map("finished_at")
  store         Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, startedAt])
  @@index([workspaceId])
  @@map("inventory_sync_runs")
}

model Order {
  id                  String          @id @default(cuid())
  workspaceId         String          @map("workspace_id")
  storeId             String          @map("store_id")
  shopifyId           String          @map("shopify_id")
  name                String
  currency            String
  /// Store-local day of shopifyProcessedAt (shopifyCreatedAt while that is null), as Shopify's reports date the order.
  localDay            String          @map("local_day")
  shopifyCreatedAt    DateTime        @map("shopify_created_at")
  /// Order.processedAt: when the sale happened, the date Shopify's reports use. Earlier than
  /// shopifyCreatedAt for an imported, POS-offline or marketplace order. Null on orders stored
  /// before it was read (the re-read fills it in).
  shopifyProcessedAt  DateTime?       @map("shopify_processed_at")
  shopifyUpdatedAt    DateTime        @map("shopify_updated_at")
  /// Every item a gift card. Shopify's reports count neither the order nor its customer.
  giftCardOnly        Boolean         @default(false) @map("gift_card_only")
  cancelledAt         DateTime?       @map("cancelled_at")
  financialStatus     String?         @map("financial_status")
  subtotal            Decimal         @db.Decimal(18, 2)
  totalDiscounts      Decimal         @map("total_discounts") @db.Decimal(18, 2)
  totalTax            Decimal         @map("total_tax") @db.Decimal(18, 2)
  totalShipping       Decimal         @map("total_shipping") @db.Decimal(18, 2)
  totalPrice          Decimal         @map("total_price") @db.Decimal(18, 2)
  customerKey         String?         @map("customer_key")
  isReturningCustomer Boolean         @default(false) @map("is_returning_customer")
  // Sales channel as Shopify reports it (web, pos, shopify_draft_order, an app id, ...).
  sourceName          String?         @map("source_name")
  // Lowercase: fulfilled | partially_fulfilled | unfulfilled | ... (GraphQL displayFulfillmentStatus).
  fulfillmentStatus   String?         @map("fulfillment_status")
  // When the first fulfillment was created (time-to-ship).
  fulfilledAt         DateTime?       @map("fulfilled_at")
  discountCodes       String[]        @default([]) @map("discount_codes")
  /// Where the customer came from (packages/shared/src/traffic.ts): facebook | instagram | google | ... | direct | other | unknown.
  /// Null on orders stored before bizinsights recorded it (the dashboard re-reads those once).
  trafficSource       String?         @map("traffic_source")
  /// paid | unpaid | email | direct | referral | unknown
  trafficMedium       String?         @map("traffic_medium")
  /// The link's utm_campaign. Never the URL itself.
  trafficCampaign     String?         @map("traffic_campaign")
  /// The referring site's host only.
  referrerHost        String?         @map("referrer_host")
  /// The order's Shopify updated_at when its sales (order_sales) were last read from Shopify; null
  /// while they never were (an order known only from a webhook, or stored before sales were read).
  salesUpdatedAt      DateTime?       @map("sales_updated_at")
  /// The money state of the REST payload the stored sales were read for (`salesKey` in
  /// packages/core/src/normalize.ts): a webhook whose state matches needs no new read.
  salesKey            String?         @map("sales_key")
  /// Shopify's position of this order in its customer's order history (CustomerJourneySummary
  /// .customerOrderIndex: 1 = the customer's first purchase; test orders not counted). Null when
  /// Shopify gave none (no journey, e.g. POS) or the order was only seen in a webhook so far.
  customerOrderIndex  Int?            @map("customer_order_index")
  /// The customer's lifetime order count (Customer.numberOfOrders) when this order was read; a
  /// fallback for orders without customerOrderIndex (settleReturningCustomers in core).
  customerOrderCount  Int?            @map("customer_order_count")
  lineItems           OrderLineItem[]
  sales               OrderSale[]

  @@unique([storeId, shopifyId])
  @@index([storeId, localDay])
  // A customer's earlier orders (returning-customer flag, redaction, campaign audiences).
  @@index([storeId, customerKey, shopifyCreatedAt])
  // The orders cancelled in the dates asked about (recent orders), and a history year's orders by creation.
  @@index([storeId, cancelledAt])
  @@index([storeId, shopifyCreatedAt])
  @@index([workspaceId])
  @@map("orders")
}

model OrderLineItem {
  id               String  @id @default(cuid())
  workspaceId      String  @map("workspace_id")
  storeId          String  @map("store_id")
  orderId          String  @map("order_id")
  shopifyId        String  @map("shopify_id")
  productShopifyId String? @map("product_shopify_id")
  variantShopifyId String? @map("variant_shopify_id")
  sku              String?
  title            String
  quantity         Int
  price            Decimal @db.Decimal(18, 2)
  discount         Decimal @db.Decimal(18, 2)
  order            Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([storeId, shopifyId])
  @@index([orderId])
  @@map("order_line_items")
}

// The refunds table (one row per Shopify refund) was dropped on 2026-11-12 by migration
// 20261112130000_drop_refunds: returns are read from Shopify's sales records (order_sales, below)
// since 2026-10-16, and nothing wrote it after that.

// A store's full order history (read_all_orders), imported one store-local calendar year at a time,
// newest first (packages/core/src/orderHistory.ts): one row per year of the import's plan, so the
// dashboard can say which years are in, an import that stopped resumes at the year it stopped in,
// and a year that failed says why. By order creation date, as Shopify's order search filters: the
// newest year runs on to now (`toAt` null), the oldest from the store's first order back (its
// search has no lower bound). A newer plan replaces the rows (one per store and year).
model OrderHistoryWindow {
  id              String    @id @default(cuid())
  workspaceId     String    @map("workspace_id")
  storeId         String    @map("store_id")
  // The import (sync_jobs.id) that planned the years, and the one working on this year now.
  planJobId       String    @map("plan_job_id")
  syncJobId       String    @map("sync_job_id")
  year            Int
  fromAt          DateTime  @map("from_at")
  toAt            DateTime? @map("to_at")
  // queued | running | done | failed
  status          String    @default("queued")
  // Orders created in the window and held once it was done.
  orders          Int       @default(0)
  // Whether the plan read customers with the orders (read_customers): a plan read without them is
  // started over, not resumed, when the scope arrives, since its orders lack the customer.
  withCustomers   Boolean   @map("with_customers")
  // The bulk export submitted for this year: a finished export of another year is never read as this one's.
  bulkOperationId String?   @map("bulk_operation_id")
  attempts        Int       @default(0)
  error           String?
  startedAt       DateTime? @map("started_at")
  finishedAt      DateTime? @map("finished_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([storeId, year])
  @@index([workspaceId])
  @@map("order_history_windows")
}

// Shopify's own report figures (ShopifyQL, scope read_reports; packages/core/src/shopifyReports.ts):
// one answer per store, dataset ("sales" | "profit" | "sessions") and store-local window
// ("from|to|until"), kept so the dashboard's polls never wait on Shopify. `values` holds the figures
// in our names; `error` why Shopify gave none ("access_denied" | "unsupported" | "failed"), next to
// the last figures it did give when a refresh failed.
model ShopifyReport {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  storeId     String   @map("store_id")
  dataset     String
  window      String   @map("time_window")
  values      Json?
  error       String?
  fetchedAt   DateTime @map("fetched_at")
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, dataset, window])
  @@index([workspaceId])
  @@index([fetchedAt])
  @@map("shopify_reports")
}

// Ad spend, impressions and clicks as the store's marketing apps (Facebook & Instagram, Google &
// YouTube, ...) report them to Shopify: ShopifyQL's marketing_engagements, read with read_reports
// (packages/core/src/shopifyMarketing.ts). One row per store-local day, channel (marketing_channel),
// app (marketing_app_name) and campaign (marketing_campaign); campaign "" is the channel's whole day,
// what totals add up, the named ones only its breakdown. Each read replaces its window's rows, so a
// day Shopify revised (late spend, a campaign renamed) never keeps its old figures beside the new.
// A figure the channel didn't report is null, never 0.
model ShopifyMarketingDay {
  workspaceId  String   @map("workspace_id")
  storeId      String   @map("store_id")
  day          String
  channel      String
  app          String   @default("")
  campaign     String   @default("")
  /// In the store's currency (`currency`), as Shopify reports every channel's money.
  spend        Decimal? @db.Decimal(18, 2)
  impressions  Int?
  clicks       Int?
  /// The channel's own count of orders from its marketing (its attribution, not the store's orders), their sales, and its first-time customers.
  orders       Float?
  sales        Decimal? @db.Decimal(18, 2)
  newCustomers Float?   @map("new_customers")
  currency     String
  fetchedAt    DateTime @map("fetched_at")
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, day, channel, app, campaign])
  @@index([workspaceId])
  @@map("shopify_marketing_days")
}

// Where a store's reading of Shopify's marketing report stands: the days read (covered_from back to
// synced_through), whether every day back to the store's first is in (backfilled), and the last read's
// outcome. One row per store, written by the worker only.
model ShopifyMarketingSync {
  storeId             String    @id @map("store_id")
  workspaceId         String    @map("workspace_id")
  coveredFrom         String?   @map("covered_from")
  syncedThrough       String?   @map("synced_through")
  backfilled          Boolean   @default(false)
  lastSyncedAt        DateTime? @map("last_synced_at")
  lastAttemptAt       DateTime? @map("last_attempt_at")
  /// "access_denied", "unsupported" or "failed" (ReportError): why the last read got nothing; null after a good one.
  lastError           String?   @map("last_error")
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  store               Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("shopify_marketing_syncs")
}

// One check of a store's figures against Shopify for a window of store-local days
// (packages/core/src/reconcile.ts, docs/kpis.md "Checked against Shopify"). `source` is what the
// figures were checked against: "shopify_records" (Shopify's orders and sales records, read again)
// or "shopify_reports" (Shopify's own report totals, ShopifyQL). `findings` holds the order-level
// causes found (missing, outdated, deleted orders, sales that differ, stale day totals) with a few
// order ids each; `actions` what was repaired. Kept 90 days.
model Reconciliation {
  id            String                 @id @default(cuid())
  workspaceId   String                 @map("workspace_id")
  storeId       String                 @map("store_id")
  source        String
  trigger       String
  fromDay       String                 @map("from_day")
  toDay         String                 @map("to_day")
  timezone      String
  currency      String
  /// running | verified | repaired | differences | incomplete | failed
  status        String
  ordersChecked Int                    @default(0) @map("orders_checked")
  findings      Json?
  actions       Json?
  /// Where a running check has got to (its cursor, Shopify's totals so far): cleared when it ends.
  state         Json?
  error         String?
  startedAt     DateTime               @map("started_at")
  finishedAt    DateTime?              @map("finished_at")
  store         Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  results       ReconciliationResult[]

  @@index([storeId, startedAt])
  @@index([workspaceId])
  @@map("reconciliations")
}

// One metric of a reconciliation: Shopify's figure, ours before and after any repair, and why
// they differed. Money in the store's currency.
model ReconciliationResult {
  id               String         @id @default(cuid())
  workspaceId      String         @map("workspace_id")
  reconciliationId String         @map("reconciliation_id")
  metric           String
  shopifyValue     Decimal?       @map("shopify_value") @db.Decimal(18, 2)
  beforeValue      Decimal?       @map("before_value") @db.Decimal(18, 2)
  afterValue       Decimal?       @map("after_value") @db.Decimal(18, 2)
  /// match | repaired | difference | sync_delay | not_verifiable
  status           String
  cause            String?
  reconciliation   Reconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)

  @@unique([reconciliationId, metric])
  @@index([workspaceId])
  @@map("reconciliation_results")
}

// One of Shopify's sales records for an order (Order.agreements → sales): what was sold, returned
// or changed, on the day it happened. Shopify's own reports are built from these, so the dashboard's
// sales totals are too (docs/kpis.md). Amounts are in the store's currency and signed as Shopify
// sends them; a return is negative.
model OrderSale {
  id                String   @id @default(cuid())
  workspaceId       String   @map("workspace_id")
  storeId           String   @map("store_id")
  orderId           String   @map("order_id")
  shopifyId         String   @map("shopify_id")
  /// Store-local day of `happenedAt`.
  localDay          String   @map("local_day")
  happenedAt        DateTime @map("happened_at")
  /// order | return | update | unknown (Shopify's SaleActionType, lowercase).
  actionType        String   @map("action_type")
  /// product | shipping | gift_card | tip | duty | fee | additional_fee | adjustment | unknown (SaleLineType).
  lineType          String   @map("line_type")
  /// The line item of a product sale (OrderLineItem.shopifyId).
  lineItemShopifyId String?  @map("line_item_shopify_id")
  quantity          Int?
  /// totalAmount: after discounts, taxes included.
  amount            Decimal  @db.Decimal(18, 2)
  /// totalDiscountAmountBeforeTaxes.
  discount          Decimal  @db.Decimal(18, 2)
  /// totalTaxAmount.
  tax               Decimal  @db.Decimal(18, 2)
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([storeId, shopifyId])
  @@index([storeId, localDay])
  @@index([orderId])
  @@index([workspaceId])
  @@map("order_sales")
}

model DailyStoreMetrics {
  workspaceId             String   @map("workspace_id")
  storeId                 String   @map("store_id")
  day                     String
  grossSales              Decimal  @default(0) @map("gross_sales") @db.Decimal(18, 2)
  discounts               Decimal  @default(0) @db.Decimal(18, 2)
  /// Returns: what refunds, cancellations and edits took back (Shopify's "sales reversals").
  refunds                 Decimal  @default(0) @db.Decimal(18, 2)
  /// Shipping charged after shipping discounts and refunds, before tax.
  shipping                Decimal  @default(0) @db.Decimal(18, 2)
  taxes                   Decimal  @default(0) @db.Decimal(18, 2)
  /// Import duties charged, before tax.
  duties                  Decimal  @default(0) @db.Decimal(18, 2)
  /// Shopify's fees and additional fees (and any sale it gives no type), before tax.
  additionalFees          Decimal  @default(0) @map("additional_fees") @db.Decimal(18, 2)
  /// Net sales + shipping + taxes + duties + additional fees: Shopify's "Total sales".
  totalSales              Decimal  @default(0) @map("total_sales") @db.Decimal(18, 2)
  /// What refunds, returns and cancellations took off total sales that day: their sales with tax,
  /// shipping, duties and fees in (gift cards and tips aside, as total sales leaves them out).
  totalRefunded           Decimal  @default(0) @map("total_refunded") @db.Decimal(18, 2)
  /// Orders placed that day, gift-card-only orders left out (as Shopify's reports count them).
  orders                  Int      @default(0)
  /// What those orders sold on the day they were placed (items after discounts, before tax; no gift
  /// cards, no edits made on a later day): average order value's numerator. Null on rows from before
  /// it was kept.
  orderValue              Decimal? @map("order_value") @db.Decimal(18, 2)
  /// Items sold less items returned, gift cards included (Shopify's net items sold).
  units                   Int      @default(0)
  ordersWithCustomer      Int      @default(0) @map("orders_with_customer")
  returningCustomerOrders Int      @default(0) @map("returning_customer_orders")
  refundedOrders          Int      @default(0) @map("refunded_orders")

  @@id([storeId, day])
  @@index([workspaceId])
  @@map("daily_store_metrics")
}

// A store's own sales calculation ("Custom sales", docs/kpis.md): which lines of Shopify's total
// sales it counts, and whether the dashboard shows it. Only the choice is kept, never an amount:
// the figures always come from the store's sales records for the dates on screen.
model SalesCalculation {
  storeId          String   @id @map("store_id")
  workspaceId      String   @map("workspace_id")
  /// { netSales, additionalFees, duties, shipping, taxes } as booleans (salesCalculationInput in @app/shared).
  components       Json
  /// The merchant's name for a calculation of their own.
  label            String?
  applyToDashboard Boolean  @default(false) @map("apply_to_dashboard")
  /// Calculations kept to switch between: [{ name, components }], at most 10.
  presets          Json     @default("[]")
  updatedByUserId  String?  @map("updated_by_user_id")
  updatedAt        DateTime @updatedAt @map("updated_at")
  store            Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("sales_calculations")
}

// A cost the store's owner keeps in bizinsights (Settings → Costs, docs/kpis.md "Costs and net
// profit"): what Shopify, its profit report and the ad platforms can't say (the Shopify plan, apps,
// staff, rent, shipping labels, fees...). The dashboard spreads it over the days it covers
// (expenseInRange in @app/shared/expenses); only the owner's own figure is kept.
model StoreExpense {
  id              String         @id @default(cuid())
  workspaceId     String         @map("workspace_id")
  storeId         String         @map("store_id")
  name            String
  description     String?
  /// EXPENSE_CATEGORIES in @app/shared/expenses (each in a section: EXPENSE_CATEGORY_SECTION), or one of the store's
  /// own, `custom:<expense_categories.id>`.
  category        String
  /// amount | percent | per_order | per_item (EXPENSE_METHODS)
  method          String         @default("amount")
  /// In the store's currency; for `percent`, the percentage. Below 0 only for an amount paid once (a refund, a credit).
  amount          Decimal        @db.Decimal(18, 2)
  /// What a percentage is of: total_sales | revenue | net_sales (PERCENT_BASES); null for the other methods.
  percentBase     String?        @map("percent_base")
  /// The currency it was entered in (the store's); null for costs saved before the field.
  currency        String?
  /// once | daily | weekly | fortnightly | monthly | quarterly | half_yearly | yearly (EXPENSE_CADENCES); `daily` for
  /// a cost that follows the sales.
  cadence         String
  /// The store-local day it starts (paid once: the day it was paid).
  startsOn        String         @map("starts_on")
  /// The last store-local day it applies to; null while it goes on.
  endsOn          String?        @map("ends_on")
  /// While paused: no payment falls due from this store-local day on. Null: not paused.
  pausedFrom      String?        @map("paused_from")
  vendor          String?
  paymentMethod   String?        @map("payment_method")
  note            String?
  /// The cost this one took over from when its terms changed from a payment on (that one ends the day before).
  replacesId      String?        @map("replaces_id")
  createdByUserId String?        @map("created_by_user_id")
  updatedByUserId String?        @map("updated_by_user_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  store           Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  entries         ExpenseEntry[]

  @@index([workspaceId])
  @@index([storeId])
  @@map("store_expenses")
}

// A category a store made for its own costs (Profit & Loss → Categories), with the section of the profit
// and loss its costs go in. A cost names it `custom:<id>` (store_expenses.category).
model ExpenseCategory {
  id              String   @id @default(cuid())
  workspaceId     String   @map("workspace_id")
  storeId         String   @map("store_id")
  name            String
  /// advertising | variable | fixed | non_operating (EXPENSE_SECTIONS)
  section         String
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, name])
  @@index([workspaceId])
  @@map("expense_categories")
}

// One payment of a recurring cost that has fallen due, kept as it was paid: recorded by bizinsights
// on the day it falls due (the cron sweep every 15 minutes, or when the cost is saved), never twice (one row per cost
// and due day), and changed or skipped one by one by the owner. Changing the cost later never
// rewrites a payment already recorded.
model ExpenseEntry {
  id              String       @id @default(cuid())
  workspaceId     String       @map("workspace_id")
  storeId         String       @map("store_id")
  expenseId       String       @map("expense_id")
  /// The store-local day the payment fell due.
  dueOn           String       @map("due_on")
  /// What was paid (0 when skipped).
  amount          Decimal      @db.Decimal(18, 2)
  /// What the cost said when it was recorded: kept when the payment is changed.
  scheduledAmount Decimal      @map("scheduled_amount") @db.Decimal(18, 2)
  /// posted | skipped
  status          String       @default("posted")
  note            String?
  editedByUserId  String?      @map("edited_by_user_id")
  editedAt        DateTime?    @map("edited_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  expense         StoreExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  store           Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([expenseId, dueOn])
  @@index([workspaceId])
  @@index([storeId, dueOn])
  @@map("expense_entries")
}

// Whether the store's costs list holds every cost, and from which day: net profit is given only for
// dates from then on (expensesComplete in @app/shared/expenses). And the days the store is open, which
// its recurring costs are spread over (expenseInRange). One row per store, once said.
model StoreExpenseSettings {
  storeId           String   @id @map("store_id")
  workspaceId       String   @map("workspace_id")
  /// The first store-local day the list holds every cost from; null: not said, or taken back.
  completeFrom      String?  @map("complete_from")
  /// The weekdays the store is open, Monday = 0 … Sunday = 6; empty: every calendar day.
  operatingWeekdays Int[]    @default([]) @map("operating_weekdays")
  updatedByUserId   String?  @map("updated_by_user_id")
  updatedAt         DateTime @updatedAt @map("updated_at")
  store             Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("store_expense_settings")
}

// One storefront visit: a shopper (hashed Shopify client id) on one store-local day. Where they
// landed, where they were last seen, how far down the funnel they got (0 visited … 4 purchased)
// and which site sections they saw (bitmask). Paths are cleaned of tokens and query strings
// before they get here; see packages/shared/src/journey.ts.
model FunnelVisit {
  workspaceId  String    @map("workspace_id")
  storeId      String    @map("store_id")
  day          String
  visitor      String
  enteredAt    DateTime? @map("entered_at")
  entrySection String?   @map("entry_section")
  entryPath    String?   @map("entry_path")
  exitedAt     DateTime? @map("exited_at")
  exitSection  String?   @map("exit_section")
  exitPath     String?   @map("exit_path")
  furthestStep Int       @default(0) @map("furthest_step") @db.SmallInt
  sections     Int       @default(0)
  pageViews    Int       @default(0) @map("page_views")
  // The kind of device ("mobile", "tablet", "desktop", "unknown"), read from the browser's own
  // User-Agent on the visit's first batch, and the country (ISO 3166 code) the edge placed that
  // request in; nothing else of either is kept. Null on visits recorded before they were
  // (2026-10-24): `device` is always set from then on, so it also says whether a visit has them.
  device       String?
  country      String?
  // Where the visit came from: one of TRAFFIC_SOURCES (packages/shared/src/traffic.ts), classified by
  // arrivalSource from the first arrival the pixel reports (a referring host, a link's utm_source,
  // utm_medium and click id names; none of them kept). Null: the pixel reported no arrival, as every
  // pixel did before it sent them.
  source       String?

  @@id([storeId, day, visitor])
  @@index([workspaceId])
  // "Returning" visits: the same browser on an earlier day.
  @@index([storeId, visitor, day])
  @@map("funnel_visits")
}

// Which products a visit looked at, added, took to checkout and bought: one row per visit (as in
// funnel_visits) and product.
// `handle` is the product's from its storefront address (/products/<handle>); `steps` bit 0: the
// product page was viewed, bit 1: added to cart from that page, bit 2: added to cart elsewhere (a
// quick add), bit 3: in a checkout the visit started, bit 4: in one it completed. Bits 2-4 only from
// pixels that name the products (packages/shared/src/funnel.ts, productStepsOf).
model FunnelProductVisit {
  workspaceId String @map("workspace_id")
  storeId     String @map("store_id")
  day         String
  visitor     String
  handle      String
  steps       Int    @default(0) @db.SmallInt

  @@id([storeId, day, visitor, handle])
  @@index([workspaceId])
  @@map("funnel_product_visits")
}

// The Shopping Funnel's checklist: a recommended action a member marked as done for a store
// (packages/shared/src/funnel.ts, FUNNEL_ACTIONS). No row: not done.
model FunnelActionCheck {
  workspaceId String   @map("workspace_id")
  storeId     String   @map("store_id")
  actionId    String   @map("action_id")
  doneAt      DateTime @default(now()) @map("done_at")
  // The member who marked it (a user id; kept if they leave).
  doneBy      String?  @map("done_by")

  @@id([storeId, actionId])
  @@index([workspaceId])
  @@map("funnel_action_checks")
}

// A business event the team marked on the Profit sheet (/sheet; packages/shared/src/businessEvents.ts):
// a sale, an ad campaign, a product launch... from one store-local day to another (YYYY-MM-DD, both
// included). The sheet shows it on its days and filters days by it. A note only: no figure is
// worked out from it.
model BusinessEvent {
  id              String   @id @default(cuid())
  workspaceId     String   @map("workspace_id")
  storeId         String   @map("store_id")
  kind            String
  title           String
  startsOn        String   @map("starts_on")
  endsOn          String   @map("ends_on")
  note            String?
  // Who added it and who changed it last (user ids; kept if they leave).
  createdByUserId String?  @map("created_by_user_id")
  updatedByUserId String?  @map("updated_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([storeId, startsOn])
  @@map("business_events")
}

// An ad account (Meta Ads, Google Ads, or a Google AdSense account) connected to a store with
// "Continue with Meta/Google Ads/Google AdSense". One row per account. The token belongs to the
// person who connected: every account they connected in one go shares it, encrypted with the same
// AAD (`ads:<provider>:<storeId>:<kind>`).
model AdConnection {
  id                   String            @id @default(cuid())
  workspaceId          String            @map("workspace_id")
  storeId              String            @map("store_id")
  provider             String // "meta" | "google" | "adsense"
  accountId            String            @map("account_id")
  accountName          String?           @map("account_name")
  currency             String?
  timezone             String?
  /**
   * Google: the manager account the client account is reached through.
   */
  loginCustomerId      String?           @map("login_customer_id")
  /**
   * Shown on the dashboard and synced. Turned off from Settings without losing the connection.
   */
  enabled              Boolean           @default(true)
  /**
   * "active" | "reconnect" (access ended: connect again) | "permission" (this login lost access to
   * this one account; connect with a login that has it) | "unavailable" (the platform won't report on
   * the account: closed, disabled, sign-up unfinished) | "error" (a failure a retry may fix).
   * AD_CONNECTION_STATUSES in @app/shared/ads.
   */
  status               String            @default("active")
  /**
   * Why it isn't active, as a code the UI words (AD_ERROR_CODES in @app/shared/ads); null when active.
   */
  errorCode            String?           @map("error_code")
  /**
   * The platform's own reason, through providerDetail(): for the logs and support, never shown raw.
   */
  lastError            String?           @map("last_error")
  lastSyncedAt         DateTime?         @map("last_synced_at")
  /**
   * The ad account's own health at the platform, normalized (AD_ACCOUNT_STATUSES in @app/shared/ads):
   * Meta's account_status, AdSense's state and pending tasks. Null until read.
   */
  accountStatus        String?           @map("account_status")
  /**
   * What the platform says about that status (Meta's disable reason, AdSense's pending tasks).
   */
  accountStatusDetail  String?           @map("account_status_detail")
  /**
   * AdSense: the sites (DOMAIN_CODE) whose earnings belong to this store; empty = every site.
   */
  sites                String[]          @default([])
  /**
   * The last day (the account's own, YYYY-MM-DD) up to which every day from history_from on is
   * stored without a gap. A sync that leaves a gap after it fetches the gap first.
   */
  syncedThrough        String?           @map("synced_through")
  /**
   * A sync was asked for (connect, Refresh) and hasn't finished yet: the card says "Synchronizing".
   */
  syncRequestedAt      DateTime?         @map("sync_requested_at")
  /**
   * Syncs that failed in a row; reset by one that works. Failing accounts are tried less often.
   */
  consecutiveFailures  Int               @default(0) @map("consecutive_failures")
  /**
   * The first day (the account's own, YYYY-MM-DD) from which every day's figures are stored: the
   * start of the earliest window a sync fetched in full (the first sync fetches 90 days), keeping
   * the earliest; null before any sync worked. The dashboard compares only from then on.
   */
  historyFrom          String?           @map("history_from")
  accessTokenEnc       String            @map("access_token_enc")
  refreshTokenEnc      String?           @map("refresh_token_enc")
  accessTokenExpiresAt DateTime?         @map("access_token_expires_at")
  tokenKeyVersion      Int               @map("token_key_version")
  connectedByUserId    String?           @map("connected_by_user_id")
  /**
   * The platform's id for the person who granted access (Google `sub`, Meta app-scoped user id).
   */
  externalUserId       String?           @map("external_user_id")
  /**
   * The permissions that person granted (checked when connecting).
   */
  grantedScopes        String[]          @default([]) @map("granted_scopes")
  /**
   * A demo connection ("Try demo" on the Google Ads card, docs/ads-demo.md): its figures are generated
   * by bizinsights from demoSeed, never read from Google; it holds no token, and nothing it shows is
   * Google-verified. Added by migration 20261020150000 (the same rules as every other column).
   */
  isDemo               Boolean           @default(false) @map("is_demo")
  demoSeed             Int?              @map("demo_seed")
  /**
   * Who holds the sign-in: "direct" (bizinsights' own) on every row since the connections made through
   * Nango (2026-10-22 to 2026-10-28) were moved off it (docs/ads-setup.md, "Leaving Nango"). Still used:
   * a connect writes "direct", syncs record it (ad_sync_runs.source), and a row with anything else is
   * never read: it waits for a reconnect (adConnections/credentials.ts holdsOwnSignIn).
   * sourceLoginId named the row's Nango connection: read by nothing (a connect writes null), but still
   * selected with every row, so dropping it takes two releases: @ignore first, the DROP migration in a
   * later one (docs/database/migrations.md). Added by migration 20261022120000 (the same rules as every
   * other column).
   */
  source               String            @default("direct")
  sourceLoginId        String?           @map("source_login_id")
  /**
   * When a sync of this account last started, whatever came of it (lastSyncedAt is the last that worked).
   */
  lastSyncAttemptAt    DateTime?         @map("last_sync_attempt_at")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt            DateTime          @updatedAt @map("updated_at")
  campaignDays         AdCampaignDaily[]
  campaigns            AdCampaign[]
  adsenseDays          AdsenseDaily[]
  syncRuns             AdSyncRun[]

  @@unique([storeId, provider, accountId])
  @@index([workspaceId])
  @@index([externalUserId])
  @@map("ad_connections")
}

// A platform sign-in that reaches no ad account yet, kept connected rather than refused (Meta: the
// Facebook login has no ad account, its accounts sit in a business portfolio it isn't assigned to, it
// shared none on Facebook's screen, or Meta didn't list them in time). The card says who is connected;
// the cron tick asks the platform again (adConnections/logins.ts) and connects the login's ad accounts
// once it lists some, and then this row goes. One per store and platform. Added by migration
// 20261026150000 (the same rules as ad_connections: tenant rows); its token by 20261028100000.
model AdLogin {
  id                   String    @id @default(cuid())
  workspaceId          String    @map("workspace_id")
  storeId              String    @map("store_id")
  provider             String // "meta"
  /**
   * The person's token to bizinsights' own app, encrypted like a connection's (logins.ts). A login without one ends at its next check.
   */
  accessTokenEnc       String    @default("") @map("access_token_enc")
  tokenKeyVersion      Int?      @map("token_key_version")
  /**
   * Read by nothing: the Nango connection of a login made through Nango (2026-10-26 to 2026-10-28),
   * emptied when it was moved off it. Still selected with every login, so dropping them takes two
   * releases: @ignore first, the DROP migration in a later one (docs/database/migrations.md).
   */
  sourceLoginId        String?   @map("source_login_id")
  nangoIntegrationKey  String?   @map("nango_integration_key")
  /**
   * The platform's id for the person who signed in (Meta's app-scoped user id), when it was learned.
   */
  externalUserId       String?   @map("external_user_id")
  /**
   * The name the platform's sign-in went by (Meta's profile name), for "Connected as …" on the card.
   */
  loginName            String?   @map("login_name")
  /**
   * The permissions that person granted.
   */
  grantedScopes        String[]  @default([]) @map("granted_scopes")
  accessTokenExpiresAt DateTime? @map("access_token_expires_at")
  connectedByUserId    String?   @map("connected_by_user_id")
  /**
   * Why no ad account is connected yet (AD_LOGIN_REASONS in @app/shared/ads): "no_ads_account" (the login
   * reaches none), "none_shared" (none was ticked on the platform's screen), "unanswered" (the platform
   * didn't list them in time) or "choose" (it lists more than are connected without asking).
   */
  reason               String
  /**
   * When the platform was last asked for the login's ad accounts.
   */
  checkedAt            DateTime  @default(now()) @map("checked_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@unique([storeId, provider])
  @@index([workspaceId])
  @@index([externalUserId])
  @@index([sourceLoginId])
  @@map("ad_logins")
}

// Each sync of one ad account, as it ended: when, what it was asked to fetch and by whom, and what came
// of it. The settings cards show the last few; kept 90 days (pruned by the daily sweep).
model AdSyncRun {
  id           String       @id @default(cuid())
  workspaceId  String       @map("workspace_id")
  storeId      String       @map("store_id")
  connectionId String       @map("connection_id")
  provider     String
  // ad_connections.source when it ran: "direct" (a run from before 2026-10-28 may hold the old value until pruned)
  source       String
  // request | schedule | history (AdsSyncTrigger)
  trigger      String
  /**
   * The days fetched (the account's own), when the sync got that far.
   */
  since        String?
  until        String?
  // synced | skipped | failed
  outcome      String
  rows         Int          @default(0)
  /**
   * A skipped sync's reason, or a failed one's error code (AD_ERROR_CODES in @app/shared/ads).
   */
  reason       String?
  startedAt    DateTime     @map("started_at")
  finishedAt   DateTime     @map("finished_at")
  connection   AdConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, startedAt])
  @@index([workspaceId])
  @@map("ad_sync_runs")
}

// What an ad platform reports for one campaign on one day (the ad account's own calendar day).
model AdCampaignDaily {
  workspaceId     String       @map("workspace_id")
  storeId         String       @map("store_id")
  connectionId    String       @map("connection_id")
  provider        String
  accountId       String       @map("account_id")
  campaignId      String       @map("campaign_id")
  campaignName    String       @map("campaign_name")
  day             String
  spend           Decimal      @default(0) @db.Decimal(18, 2)
  impressions     Int          @default(0)
  /**
   * Every click the platform counts (Meta's "clicks (all)" include likes, comments and profile clicks).
   */
  clicks          Int          @default(0)
  /**
   * Clicks on the ad's link: Meta's inline_link_clicks, Google's clicks. Null until read (rows from before 2026-10-19).
   */
  linkClicks      Int?         @map("link_clicks")
  /**
   * The platform's own conversions: Meta's purchases, Google's every primary conversion action (leads, calls...).
   */
  conversions     Decimal      @default(0) @db.Decimal(18, 2)
  conversionValue Decimal      @default(0) @map("conversion_value") @db.Decimal(18, 2)
  /**
   * Purchases only, as the platform credits them (Google: conversion actions of category PURCHASE). Null until read.
   */
  purchases       Decimal?     @db.Decimal(18, 2)
  purchaseValue   Decimal?     @map("purchase_value") @db.Decimal(18, 2)
  leads           Int          @default(0)
  currency        String?
  updatedAt       DateTime     @updatedAt @map("updated_at")
  connection      AdConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@id([connectionId, campaignId, day])
  @@index([workspaceId])
  @@index([storeId, day])
  @@map("ad_campaign_daily")
}

// A campaign as its platform last described it to a sync: its name and delivery status, for the
// Advertising pages' campaign filters. Its days are in ad_campaign_daily; one row per campaign an
// account's syncs have seen, kept when the campaign stops spending (its status says why).
model AdCampaign {
  workspaceId          String       @map("workspace_id")
  storeId              String       @map("store_id")
  connectionId         String       @map("connection_id")
  provider             String
  accountId            String       @map("account_id")
  campaignId           String       @map("campaign_id")
  name                 String
  /**
   * The platform's own word: Google's campaign.status (ENABLED, PAUSED, REMOVED), Meta's effective_status (ACTIVE, PAUSED, ARCHIVED, WITH_ISSUES...). Null: not read yet.
   */
  status               String?
  /**
   * Google's campaign.advertising_channel_type (SEARCH, SHOPPING, PERFORMANCE_MAX...). Null for Meta, and until read.
   */
  channelType          String?      @map("channel_type")
  /**
   * Google's campaign.primary_status (ELIGIBLE, LIMITED, LEARNING, NOT_ELIGIBLE...): how it serves now. Null for Meta, and until read.
   */
  primaryStatus        String?      @map("primary_status")
  /**
   * Google's campaign.primary_status_reasons (BUDGET_CONSTRAINED...); empty when none, for Meta, and until read.
   */
  primaryStatusReasons String[]     @default([]) @map("primary_status_reasons")
  /**
   * The budget's period as the platform says it: DAILY; Google's CUSTOM_PERIOD (one total over the campaign's own dates); Meta's LIFETIME. Null: none on the campaign (a Meta campaign whose budgets are its ad sets'), or not read.
   */
  budgetPeriod         String?      @map("budget_period")
  /**
   * The budget for that period, in the account's currency.
   */
  budgetAmount         Decimal?     @map("budget_amount") @db.Decimal(18, 2)
  /**
   * When a sync last read the status (and the fields above, when its platform gives them).
   */
  checkedAt            DateTime     @map("checked_at")
  connection           AdConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@id([connectionId, campaignId])
  @@index([workspaceId])
  @@index([storeId])
  @@map("ad_campaigns")
}

// What an AdSense account earned from ads shown on one site on one day (the account's own
// calendar day). Earnings, never spend: kept apart from ad_campaign_daily so the two can't be summed.
model AdsenseDaily {
  workspaceId  String       @map("workspace_id")
  storeId      String       @map("store_id")
  connectionId String       @map("connection_id")
  accountId    String       @map("account_id")
  /**
   * The host the ads were shown on (AdSense DOMAIN_CODE); "" when the report isn't split by site.
   */
  site         String
  day          String
  earnings     Decimal      @default(0) @db.Decimal(18, 2)
  pageViews    Int          @default(0) @map("page_views")
  impressions  Int          @default(0)
  clicks       Int          @default(0)
  currency     String?
  updatedAt    DateTime     @updatedAt @map("updated_at")
  connection   AdConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@id([connectionId, site, day])
  @@index([workspaceId])
  @@index([storeId, day])
  @@map("adsense_daily")
}

// Dedupe table for pixel events (Shopify may redeliver) and sessions.
model PixelEventSeen {
  storeId String   @map("store_id")
  eventId String   @map("event_id")
  seenAt  DateTime @default(now()) @map("seen_at")

  @@id([storeId, eventId])
  @@index([seenAt])
  @@map("pixel_events_seen")
}

model SyncJob {
  id             String    @id @default(cuid())
  workspaceId    String    @map("workspace_id")
  storeId        String    @map("store_id")
  kind           String
  status         JobStatus @default(queued)
  attempts       Int       @default(0)
  progress       Int       @default(0)
  error          String?
  startedAt      DateTime? @map("started_at")
  // Last sign of life from the chain working on the job: its first message, every page or bulk
  // step. startedAt is only stamped once, so on its own it cannot tell a long import from a dead one.
  lastActivityAt DateTime? @map("last_activity_at")
  finishedAt     DateTime? @map("finished_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([storeId, kind])
  // The 15-minute sweep for stalled jobs reads the few that are queued or running.
  @@index([status])
  @@index([workspaceId])
  @@map("sync_jobs")
}

model Alert {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  storeId     String?   @map("store_id")
  severity    String
  code        String
  message     String
  createdAt   DateTime  @default(now()) @map("created_at")
  resolvedAt  DateTime? @map("resolved_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, resolvedAt])
  @@map("alerts")
}

model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  name        String
  prefix      String
  keyHash     String    @unique @map("key_hash")
  createdById String    @map("created_by_id")
  lastUsedAt  DateTime? @map("last_used_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("api_keys")
}

model AuditLog {
  id          String     @id @default(cuid())
  /// Null for a system record that outlives the workspace it was about: a GDPR shop/redact that
  /// erased the store's unclaimed workspace with it (apps/worker/src/handlers/webhooks.ts). RLS shows
  /// such a row to no workspace, and a deleted workspace's own rows still go with it (Cascade).
  workspaceId String?    @map("workspace_id")
  actorUserId String?    @map("actor_user_id")
  action      String
  targetType  String?    @map("target_type")
  targetId    String?    @map("target_id")
  metadata    Json?
  ip          String?
  createdAt   DateTime   @default(now()) @map("created_at")
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("audit_logs")
}

model Subscription {
  workspaceId      String    @id @map("workspace_id")
  plan             String    @default("free")
  status           String    @default("active")
  shopifyChargeId  String?   @map("shopify_charge_id")
  currentPeriodEnd DateTime? @map("current_period_end")
  /// A plan change the merchant has been sent to Shopify to approve. `plan` stays the plan they
  /// actually have until Shopify reports this charge active; a declined or abandoned change
  /// leaves it untouched.
  pendingPlan      String?   @map("pending_plan")
  pendingChargeId  String?   @map("pending_charge_id")
  /// The store whose Shopify bill carries the charges above (Shopify bills an app per store, and
  /// only that store's token can cancel them). Both the charge in force and a pending one live
  /// there: a plan change is always made through it while a charge is in force.
  billingStoreId   String?   @map("billing_store_id")
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  billingStore     Store?    @relation(fields: [billingStoreId], references: [id], onDelete: SetNull)

  @@index([billingStoreId])
  @@map("subscriptions")
}

// ---------------------------------------------------------------------------------------------
// The two earlier WhatsApp designs' tables (whatsapp_*, order_trackings, order_tracking_events,
// abandoned_checkouts, customer_reviews; wa_*) were dropped on 2026-11-12, empty, by migration
// 20261112120000_drop_retired_tables (docs/whatsapp.md, "The old tables"), with email_otps and
// funnel_daily.
// ---------------------------------------------------------------------------------------------

// ---------------------------------------------------------------------------------------------
// WhatsApp Automation on Evolution API (docs/whatsapp.md, 2026-10-26). Each store's connection is
// one instance on bizinsights' own Evolution API service (a phone linked by QR code, or Meta's
// Cloud API). Every table carries workspace_id under the tenant row-level-security policy.
// Customers' numbers, names and message texts are ENCRYPTED (AES-256-GCM, AAD "wapp:<storeId>:<kind>"),
// found by a keyed hash and shown masked; message texts are cleared after the store's retention.
// Instance keys and webhook keys are encrypted too and never leave the server.
// ---------------------------------------------------------------------------------------------

/// A store's WhatsApp connection (one Evolution API instance). One row per store, kept after a disconnect for the history.
model WappConnection {
  id               String    @id @default(cuid())
  workspaceId      String    @map("workspace_id")
  storeId          String    @unique @map("store_id")
  /// qr | cloud_api (WA_PROVIDERS)
  provider         String
  /// WA_CONNECTION_STATUSES: what the provider last reported, never assumed.
  status           String    @default("pairing")
  /// Why it is in that state: Baileys' close code ("close_401"), "qr_limit", "create_failed"... Never a provider's raw answer.
  statusReason     String?   @map("status_reason")
  /// The Evolution API server (shard) that holds the instance.
  shard            String
  /// Evolution's instance name: random, never derived from the tenant; null once the instance is deleted.
  instanceName     String?   @unique @map("instance_name")
  instanceId       String?   @map("instance_id")
  /// The instance's own API key (Evolution's per-instance token; Meta's access token for cloud_api), encrypted.
  instanceTokenEnc String?   @map("instance_token_enc")
  /// The key Evolution signs this instance's webhook JWTs with (HS256), encrypted.
  webhookKeyEnc    String?   @map("webhook_key_enc")
  /// qr | code: how the phone is being paired.
  pairingMethod    String?   @map("pairing_method")
  /// The linked number (the business's own): E.164 encrypted, and masked for the page.
  phoneEnc         String?   @map("phone_enc")
  phoneMasked      String?   @map("phone_masked")
  /// The WhatsApp profile name the provider reports.
  profileName      String?   @map("profile_name")
  /// cloud_api: Meta's WhatsApp Business account, phone number and business portfolio ids.
  wabaId           String?   @map("waba_id")
  phoneNumberId    String?   @unique @map("phone_number_id")
  businessId       String?   @map("business_id")
  /// cloud_api: when Meta's access token expires (Embedded Signup issues 60-day tokens; the sweep renews them).
  tokenExpiresAt   DateTime? @map("token_expires_at")
  /// QR codes the provider has issued in this pairing attempt (it gives up after its limit).
  qrCount          Int       @default(0) @map("qr_count")
  pairingStartedAt DateTime? @map("pairing_started_at")
  connectedAt      DateTime? @map("connected_at")
  disconnectedAt   DateTime? @map("disconnected_at")
  /// The time on the provider's last event about the connection: an older event changes nothing.
  lastEventAt      DateTime? @map("last_event_at")
  /// When bizinsights last asked the provider for the connection's state.
  lastCheckedAt    DateTime? @map("last_checked_at")
  /// Since when it can't send (logged out, reconnecting, failed): waiting messages are cancelled 48 hours after.
  downSince        DateTime? @map("down_since")
  createdByUserId  String?   @map("created_by_user_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([status])
  @@map("wapp_connections")
}

/// The store's WhatsApp choices (Step 3, Configure) and its verified test number (Step 4).
model WappSettings {
  storeId               String    @id @map("store_id")
  workspaceId           String    @map("workspace_id")
  /// What {{store_name}} says (the store's name until it is set).
  businessName          String?   @map("business_name")
  /// unset | opt_in_only | checkout_notice (WA_ORDER_UPDATE_BASES); who chose it and when (also audited).
  orderUpdates          String    @default("unset") @map("order_updates")
  orderUpdatesSetBy     String?   @map("order_updates_set_by")
  orderUpdatesSetAt     DateTime? @map("order_updates_set_at")
  marketingEnabled      Boolean   @default(false) @map("marketing_enabled")
  /// The store says its Shopify text-message marketing consent wording covers WhatsApp too.
  shopifySmsConsent     Boolean   @default(false) @map("shopify_sms_consent")
  /// Store-time hours business-started messages may go out in.
  sendWindowStart       Int       @default(9) @map("send_window_start")
  sendWindowEnd         Int       @default(20) @map("send_window_end")
  /// IANA time zone for the sending hours (null: the store's).
  timeZone              String?   @map("time_zone")
  /// Business-started messages a day (null: the provider's default, WA_DAILY_LIMIT).
  dailyLimit            Int?      @map("daily_limit")
  perCustomerDailyLimit Int       @default(3) @map("per_customer_daily_limit")
  /// Days message texts are kept (then only the record stays).
  retentionDays         Int       @default(90) @map("retention_days")
  /// When the settings were first saved (Step 3 done).
  configuredAt          DateTime? @map("configured_at")
  /// The merchant's own number for tests: keyed hash, encrypted, masked.
  testPhoneHash         String?   @map("test_phone_hash")
  testPhoneEnc          String?   @map("test_phone_enc")
  testPhoneMasked       String?   @map("test_phone_masked")
  /// SHA-256 of the verification code sent to it over WhatsApp, until it is entered or expires.
  testCodeHash          String?   @map("test_code_hash")
  testCodeExpiresAt     DateTime? @map("test_code_expires_at")
  testCodeAttempts      Int       @default(0) @map("test_code_attempts")
  testVerifiedAt        DateTime? @map("test_verified_at")
  /// When a test message to it was reported sent (or further) by the provider (Step 4 done).
  testPassedAt          DateTime? @map("test_passed_at")
  /// "Pause all automation": since when (null: it runs), and who paused it.
  automationPausedAt    DateTime? @map("automation_paused_at")
  automationPausedBy    String?   @map("automation_paused_by")
  updatedByUserId       String?   @map("updated_by_user_id")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@map("wapp_settings")
}

/// A message template written in bizinsights. On cloud_api, Meta's review of it as well.
model WappTemplate {
  id              String    @id @default(cuid())
  workspaceId     String    @map("workspace_id")
  storeId         String    @map("store_id")
  name            String
  /// transactional | marketing
  category        String
  /// The text with {{variables}} (WA_VARIABLES).
  body            String
  active          Boolean   @default(true)
  /// cloud_api: the name and language it was submitted to Meta under, Meta's id, status and reason.
  metaName        String?   @map("meta_name")
  metaLanguage    String?   @map("meta_language")
  metaId          String?   @map("meta_id")
  metaStatus      String?   @map("meta_status")
  metaReason      String?   @map("meta_reason")
  metaCheckedAt   DateTime? @map("meta_checked_at")
  createdByUserId String?   @map("created_by_user_id")
  updatedByUserId String?   @map("updated_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@unique([storeId, name])
  @@index([workspaceId])
  @@map("wapp_templates")
}

/// A customer's WhatsApp number at a store and what they agreed to. Opt-outs stay while the store uses WhatsApp.
model WappContact {
  id                String    @id @default(cuid())
  workspaceId       String    @map("workspace_id")
  storeId           String    @map("store_id")
  /// HMAC(CUSTOMER_HASH_KEY, "wa:<storeId>:<E.164 digits>"): the same hash data requests are recorded with.
  phoneHash         String    @map("phone_hash")
  phoneEnc          String    @map("phone_enc")
  phoneMasked       String    @map("phone_masked")
  country           String?
  firstNameEnc      String?   @map("first_name_enc")
  shopifyCustomerId String?   @map("shopify_customer_id")
  /// Replied STOP (or was opted out): nothing at all is sent.
  optedOut          Boolean   @default(false) @map("opted_out")
  /// Agreed to order updates themselves (START, recorded by the store).
  optedIn           Boolean   @default(false) @map("opted_in")
  /// opted_in | opted_out | unknown
  marketing         String    @default("unknown")
  consentUpdatedAt  DateTime? @map("consent_updated_at")
  lastInboundAt     DateTime? @map("last_inbound_at")
  lastOutboundAt    DateTime? @map("last_outbound_at")
  /// The provider said the number isn't on WhatsApp (and when): not tried again for 30 days.
  notOnWhatsappAt   DateTime? @map("not_on_whatsapp_at")
  /// From Shopify's events (campaign audiences).
  ordersCount       Int       @default(0) @map("orders_count")
  totalSpent        Decimal   @default(0) @map("total_spent") @db.Decimal(18, 2)
  lastOrderAt       DateTime? @map("last_order_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([storeId, phoneHash])
  @@index([storeId, marketing, optedOut])
  @@index([storeId, shopifyCustomerId])
  @@index([workspaceId])
  @@map("wapp_contacts")
}

/// Every change to a customer's consent and where it came from. Append-only.
model WappConsentEvent {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  storeId     String   @map("store_id")
  contactId   String   @map("contact_id")
  /// all | order_updates | marketing
  scope       String
  /// opted_in | opted_out
  status      String
  /// WA_CONSENT_SOURCES
  source      String
  actorUserId String?  @map("actor_user_id")
  note        String?
  occurredAt  DateTime @map("occurred_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([contactId, occurredAt])
  @@index([storeId, createdAt])
  @@index([workspaceId])
  @@map("wapp_consent_events")
}

/// Numbers the store must not message: everything (all) or marketing only.
model WappSuppression {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  storeId     String   @map("store_id")
  phoneHash   String   @map("phone_hash")
  phoneMasked String   @map("phone_masked")
  /// all | marketing
  scope       String
  /// stop_reply | merchant | invalid_number | redact
  reason      String
  note        String?
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([storeId, phoneHash, scope])
  @@index([workspaceId])
  @@map("wapp_suppressions")
}

/// Every WhatsApp message, sent and received: the queue and the history. A campaign's recipients are its messages.
model WappMessage {
  id                String    @id @default(cuid())
  workspaceId       String    @map("workspace_id")
  storeId           String    @map("store_id")
  connectionId      String?   @map("connection_id")
  provider          String?
  /// out | in
  direction         String    @default("out")
  contactId         String?   @map("contact_id")
  phoneHash         String?   @map("phone_hash")
  phoneEnc          String?   @map("phone_enc")
  phoneMasked       String?   @map("phone_masked")
  /// automation | campaign | manual | test | verification | team_alert | inbound
  source            String
  automationId      String?   @map("automation_id")
  runId             String?   @map("run_id")
  campaignId        String?   @map("campaign_id")
  /// One message per purpose and store: "auto:<automation>:<subject>", "campaign:<id>:<contact>", "manual:<key>"...
  idempotencyKey    String?   @map("idempotency_key")
  /// transactional | marketing
  category          String?
  /// text | image | document (out); the provider's type (in)
  type              String
  templateId        String?   @map("template_id")
  /// What the send needs (text, an attachment's blob key), encrypted; cleared once the message is final.
  payloadEnc        String?   @map("payload_enc")
  /// What the customer reads (or wrote), encrypted, for the history; cleared after the store's retention.
  previewEnc        String?   @map("preview_enc")
  /// WA_MESSAGE_STATUSES
  status            String    @default("queued")
  /// WA_SKIP_REASONS (why skipped, cancelled, held or failed).
  reason            String?
  sendAfter         DateTime  @default(now()) @map("send_after")
  enqueuedAt        DateTime? @map("enqueued_at")
  attempts          Int       @default(0)
  /// The provider's id for it (WhatsApp's message key id; Meta's wamid on cloud_api).
  providerMessageId String?   @map("provider_message_id")
  errorCode         String?   @map("error_code")
  /// The provider's reason, cleaned for the merchant (providerDetail).
  errorDetail       String?   @map("error_detail")
  acceptedAt        DateTime? @map("accepted_at")
  sentAt            DateTime? @map("sent_at")
  deliveredAt       DateTime? @map("delivered_at")
  readAt            DateTime? @map("read_at")
  failedAt          DateTime? @map("failed_at")
  finalAt           DateTime? @map("final_at")
  createdByUserId   String?   @map("created_by_user_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([storeId, idempotencyKey])
  @@unique([connectionId, providerMessageId])
  @@index([status, sendAfter])
  @@index([storeId, createdAt])
  @@index([storeId, direction, acceptedAt])
  @@index([campaignId, status])
  @@index([automationId, createdAt])
  @@index([contactId, createdAt])
  @@index([workspaceId])
  @@map("wapp_messages")
}

/// The provider's reports about a message, once per message and status.
model WappMessageEvent {
  id             String   @id @default(cuid())
  workspaceId    String   @map("workspace_id")
  storeId        String   @map("store_id")
  messageId      String   @map("message_id")
  status         String
  /// The provider's own word (SERVER_ACK, DELIVERY_ACK, READ...).
  providerStatus String?  @map("provider_status")
  occurredAt     DateTime @map("occurred_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([messageId, status])
  @@index([storeId])
  @@index([workspaceId])
  @@map("wapp_message_events")
}

/// Evolution API's webhook deliveries, as received (JWT checked), until applied. Its retries are stored once.
model WappWebhookEvent {
  id           String    @id @default(cuid())
  workspaceId  String    @map("workspace_id")
  storeId      String    @map("store_id")
  connectionId String    @map("connection_id")
  /// CONNECTION_UPDATE, MESSAGES_UPSERT, MESSAGES_UPDATE... (Evolution's event name, upper-cased)
  event        String
  /// SHA-256 of the raw body.
  bodyHash     String    @unique @map("body_hash")
  /// The body, encrypted (it carries customers' numbers and messages); cleared once applied.
  bodyEnc      String?   @map("body_enc")
  /// pending | processed | ignored | dead
  status       String    @default("pending")
  attempts     Int       @default(0)
  lastError    String?   @map("last_error")
  /// The provider's own time on the event.
  providerAt   DateTime? @map("provider_at")
  receivedAt   DateTime  @default(now()) @map("received_at")
  enqueuedAt   DateTime? @map("enqueued_at")
  processedAt  DateTime? @map("processed_at")

  @@index([status, receivedAt])
  @@index([connectionId, receivedAt])
  @@index([workspaceId])
  @@map("wapp_webhook_events")
}

/// An automation: trigger -> conditions -> template -> recipient and timing.
model WappAutomation {
  id              String    @id @default(cuid())
  workspaceId     String    @map("workspace_id")
  storeId         String    @map("store_id")
  name            String
  description     String?
  /// WA_TRIGGERS
  trigger         String
  conditions      Json      @default("[]")
  templateId      String    @map("template_id")
  /// customer | shipping_address | billing_address
  recipient       String    @default("customer")
  delayMinutes    Int       @default(0) @map("delay_minutes")
  /// Its own sending hours (null: the store's).
  sendWindowStart Int?      @map("send_window_start")
  sendWindowEnd   Int?      @map("send_window_end")
  /// Every message goes to the store's verified test number instead of the customer.
  testMode        Boolean   @default(true) @map("test_mode")
  /// message_received: the same customer gets the reply at most once in this many minutes.
  cooldownMinutes Int?      @map("cooldown_minutes")
  /// draft | active | paused
  status          String    @default("draft")
  /// Goes up with every save: a message waiting from an older version checks the automation again.
  version         Int       @default(1)
  createdByUserId String?   @map("created_by_user_id")
  updatedByUserId String?   @map("updated_by_user_id")
  activatedAt     DateTime? @map("activated_at")
  lastRunAt       DateTime? @map("last_run_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([storeId, trigger, status])
  @@index([workspaceId])
  @@map("wapp_automations")
}

/// Each time an automation's trigger fired: at most once per automation and order, checkout, customer or message.
model WappAutomationRun {
  id                String   @id @default(cuid())
  workspaceId       String   @map("workspace_id")
  storeId           String   @map("store_id")
  automationId      String   @map("automation_id")
  automationVersion Int      @map("automation_version")
  trigger           String
  /// "order:<id>", "checkout:<token>", "customer:<id>", "inbound:<contact>:<window>", "test:<id>"
  subjectKey        String   @map("subject_key")
  /// What the merchant recognises: "Order #1042", "Checkout", "Message from +61 •••• 678".
  subjectLabel      String?  @map("subject_label")
  /// queued | skipped
  outcome           String
  reason            String?
  /// The failed conditions or missing values, for the history.
  detail            String?
  messageId         String?  @map("message_id")
  contactId         String?  @map("contact_id")
  testMode          Boolean  @default(false) @map("test_mode")
  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([automationId, subjectKey])
  @@index([storeId, createdAt])
  @@index([automationId, createdAt])
  @@index([workspaceId])
  @@map("wapp_automation_runs")
}

/// A campaign: a marketing template to an audience of opted-in customers, now or later, after the merchant confirms the count.
model WappCampaign {
  id                  String    @id @default(cuid())
  workspaceId         String    @map("workspace_id")
  storeId             String    @map("store_id")
  name                String
  templateId          String    @map("template_id")
  audience            Json
  /// draft | scheduled | sending | completed | cancelled
  status              String    @default("draft")
  scheduledAt         DateTime? @map("scheduled_at")
  /// The count the merchant confirmed when launching, and how many messages were made.
  confirmedRecipients Int?      @map("confirmed_recipients")
  recipients          Int       @default(0)
  /// The last contact id given a message (recipients are made in batches).
  cursor              String?
  materializedAt      DateTime? @map("materialized_at")
  startedAt           DateTime? @map("started_at")
  completedAt         DateTime? @map("completed_at")
  cancelledAt         DateTime? @map("cancelled_at")
  cancelReason        String?   @map("cancel_reason")
  createdByUserId     String?   @map("created_by_user_id")
  launchedByUserId    String?   @map("launched_by_user_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([storeId, status])
  @@index([status, scheduledAt])
  @@index([workspaceId])
  @@map("wapp_campaigns")
}

// ---------------------------------------------------------------------------------------------
// Staff Management, Time & Attendance and Payroll (docs/staff.md).
//
// Every table carries workspace_id (the organization) and has the tenant_isolation RLS policy.
// Money is integer minor units (bigint, `*_minor`) in the row's `currency`; rates and multipliers
// are fixed-point decimals. Instants are UTC timestamps written by the server; "days"
// (YYYY-MM-DD) are the organization's local calendar days. Partial unique indexes that Prisma
// cannot express (one open shift per employee, one open break per shift, one live invitation per
// employee) live in the migration SQL.
// ---------------------------------------------------------------------------------------------

/// Organization-level payroll settings (organization_payroll_settings). One row per workspace.
model StaffSettings {
  workspaceId              String    @id @map("workspace_id")
  /// IANA zone every "day", "week" and "hour" in staff reports is counted in.
  timezone                 String    @default("UTC")
  currency                 String    @default("USD")
  /// daily | weekly | biweekly | semimonthly | monthly
  payCycle                 String    @default("weekly") @map("pay_cycle")
  /// A day that starts a weekly or two-weekly period.
  payCycleAnchor           String    @default("2026-01-05") @map("pay_cycle_anchor")
  /// 0 = Sunday ... 6 = Saturday.
  weekStartsOn             Int       @default(1) @map("week_starts_on")
  invitationExpiryHours    Int       @default(48) @map("invitation_expiry_hours")
  /// An open shift older than this is flagged "forgot to clock out?" and stops adding paid time.
  staleSessionHours        Int       @default(14) @map("stale_session_hours")
  lateGraceMinutes         Int       @default(5) @map("late_grace_minutes")
  /// Hours must be approved before payroll can include them.
  requireApproval          Boolean   @default(true) @map("require_approval")
  allowEmployeeCorrections Boolean   @default(true) @map("allow_employee_corrections")
  /// Free-text region label (e.g. "AU-NSW"), shown on payslips. No statutory rules are applied.
  jurisdiction             String?
  supportEmail             String?   @map("support_email")
  defaultOvertimePolicyId  String?   @map("default_overtime_policy_id")
  defaultBreakPolicyId     String?   @map("default_break_policy_id")
  nextEmployeeNumber       Int       @default(1) @map("next_employee_number")
  updatedByUserId          String?   @map("updated_by_user_id")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")
  workspace                Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("organization_payroll_settings")
}

model Department {
  id          String     @id @default(cuid())
  workspaceId String     @map("workspace_id")
  name        String
  createdAt   DateTime   @default(now()) @map("created_at")
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  employees   Employee[]

  @@unique([workspaceId, name])
  @@map("departments")
}

/// Overtime rules. Thresholds in minutes; null switches a rule off. Multipliers like 1.5.
model OvertimePolicy {
  id                              String     @id @default(cuid())
  workspaceId                     String     @map("workspace_id")
  name                            String
  dailyThresholdMinutes           Int?       @map("daily_threshold_minutes")
  weeklyThresholdMinutes          Int?       @map("weekly_threshold_minutes")
  multiplier                      Decimal    @default(1.5) @db.Decimal(8, 4)
  doubleTimeDailyThresholdMinutes Int?       @map("double_time_daily_threshold_minutes")
  doubleTimeMultiplier            Decimal?   @map("double_time_multiplier") @db.Decimal(8, 4)
  holidayMultiplier               Decimal    @default(1) @map("holiday_multiplier") @db.Decimal(8, 4)
  createdAt                       DateTime   @default(now()) @map("created_at")
  updatedAt                       DateTime   @updatedAt @map("updated_at")
  workspace                       Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  employees                       Employee[]

  @@unique([workspaceId, name])
  @@map("overtime_policies")
}

/// Which breaks are paid and what counts as too many or too long (flagged for review, never blocked mid-shift).
model BreakPolicy {
  id                String     @id @default(cuid())
  workspaceId       String     @map("workspace_id")
  name              String
  restBreaksPaid    Boolean    @default(true) @map("rest_breaks_paid")
  mealBreaksPaid    Boolean    @default(false) @map("meal_breaks_paid")
  maxBreaksPerShift Int?       @map("max_breaks_per_shift")
  maxBreakMinutes   Int?       @map("max_break_minutes")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  workspace         Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  employees         Employee[]

  @@unique([workspaceId, name])
  @@map("break_policies")
}

/// A public holiday: no one is "absent" on it, and work on it earns the holiday multiplier.
model StaffHoliday {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  day         String
  name        String
  createdAt   DateTime  @default(now()) @map("created_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, day])
  @@map("staff_holidays")
}

model Employee {
  id                    String                @id @default(cuid())
  workspaceId           String                @map("workspace_id")
  /// "EMP-0001": generated, unique within the organization.
  employeeNumber        String                @map("employee_number")
  fullName              String                @map("full_name")
  email                 String
  phone                 String?
  jobTitle              String                @map("job_title")
  departmentId          String?               @map("department_id")
  /// full_time | part_time | casual | contract
  employmentType        String                @map("employment_type")
  joinedOn              String                @map("joined_on")
  currency              String
  standardWeeklyMinutes Int                   @default(2400) @map("standard_weekly_minutes")
  /// Regular working days, 0 = Sunday.
  workingDays           Int[]                 @default([1, 2, 3, 4, 5]) @map("working_days")
  managerUserId         String?               @map("manager_user_id")
  overtimePolicyId      String?               @map("overtime_policy_id")
  breakPolicyId         String?               @map("break_policy_id")
  timezone              String
  /// active | on_leave | inactive (deactivated)
  status                String                @default("active")
  notes                 String?
  /// The sign-in account (employee_auth_links): set when the invitation is accepted.
  userId                String?               @map("user_id")
  accountLinkedAt       DateTime?             @map("account_linked_at")
  deactivatedAt         DateTime?             @map("deactivated_at")
  deactivatedByUserId   String?               @map("deactivated_by_user_id")
  deactivationReason    String?               @map("deactivation_reason")
  createdByUserId       String?               @map("created_by_user_id")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  workspace             Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  department            Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  user                  User?                 @relation("EmployeeAccount", fields: [userId], references: [id], onDelete: SetNull)
  manager               User?                 @relation("EmployeeManager", fields: [managerUserId], references: [id], onDelete: SetNull)
  overtimePolicy        OvertimePolicy?       @relation(fields: [overtimePolicyId], references: [id], onDelete: SetNull)
  breakPolicy           BreakPolicy?          @relation(fields: [breakPolicyId], references: [id], onDelete: SetNull)
  invitations           EmployeeInvitation[]
  payRates              PayRate[]
  schedules             ShiftSchedule[]
  sessions              AttendanceSession[]
  events                AttendanceEvent[]
  adjustments           TimesheetAdjustment[]
  payrollItems          PayrollItem[]
  payrollAdjustments    PayrollAdjustment[]
  payments              PayrollPayment[]

  @@unique([workspaceId, employeeNumber])
  @@unique([workspaceId, email])
  @@unique([workspaceId, userId])
  @@index([workspaceId, status])
  @@index([userId])
  @@index([managerUserId])
  @@map("employees")
}

/// A single-use invitation to create the employee's account. Only the token's SHA-256 is stored.
model EmployeeInvitation {
  id              String    @id @default(cuid())
  workspaceId     String    @map("workspace_id")
  employeeId      String    @map("employee_id")
  email           String
  tokenHash       String    @unique @map("token_hash")
  expiresAt       DateTime  @map("expires_at")
  /// Sent by email (opening it proves the inbox) vs. a link copied by an admin (the account then
  /// has to verify its email before it can be used).
  emailed         Boolean   @default(false)
  linkRevealed    Boolean   @default(false) @map("link_revealed")
  emailError      String?   @map("email_error")
  acceptedAt      DateTime? @map("accepted_at")
  acceptedUserId  String?   @map("accepted_user_id")
  revokedAt       DateTime? @map("revoked_at")
  revokedByUserId String?   @map("revoked_by_user_id")
  createdByUserId String?   @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([employeeId])
  @@map("employee_invitations")
}

/// Effective-dated hourly rates (pay_rate_history): a rate applies from its local day until the next.
model PayRate {
  id              String   @id @default(cuid())
  workspaceId     String   @map("workspace_id")
  employeeId      String   @map("employee_id")
  hourlyRate      Decimal  @map("hourly_rate") @db.Decimal(14, 4)
  currency        String
  effectiveFrom   String   @map("effective_from")
  reason          String?
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, effectiveFrom])
  @@index([workspaceId])
  @@map("pay_rate_history")
}

model ShiftSchedule {
  id              String              @id @default(cuid())
  workspaceId     String              @map("workspace_id")
  employeeId      String              @map("employee_id")
  startsAt        DateTime            @map("starts_at")
  endsAt          DateTime            @map("ends_at")
  /// Planned unpaid break, for the schedule's expected hours only.
  breakMinutes    Int                 @default(0) @map("break_minutes")
  location        String?
  note            String?
  createdByUserId String?             @map("created_by_user_id")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  employee        Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  sessions        AttendanceSession[]

  @@index([workspaceId, startsAt])
  @@index([employeeId, startsAt])
  @@map("shift_schedules")
}

/// One shift: clock-in to clock-out. At most one open (clock_out_at IS NULL) per employee.
model AttendanceSession {
  id               String                @id @default(cuid())
  workspaceId      String                @map("workspace_id")
  employeeId       String                @map("employee_id")
  scheduleId       String?               @map("schedule_id")
  clockInAt        DateTime              @map("clock_in_at")
  clockOutAt       DateTime?             @map("clock_out_at")
  /// web | mobile | admin | system
  clockInSource    String                @map("clock_in_source")
  clockOutSource   String?               @map("clock_out_source")
  /// The employee's zone at clock-in (display only; pay rules use the organization's zone).
  timezone         String
  /// pending | approved | rejected
  approvalStatus   String                @default("pending") @map("approval_status")
  approvedAt       DateTime?             @map("approved_at")
  approvedByUserId String?               @map("approved_by_user_id")
  rejectedReason   String?               @map("rejected_reason")
  /// late, early_departure, unscheduled, overnight, stale, long_break, ... (attendance.ts)
  flags            String[]              @default([])
  /// Bumped by every correction; the before/after of each is in attendance_events.
  revision         Int                   @default(0)
  /// Set once an approved payroll includes this shift: it cannot be changed after that.
  lockedAt         DateTime?             @map("locked_at")
  note             String?
  staleAlertedAt   DateTime?             @map("stale_alerted_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  employee         Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  schedule         ShiftSchedule?        @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  breaks           BreakSession[]
  events           AttendanceEvent[]
  adjustments      TimesheetAdjustment[]
  approvals        TimesheetApproval[]

  @@index([workspaceId, clockInAt])
  @@index([employeeId, clockInAt])
  @@index([workspaceId, approvalStatus])
  @@map("attendance_sessions")
}

model BreakSession {
  id          String            @id @default(cuid())
  workspaceId String            @map("workspace_id")
  sessionId   String            @map("session_id")
  employeeId  String            @map("employee_id")
  startAt     DateTime          @map("start_at")
  endAt       DateTime?         @map("end_at")
  /// rest | meal
  kind        String
  /// Whether the break policy paid this kind of break when it started.
  paid        Boolean
  createdAt   DateTime          @default(now()) @map("created_at")
  session     AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([workspaceId])
  @@map("break_sessions")
}

/// Append-only record of every clock action and correction, with what the device claimed.
model AttendanceEvent {
  id             String             @id @default(cuid())
  workspaceId    String             @map("workspace_id")
  employeeId     String             @map("employee_id")
  sessionId      String?            @map("session_id")
  /// clock_in | clock_out | break_start | break_end | correction | manual_entry | approval | rejection | reopen | auto_flag | deactivation_close
  type           String
  /// Server time of the action (authoritative).
  at             DateTime
  /// What the device said the time was (audit only, never used for pay).
  clientTime     DateTime?          @map("client_time")
  clientTimezone String?            @map("client_timezone")
  source         String
  actorUserId    String?            @map("actor_user_id")
  /// The client's Idempotency-Key: a retried request finds this row instead of acting twice.
  idempotencyKey String?            @map("idempotency_key")
  ip             String?
  userAgent      String?            @map("user_agent")
  before         Json?
  after          Json?
  note           String?
  createdAt      DateTime           @default(now()) @map("created_at")
  employee       Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  session        AttendanceSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([employeeId, idempotencyKey])
  @@index([sessionId])
  @@index([workspaceId, at])
  @@map("attendance_events")
}

/// A requested or applied change to a shift (or a missing shift to add).
model TimesheetAdjustment {
  id                 String             @id @default(cuid())
  workspaceId        String             @map("workspace_id")
  employeeId         String             @map("employee_id")
  /// Null: add a shift that was never clocked.
  sessionId          String?            @map("session_id")
  requestedByUserId  String?            @map("requested_by_user_id")
  /// The employee asked (else a manager made it directly).
  byEmployee         Boolean            @default(false) @map("by_employee")
  proposedClockInAt  DateTime?          @map("proposed_clock_in_at")
  proposedClockOutAt DateTime?          @map("proposed_clock_out_at")
  /// [{ startAt, endAt, kind }] replacing the shift's breaks, when given.
  proposedBreaks     Json?              @map("proposed_breaks")
  reason             String
  /// pending | approved | rejected | cancelled
  status             String             @default("pending")
  decidedByUserId    String?            @map("decided_by_user_id")
  decidedAt          DateTime?          @map("decided_at")
  decisionNote       String?            @map("decision_note")
  createdAt          DateTime           @default(now()) @map("created_at")
  employee           Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  session            AttendanceSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([employeeId])
  @@map("timesheet_adjustments")
}

/// Each approve / reject / reopen of a shift's hours.
model TimesheetApproval {
  id          String            @id @default(cuid())
  workspaceId String            @map("workspace_id")
  sessionId   String            @map("session_id")
  /// approved | rejected | reopened
  action      String
  revision    Int
  actorUserId String?           @map("actor_user_id")
  note        String?
  createdAt   DateTime          @default(now()) @map("created_at")
  session     AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([workspaceId])
  @@map("timesheet_approvals")
}

model PayrollPeriod {
  id                 String              @id @default(cuid())
  workspaceId        String              @map("workspace_id")
  startDate          String              @map("start_date")
  endDate            String              @map("end_date")
  payCycle           String              @map("pay_cycle")
  payDate            String?             @map("pay_date")
  /// draft | pending_approval | approved | partially_paid | paid | cancelled | correction_required | payment_failed | reversed
  status             String              @default("draft")
  timezone           String
  /// Bumped by every calculation; approval names the version that was reviewed.
  version            Int                 @default(0)
  calculatedAt       DateTime?           @map("calculated_at")
  calculatedByUserId String?             @map("calculated_by_user_id")
  submittedAt        DateTime?           @map("submitted_at")
  submittedByUserId  String?             @map("submitted_by_user_id")
  approvedAt         DateTime?           @map("approved_at")
  approvedByUserId   String?             @map("approved_by_user_id")
  lockedAt           DateTime?           @map("locked_at")
  cancelledAt        DateTime?           @map("cancelled_at")
  notes              String?
  createdByUserId    String?             @map("created_by_user_id")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items              PayrollItem[]
  adjustments        PayrollAdjustment[]
  approvals          PayrollApproval[]

  @@index([workspaceId, startDate])
  @@map("payroll_periods")
}

/// One employee's pay for one period. Frozen (with its line breakdown) once the period is approved.
model PayrollItem {
  id                 String              @id @default(cuid())
  workspaceId        String              @map("workspace_id")
  periodId           String              @map("period_id")
  employeeId         String              @map("employee_id")
  currency           String
  regularSeconds     Int                 @default(0) @map("regular_seconds")
  overtimeSeconds    Int                 @default(0) @map("overtime_seconds")
  doubleTimeSeconds  Int                 @default(0) @map("double_time_seconds")
  holidaySeconds     Int                 @default(0) @map("holiday_seconds")
  paidBreakSeconds   Int                 @default(0) @map("paid_break_seconds")
  unpaidBreakSeconds Int                 @default(0) @map("unpaid_break_seconds")
  unpricedSeconds    Int                 @default(0) @map("unpriced_seconds")
  grossMinor         BigInt              @default(0) @map("gross_minor")
  otherEarningsMinor BigInt              @default(0) @map("other_earnings_minor")
  deductionsMinor    BigInt              @default(0) @map("deductions_minor")
  /// gross + other earnings - deductions. An estimate: no statutory tax is calculated.
  netMinor           BigInt              @default(0) @map("net_minor")
  /// Sum of this item's allocations from completed payments (kept in the same transaction).
  paidMinor          BigInt              @default(0) @map("paid_minor")
  /// [{ category, hourlyRate, multiplier, seconds, amountMinor }]
  lines              Json                @default("[]")
  /// The shifts (and their revisions) the figures were calculated from.
  sessions           Json                @default("[]")
  warnings           String[]            @default([])
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  period             PayrollPeriod       @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employee           Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  allocations        PaymentAllocation[]

  @@unique([periodId, employeeId])
  @@index([workspaceId])
  @@index([employeeId])
  @@map("payroll_items")
}

/// An authorized earning (bonus, allowance) or deduction added to an employee's pay for a period.
model PayrollAdjustment {
  id              String        @id @default(cuid())
  workspaceId     String        @map("workspace_id")
  periodId        String        @map("period_id")
  employeeId      String        @map("employee_id")
  /// earning | deduction
  kind            String
  label           String
  amountMinor     BigInt        @map("amount_minor")
  reason          String?
  createdByUserId String?       @map("created_by_user_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  removedAt       DateTime?     @map("removed_at")
  removedByUserId String?       @map("removed_by_user_id")
  period          PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([periodId])
  @@index([workspaceId])
  @@map("payroll_adjustments")
}

/// Every step of a period's approval workflow.
model PayrollApproval {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  periodId    String        @map("period_id")
  /// calculated | submitted | approved | rejected | cancelled | reversed
  action      String
  version     Int
  actorUserId String?       @map("actor_user_id")
  comment     String?
  createdAt   DateTime      @default(now()) @map("created_at")
  period      PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@index([periodId])
  @@index([workspaceId])
  @@map("payroll_approvals")
}

/// A record that an employee was paid (bank transfer, cash, ...). Recording is not transferring:
/// no money moves through bizinsights.
model PayrollPayment {
  id                    String              @id @default(cuid())
  workspaceId           String              @map("workspace_id")
  employeeId            String              @map("employee_id")
  currency              String
  amountMinor           BigInt              @map("amount_minor")
  paidOn                String              @map("paid_on")
  /// bank_transfer | cash | cheque | external_provider | other
  method                String
  reference             String?
  remarks               String?
  /// completed | failed | reversed
  status                String              @default("completed")
  /// The client's Idempotency-Key: the same form submitted twice records one payment.
  idempotencyKey        String              @map("idempotency_key")
  recordedByUserId      String?             @map("recorded_by_user_id")
  failedAt              DateTime?           @map("failed_at")
  reversedAt            DateTime?           @map("reversed_at")
  statusChangedByUserId String?             @map("status_changed_by_user_id")
  statusReason          String?             @map("status_reason")
  createdAt             DateTime            @default(now()) @map("created_at")
  employee              Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  allocations           PaymentAllocation[]

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, paidOn])
  @@index([employeeId])
  @@map("payroll_payments")
}

/// Which pay item(s) a payment settles, and how much of each.
model PaymentAllocation {
  id            String         @id @default(cuid())
  workspaceId   String         @map("workspace_id")
  paymentId     String         @map("payment_id")
  payrollItemId String         @map("payroll_item_id")
  amountMinor   BigInt         @map("amount_minor")
  createdAt     DateTime       @default(now()) @map("created_at")
  payment       PayrollPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  item          PayrollItem    @relation(fields: [payrollItemId], references: [id], onDelete: Cascade)

  @@unique([paymentId, payrollItemId])
  @@index([payrollItemId])
  @@index([workspaceId])
  @@map("payment_allocations")
}

/// A customer's request, through Shopify, for the data bizinsights holds about them (the mandatory
/// customers/data_request webhook). Shopify asks the app to give that data to the store owner, so
/// the owner downloads it from Settings → Privacy requests: the export is compiled from the live
/// records when they do (packages/core/src/privacy.ts), and this row keeps only what identifies
/// the customer, as the same keyed hashes the records carry, never their email or number.
model DataRequest {
  id               String    @id @default(cuid())
  workspaceId      String    @map("workspace_id")
  storeId          String    @map("store_id")
  /// Shopify's id for the request (data_request.id); a redelivery records nothing new.
  shopifyRequestId String    @map("shopify_request_id")
  /// The Shopify customer id, as Shopify sent it.
  customerId       String?   @map("customer_id")
  /// orders.customer_key for this customer.
  customerKey      String?   @map("customer_key")
  /// wapp_contacts.phone_hash for the number Shopify sent.
  phoneHash        String?   @map("phone_hash")
  /// Shopify order ids the request names.
  ordersRequested  String[]  @default([]) @map("orders_requested")
  receivedAt       DateTime  @default(now()) @map("received_at")
  /// When someone in the workspace last downloaded the export.
  downloadedAt     DateTime? @map("downloaded_at")
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([storeId, shopifyRequestId])
  @@index([workspaceId, receivedAt])
  @@map("data_requests")
}

// ---------------------------------------------------------------------------------------------------
// Zapier (docs/zapier.md): the "bizinsights" app on Zapier's Developer Platform. bizinsights is the
// OAuth provider: a member who may manage integrations allows Zapier to reach one store, and Zapier
// subscribes REST hooks for its triggers. No Prisma relation to users, workspaces or stores: like
// ad_connections, the rows are removed by the code that removes those (member removal, account
// deletion, store purge). Added by migration 20261028120000_zapier_integration.
// ---------------------------------------------------------------------------------------------------

/// One "Connect bizinsights" in a merchant's Zapier account: Zapier may reach this store, for as long as
/// the member who allowed it may manage its integrations (checked on every request and delivery).
model ZapierGrant {
  id            String        @id @default(cuid())
  workspaceId   String        @map("workspace_id")
  storeId       String        @map("store_id")
  /// The member who allowed it on bizinsights' consent page (/connect/zapier).
  userId        String        @map("user_id")
  /// The OAuth client it was issued to (ZAPIER_CLIENT_ID at the time).
  clientId      String        @map("client_id")
  /// What it may do beyond triggers and searches, as ticked on the consent page: whatsapp_send.
  scopes        String[]      @default([])
  /// The last request Zapier made with it (at most once a minute).
  lastUsedAt    DateTime?     @map("last_used_at")
  revokedAt     DateTime?     @map("revoked_at")
  /// disconnected | member_removed | account_deleted | account_taken_over | store_erased | refresh_token_reused | code_reused
  revokedReason String?       @map("revoked_reason")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  tokens        ZapierToken[]
  hooks         ZapierHook[]

  @@index([workspaceId])
  @@index([storeId])
  @@index([userId])
  @@map("zapier_grants")
}

/// A grant's access and refresh tokens, as SHA-256 hashes only: the tokens themselves are never kept.
model ZapierToken {
  id          String      @id @default(cuid())
  workspaceId String      @map("workspace_id")
  grantId     String      @map("grant_id")
  /// access | refresh
  kind        String
  tokenHash   String      @unique @map("token_hash")
  expiresAt   DateTime    @map("expires_at")
  /// A refresh token: when it was exchanged. Presented again after the grace period, it revokes the whole grant.
  usedAt      DateTime?   @map("used_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  grant       ZapierGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([grantId])
  @@index([workspaceId])
  @@index([expiresAt])
  @@map("zapier_tokens")
}

/// A Zap's trigger, subscribed by Zapier (REST hook): where the trigger's events are posted.
model ZapierHook {
  id              String           @id @default(cuid())
  workspaceId     String           @map("workspace_id")
  storeId         String           @map("store_id")
  grantId         String           @map("grant_id")
  /// ZAPIER_EVENTS in @app/shared/zapier
  event           String
  /// Zapier's subscription URL, always https://hooks.zapier.com/hooks/... (isZapierHookUrl).
  targetUrl       String           @map("target_url")
  /// The trigger's own fields as checked when it was made (thresholds: platform, period, amount).
  inputs          Json             @default("{}")
  /// Zapier's id for the Zap, when it sends one (for support).
  zapId           String?          @map("zap_id")
  lastDeliveredAt DateTime?        @map("last_delivered_at")
  /// Thresholds: when the store's figures were last checked against it, and why they couldn't be (mixed currencies).
  checkedAt       DateTime?        @map("checked_at")
  checkNote       String?          @map("check_note")
  createdAt       DateTime         @default(now()) @map("created_at")
  grant           ZapierGrant      @relation(fields: [grantId], references: [id], onDelete: Cascade)
  deliveries      ZapierDelivery[]

  @@index([storeId, event])
  @@index([grantId])
  @@index([workspaceId])
  @@map("zapier_hooks")
}

/// The outbox: one row per thing that happened, written where it happened, delivered by the worker.
/// Kept 30 days (the cron sweep), which is also what a trigger's samples come from.
model ZapierEvent {
  id          String           @id @default(cuid())
  workspaceId String           @map("workspace_id")
  storeId     String           @map("store_id")
  event       String
  /// An event meant for one trigger only (a threshold crossed for that trigger's amount).
  hookId      String?          @map("hook_id")
  /// One row per happening: a retried job or a repeated alert can't make a second.
  dedupeKey   String           @unique @map("dedupe_key")
  /// What Zapier receives, before the per-person redaction at delivery.
  payload     Json
  createdAt   DateTime         @default(now()) @map("created_at")
  deliveries  ZapierDelivery[]

  @@index([storeId, event, createdAt])
  @@index([createdAt])
  @@index([workspaceId])
  @@map("zapier_events")
}

/// One event for one Zap's trigger: its attempts and outcome (Settings → Integrations shows the last ones).
model ZapierDelivery {
  id             String      @id @default(cuid())
  workspaceId    String      @map("workspace_id")
  storeId        String      @map("store_id")
  eventId        String      @map("event_id")
  /// Null once the trigger is gone (unsubscribed, a 410 from Zapier, a disconnect): the record stays.
  hookId         String?     @map("hook_id")
  event          String
  /// ZAPIER_DELIVERY_STATUSES: pending | delivering | retrying | delivered | failed | cancelled
  status         String      @default("pending")
  attempts       Int         @default(0)
  nextAttemptAt  DateTime    @default(now()) @map("next_attempt_at")
  /// When a queue message was last sent for it (the sweep sends one for anything due that has none).
  enqueuedAt     DateTime?   @map("enqueued_at")
  lastAttemptAt  DateTime?   @map("last_attempt_at")
  deliveredAt    DateTime?   @map("delivered_at")
  /// Zapier's HTTP status on the last attempt (null: no answer).
  responseStatus Int?        @map("response_status")
  /// Why the last attempt didn't land (ZAPIER_DELIVERY_ERRORS in @app/shared/zapier).
  errorCode      String?     @map("error_code")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  zapierEvent    ZapierEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  hook           ZapierHook? @relation(fields: [hookId], references: [id], onDelete: SetNull)

  @@unique([eventId, hookId])
  @@index([status, nextAttemptAt])
  @@index([storeId, createdAt])
  @@index([hookId])
  @@index([workspaceId])
  @@map("zapier_deliveries")
}

// --- Running on a server of its own instead of AWS (docs/ikorex-migration). Read and written only by
// apps/aws's self-hosted runtime, over plain SQL on the system login. None of it is tenant data (a job's
// body carries its workspace, and its handler runs under row-level security as on AWS), so these
// tables have no row-level security and the tenant role has no rights on them (init.sql). On AWS they
// stay empty.

/// A background job: what an SQS message is on AWS (apps/aws/src/pgQueues.ts).
model QueueJob {
  id          String    @id @db.Uuid
  queue       String
  body        Json
  /// Deliveries so far (SQS's ApproximateReceiveCount): each claim adds one.
  receives    Int       @default(0)
  /// Higher first. Every producer sends 0 today.
  priority    Int       @default(0) @db.SmallInt
  /// Not delivered before this: a delay, or a retry's backoff.
  runAfter    DateTime  @default(now()) @map("run_after") @db.Timestamptz(3)
  /// While in the future, a worker holds the job (SQS's visibility timeout); a crashed worker's hold lapses.
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(3)
  /// The hold's id: a worker whose hold lapsed and was taken over can no longer settle the job.
  claimToken  String?   @map("claim_token") @db.Uuid
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([queue, runAfter])
  @@map("job_queue")
}

/// A job given up on after too many deliveries: the dead-letter queue (pgQueues.ts).
model DeadJob {
  id        String   @id @db.Uuid
  queue     String
  body      Json
  receives  Int
  lastError String?  @map("last_error")
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  diedAt    DateTime @default(now()) @map("died_at") @db.Timestamptz(3)

  @@index([queue, diedAt])
  @@map("job_dead")
}

/// A schedule tick that started (apps/aws/src/schedules.ts): two workers can't both run one, and a
/// restart finds the ticks it missed. EventBridge Scheduler's job on AWS.
model ScheduleTick {
  name       String
  tick       DateTime  @db.Timestamptz(3)
  attempts   Int       @default(1)
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)
  error      String?
  result     Json?

  @@id([name, tick])
  @@index([startedAt])
  @@map("schedule_ticks")
}

/// The coordinator (rate limits, OAuth state, locks, signed-out sessions): DynamoDB's `coord` table
/// on AWS (apps/aws/src/pgCoord.ts).
model CoordEntry {
  key   String @id @map("k")
  value String @default("") @map("v")
  count Int    @default(0) @map("n")
  /// When it stops counting or holding (epoch ms).
  until BigInt

  @@index([until])
  @@map("coord_entries")
}
