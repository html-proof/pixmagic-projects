// Trigger → conditions → action, written by the merchant.
model WhatsappAutomationRule {
  id              String   @id @default(cuid())
  workspaceId     String   @map("workspace_id")
  storeId         String   @map("store_id")
  name            String
  enabled         Boolean  @default(false)
  trigger         String
  conditions      Json     @default("[]")
  action          Json
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([storeId, trigger])
  @@index([workspaceId])
  @@map("whatsapp_automation_rules")
}

// Each time a rule met its trigger: at most once per rule, trigger and order/checkout/customer.
model WhatsappAutomationRun {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  storeId     String   @map("store_id")
  ruleId      String   @map("rule_id")
  trigger     String
  subjectKey  String   @map("subject_key")
  /** done | skipped | error | test */
  outcome     String
  detail      String?
  messageId   String?  @map("message_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([ruleId, trigger, subjectKey])
  @@index([storeId, createdAt])
  @@index([workspaceId])
  @@map("whatsapp_automation_runs")
}

// ---------------------------------------------------------------------------------------------
// RETIRED 2026-10-26: the Meta Cloud API + Nango WhatsApp module (2026-10-25), replaced by the
// wapp_* tables below. Nothing reads or writes these any more except the privacy paths
// (packages/core/src/whatsapp/legacy.ts: customers/redact, shop/redact, data request counts), so a
// rollback to the release before the rebuild still finds them. A later migration drops them
// (docs/whatsapp.md, "The old WhatsApp tables").
// ---------------------------------------------------------------------------------------------

// The store's WhatsApp Business number. One row per store, kept after a disconnect (for the history).
model WaConnection {
  id                 String    @id @default(cuid())
  workspaceId        String    @map("workspace_id")
  storeId            String    @unique @map("store_id")
  /// active | action_required | reconnect | error | disconnected (@app/shared/whatsapp)
  status             String    @default("active")
  /// While action_required: what the merchant does next (CONNECTION_STEPS).
  step               String?
  /// Why the status is what it is, for the merchant (never a token or Meta's raw answer).
  statusDetail       String?   @map("status_detail")
  /// The Nango connection holding the business token; null once disconnected.
  nangoConnectionId  String?   @map("nango_connection_id")
  /// How Meta's sign-up finished: cloud_api | only_waba | business_app | other.
  signupFlow         String?   @map("signup_flow")
  businessId         String?   @map("business_id")
  wabaId             String    @map("waba_id")
  wabaName           String?   @map("waba_name")
  /// One number sends for one store: unique while connected, cleared on disconnect.
  phoneNumberId      String?   @unique @map("phone_number_id")
  displayPhoneNumber String?   @map("display_phone_number")
  verifiedName       String?   @map("verified_name")
  nameStatus         String?   @map("name_status")
  qualityRating      String?   @map("quality_rating")
  /// TIER_250, TIER_1K, ...: how many customers a day the business may start conversations with.
  messagingLimitTier String?   @map("messaging_limit_tier")
  /// Registered with the Cloud API (it can't send until it is).
  registered         Boolean   @default(false)
  /// The two-step verification PIN bizinsights set when it registered the number, encrypted.
  pinEnc             String?   @map("pin_enc")
  /// The permissions Meta says the token holds (whatsapp_business_management, whatsapp_business_messaging).
  grantedScopes      String[]  @default([]) @map("granted_scopes")
  /// When bizinsights' app was subscribed to the account's webhooks (statuses, replies, STOP).
  subscribedAt       DateTime? @map("subscribed_at")
  lastWebhookAt      DateTime? @map("last_webhook_at")
  lastCheckedAt      DateTime? @map("last_checked_at")
  /// Since when it has needed reconnecting: waiting messages are cancelled 48 hours after.
  reconnectSince     DateTime? @map("reconnect_since")
  connectedByUserId  String?   @map("connected_by_user_id")
  connectedAt        DateTime  @default(now()) @map("connected_at")
  disconnectedAt     DateTime? @map("disconnected_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([wabaId])
  @@map("wa_connections")
}

// The store's WhatsApp choices: how customers agree to updates, sending hours, the test number.
model WaSettings {
  storeId           String    @id @map("store_id")
  workspaceId       String    @map("workspace_id")
  /// unset | opt_in_only | checkout_notice (ORDER_UPDATE_BASES); who chose it and when, also audited.
  orderUpdates      String    @default("unset") @map("order_updates")
  orderUpdatesSetBy String?   @map("order_updates_set_by")
  orderUpdatesSetAt DateTime? @map("order_updates_set_at")
  /// The store says its Shopify text-message marketing consent wording covers WhatsApp too.
  shopifySmsConsent Boolean   @default(false) @map("shopify_sms_consent")
  /// Store-time hours marketing messages may go out (a workflow can choose its own).
  sendWindowStart   Int       @default(9) @map("send_window_start")
  sendWindowEnd     Int       @default(20) @map("send_window_end")
  /// The store's own cap on business-started messages a day (null: Meta's limit only).
  dailyLimit        Int?      @map("daily_limit")
  /// The merchant's own phone, for test messages (encrypted) and as shown.
  testPhoneEnc      String?   @map("test_phone_enc")
  testPhoneMasked   String?   @map("test_phone_masked")
  /// SHA-256 of the store's custom-event key ("whev_..."), which the store's own tools send events with.
  eventKeyHash      String?   @unique @map("event_key_hash")
  /// The key's last characters, so the merchant can tell which one is in use.
  eventKeyHint      String?   @map("event_key_hint")
  eventKeyCreatedAt DateTime? @map("event_key_created_at")
  /// "Pause all automation": since when workflows start nothing and their (and campaigns') waiting
  /// messages are held; null when automation runs. Who paused it is audited too.
  automationPausedAt DateTime? @map("automation_paused_at")
  automationPausedBy String?   @map("automation_paused_by")
  updatedByUserId   String?   @map("updated_by_user_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@map("wa_settings")
}

// Message templates in the store's WhatsApp Business Account, as Meta last reported them.
model WaTemplate {
  id              String   @id @default(cuid())
  workspaceId     String   @map("workspace_id")
  storeId         String   @map("store_id")
  wabaId          String   @map("waba_id")
  metaId          String   @map("meta_id")
  name            String
  language        String
  /// UTILITY | MARKETING | AUTHENTICATION: Meta's, which may differ from what was asked for.
  category        String
  /// APPROVED | PENDING | REJECTED | PAUSED | DISABLED | IN_APPEAL ...
  status          String
  components      Json
  rejectedReason  String?  @map("rejected_reason")
  qualityScore    String?  @map("quality_score")
  /// Who wrote it in bizinsights (null: made in WhatsApp Manager).
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([storeId, name, language])
  @@index([wabaId, metaId])
  @@index([workspaceId])
  @@map("wa_templates")
}

// A customer's WhatsApp number and what they agreed to. Opt-outs are kept for as long as the store
// uses WhatsApp, so a customer who replied STOP is never messaged again.
model WaContact {
  id                String    @id @default(cuid())
  workspaceId       String    @map("workspace_id")
  storeId           String    @map("store_id")
  /// HMAC(CUSTOMER_HASH_KEY, "wa:<storeId>:<E.164 digits>"): finds the number without decrypting anything.
  phoneHash         String    @map("phone_hash")
  phoneEnc          String    @map("phone_enc")
  phoneMasked       String    @map("phone_masked")
  country           String?
  firstNameEnc      String?   @map("first_name_enc")
  shopifyCustomerId String?   @map("shopify_customer_id")
  /// Replied STOP (or was recorded as opted out): nothing at all is sent.
  optedOut          Boolean   @default(false) @map("opted_out")
  /// Agreed to messages themselves (START, recorded by the store, Shopify's consent).
  optedIn           Boolean   @default(false) @map("opted_in")
  /// opted_in | opted_out | unknown
  marketing         String    @default("unknown")
  consentUpdatedAt  DateTime? @map("consent_updated_at")
  /// The customer's last message: it opens WhatsApp's 24-hour window for free-form replies.
  lastInboundAt     DateTime? @map("last_inbound_at")
  /// From Shopify's customer record on their orders (for campaign audiences).
  ordersCount       Int       @default(0) @map("orders_count")
  totalSpent        Decimal   @default(0) @map("total_spent") @db.Decimal(18, 2)
  lastOrderAt       DateTime? @map("last_order_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([storeId, phoneHash])
  @@index([storeId, marketing, optedOut])
  @@index([storeId, shopifyCustomerId])
  @@index([workspaceId])
  @@map("wa_contacts")
}

// Every change to a customer's consent, with where it came from: the record of who agreed to what.
model WaConsentEvent {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  storeId     String   @map("store_id")
  contactId   String   @map("contact_id")
  /// all (every message) | marketing
  scope       String
  /// opted_in | opted_out
  status      String
  /// CONSENT_SOURCES
  source      String
  actorUserId String?  @map("actor_user_id")
  note        String?
  occurredAt  DateTime @map("occurred_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([contactId, occurredAt])
  @@index([storeId, createdAt])
  @@index([workspaceId])
  @@map("wa_consent_events")
}

// Every WhatsApp message, sent and received: the queue (queued -> sending) and the history
// (accepted -> sent -> delivered -> read, or failed / cancelled / skipped with the reason).
// A campaign's recipients are its messages.
model WaMessage {
  id               String    @id @default(cuid())
  workspaceId      String    @map("workspace_id")
  storeId          String    @map("store_id")
  connectionId     String?   @map("connection_id")
  /// out | in
  direction        String    @default("out")
  contactId        String?   @map("contact_id")
  /// The other party's number: keyed hash, encrypted E.164 (to send), masked (to show).
  phoneHash        String?   @map("phone_hash")
  phoneEnc         String?   @map("phone_enc")
  phoneMasked      String?   @map("phone_masked")
  /// workflow | campaign | manual | test | team_alert | inbound
  source           String
  workflowId       String?   @map("workflow_id")
  workflowRunId    String?   @map("workflow_run_id")
  campaignId       String?   @map("campaign_id")
  /// One message per purpose and store: "wf:<workflow>:<subject>", "campaign:<id>:<contact>", ...
  idempotencyKey   String?   @map("idempotency_key")
  /// template | text | image | document | video (out); whatever the customer sent (in).
  type             String
  templateName     String?   @map("template_name")
  templateLanguage String?   @map("template_language")
  /// The template's category when it was sent (UTILITY | MARKETING), or SERVICE for a reply in the window.
  category         String?
  /// What the send needs (variables, text, media link), encrypted; cleared once the message is final.
  payloadEnc       String?   @map("payload_enc")
  /// What the customer reads (or wrote), encrypted, for the history.
  previewEnc       String?   @map("preview_enc")
  status           String    @default("queued")
  /// Why it was skipped, cancelled or is waiting (SKIP_REASONS, or a hold).
  reason           String?
  sendAfter        DateTime  @default(now()) @map("send_after")
  enqueuedAt       DateTime? @map("enqueued_at")
  attempts         Int       @default(0)
  /// Meta's message id.
  wamid            String?   @unique
  errorCode        String?   @map("error_code")
  errorTitle       String?   @map("error_title")
  acceptedAt       DateTime? @map("accepted_at")
  sentAt           DateTime? @map("sent_at")
  deliveredAt      DateTime? @map("delivered_at")
  readAt           DateTime? @map("read_at")
  failedAt         DateTime? @map("failed_at")
  finalAt          DateTime? @map("final_at")
  billable         Boolean?
  pricingCategory  String?   @map("pricing_category")
  createdByUserId  String?   @map("created_by_user_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@unique([storeId, idempotencyKey])
  @@index([status, sendAfter])
  @@index([storeId, createdAt])
  @@index([campaignId, status])
  @@index([workflowId, createdAt])
  @@index([contactId, createdAt])
  @@index([workspaceId])
  @@map("wa_messages")
}

// Meta's delivery reports, once per message and status.
model WaMessageEvent {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  storeId     String   @map("store_id")
  messageId   String   @map("message_id")
  status      String
  occurredAt  DateTime @map("occurred_at")
  errorCode   String?  @map("error_code")
  errorTitle  String?  @map("error_title")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([messageId, status])
  @@index([storeId])
  @@index([workspaceId])
  @@map("wa_message_events")
}

// Meta's webhook deliveries, as received (signature checked), until they are applied. One body may
// speak for several stores (a shared business account), so the row belongs to no workspace: the
// worker resolves each change to its store by number or account.
model WaWebhookEvent {
  id          String    @id @default(cuid())
  /// SHA-256 of the raw body: Meta's retries of a body are stored once.
  bodyHash    String    @unique @map("body_hash")
  /// The body, encrypted (it carries customers' numbers and messages); cleared once applied.
  bodyEnc     String?   @map("body_enc")
  wabaIds     String[]  @default([]) @map("waba_ids")
  /// pending | processed | dead (gave up after WA_WEBHOOK_MAX_ATTEMPTS)
  status      String    @default("pending")
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  receivedAt  DateTime  @default(now()) @map("received_at")
  enqueuedAt  DateTime? @map("enqueued_at")
  processedAt DateTime? @map("processed_at")

  @@index([status, receivedAt])
  @@map("wa_webhook_events")
}

// A workflow: trigger -> conditions -> template -> timing, written by the merchant.
model WaWorkflow {
  id               String    @id @default(cuid())
  workspaceId      String    @map("workspace_id")
  storeId          String    @map("store_id")
  name             String
  /// WORKFLOW_TRIGGERS
  trigger          String
  /// custom_event only: the event's name.
  eventName        String?   @map("event_name")
  conditions       Json      @default("[]")
  /// "" for a message_received workflow, which answers with replyText instead of a template.
  templateName     String    @map("template_name")
  templateLanguage String    @map("template_language")
  mapping          Json
  headerMediaUrl   String?   @map("header_media_url")
  /// message_received only: the free-form reply (WhatsApp's 24-hour window is open: the customer just wrote).
  replyText        String?   @map("reply_text")
  /// message_received only: the same customer gets this workflow's reply at most once in this many minutes.
  replyCooldownMinutes Int?  @map("reply_cooldown_minutes")
  /// after_trigger | before_event
  timingMode       String    @default("after_trigger") @map("timing_mode")
  timingMinutes    Int       @default(0) @map("timing_minutes")
  sendWindowStart  Int?      @map("send_window_start")
  sendWindowEnd    Int?      @map("send_window_end")
  /// draft | active | paused
  status           String    @default("draft")
  /// Goes up with every save: a message waiting from an older version re-checks the workflow.
  version          Int       @default(1)
  createdByUserId  String?   @map("created_by_user_id")
  updatedByUserId  String?   @map("updated_by_user_id")
  activatedAt      DateTime? @map("activated_at")
  lastRunAt        DateTime? @map("last_run_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([storeId, trigger, status])
  @@index([workspaceId])
  @@map("wa_workflows")
}

// Each time a workflow's trigger fired: at most once per workflow and order, checkout, customer or event.
model WaWorkflowRun {
  id              String   @id @default(cuid())
  workspaceId     String   @map("workspace_id")
  storeId         String   @map("store_id")
  workflowId      String   @map("workflow_id")
  workflowVersion Int      @map("workflow_version")
  trigger         String
  /// "order:<id>", "checkout:<token>", "customer:<id>", "event:<name>:<id>", "test:<id>"
  subjectKey      String   @map("subject_key")
  /// What the merchant recognises: "Order #1042", "Checkout", "Event appointment_booked".
  subjectLabel    String?  @map("subject_label")
  /// scheduled (a message was queued) | skipped (conditions, consent, no number) | test
  outcome         String
  reason          String?
  messageId       String?  @map("message_id")
  contactId       String?  @map("contact_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([workflowId, subjectKey])
  @@index([storeId, createdAt])
  @@index([workflowId, createdAt])
  @@index([workspaceId])
  @@map("wa_workflow_runs")
}

// A campaign: an approved marketing template to an audience of opted-in customers, now or at a time.
model WaCampaign {
  id                  String    @id @default(cuid())
  workspaceId         String    @map("workspace_id")
  storeId             String    @map("store_id")
  name                String
  templateName        String    @map("template_name")
  templateLanguage    String    @map("template_language")
  mapping             Json
  headerMediaUrl      String?   @map("header_media_url")
  audience            Json
  /// draft | scheduled | sending | completed | cancelled
  status              String    @default("draft")
  scheduledAt         DateTime? @map("scheduled_at")
  /// The count the merchant confirmed when scheduling, and how many messages were made.
  estimatedRecipients Int?      @map("estimated_recipients")
  recipients          Int       @default(0)
  /// The last contact id given a message (recipients are made in batches).
  cursor              String?
  materializedAt      DateTime? @map("materialized_at")
  startedAt           DateTime? @map("started_at")
  completedAt         DateTime? @map("completed_at")
  cancelledAt         DateTime? @map("cancelled_at")
  cancelReason        String?   @map("cancel_reason")
  lastTestAt          DateTime? @map("last_test_at")
  createdByUserId     String?   @map("created_by_user_id")
  scheduledByUserId   String?   @map("scheduled_by_user_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([storeId, status])
  @@index([status, scheduledAt])
  @@index([workspaceId])
  @@map("wa_campaigns")
}

// ---------------------------------------------------------------------------------------------
// WhatsApp Automation on Evolution API (docs/whatsapp.md, 2026-10-26). Each store's connection is
// one instance on bizinsights' own Evolution API service (a phone linked by QR code, or Meta's
// Cloud API). Every table carries workspace_id under the tenant row-level-security policy.
// Customers' numbers, names and message texts are ENCRYPTED (AES-256-GCM, AAD "wapp:<storeId>:<kind>"),
// found by a keyed hash and shown masked; message texts are cleared after the store's retention.
// Instance keys and webhook keys are encrypted too and never leave the server.
// ---------------------------------------------------------------------------------------------

/// A store's WhatsApp connection (one Evolution API instance). One row per store, kept after a disconnect for the history.
model WappConnection {
  id               String    @id @default(cuid())
  workspaceId      String    @map("workspace_id")
  storeId          String    @unique @map("store_id")
  /// qr | cloud_api (WA_PROVIDERS)
  provider         String
  /// WA_CONNECTION_STATUSES: what the provider last reported, never assumed.
  status           String    @default("pairing")
  /// Why it is in that state: Baileys' close code ("close_401"), "qr_limit", "create_failed"... Never a provider's raw answer.
  statusReason     String?   @map("status_reason")
  /// The Evolution API server (shard) that holds the instance.
  shard            String
  /// Evolution's instance name: random, never derived from the tenant; null once the instance is deleted.
  instanceName     String?   @unique @map("instance_name")
  instanceId       String?   @map("instance_id")
  /// The instance's own API key (Evolution's per-instance token; Meta's access token for cloud_api), encrypted.
  instanceTokenEnc String?   @map("instance_token_enc")
  /// The key Evolution signs this instance's webhook JWTs with (HS256), encrypted.
  webhookKeyEnc    String?   @map("webhook_key_enc")
  /// qr | code: how the phone is being paired.
  pairingMethod    String?   @map("pairing_method")
  /// The linked number (the business's own): E.164 encrypted, and masked for the page.
  phoneEnc         String?   @map("phone_enc")
  phoneMasked      String?   @map("phone_masked")
  /// The WhatsApp profile name the provider reports.
  profileName      String?   @map("profile_name")
  /// cloud_api: Meta's WhatsApp Business account, phone number and business portfolio ids.
  wabaId           String?   @map("waba_id")
  phoneNumberId    String?   @unique @map("phone_number_id")
  businessId       String?   @map("business_id")
  /// cloud_api: when Meta's access token expires (Embedded Signup issues 60-day tokens; the sweep renews them).
  tokenExpiresAt   DateTime? @map("token_expires_at")
  /// QR codes the provider has issued in this pairing attempt (it gives up after its limit).
  qrCount          Int       @default(0) @map("qr_count")
  pairingStartedAt DateTime? @map("pairing_started_at")
  connectedAt      DateTime? @map("connected_at")
  disconnectedAt   DateTime? @map("disconnected_at")
  /// The time on the provider's last event about the connection: an older event changes nothing.
  lastEventAt      DateTime? @map("last_event_at")
  /// When bizinsights last asked the provider for the connection's state.
  lastCheckedAt    DateTime? @map("last_checked_at")
  /// Since when it can't send (logged out, reconnecting, failed): waiting messages are cancelled 48 hours after.
  downSince        DateTime? @map("down_since")
  createdByUserId  String?   @map("created_by_user_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([status])
  @@map("wapp_connections")
}

/// The store's WhatsApp choices (Step 3, Configure) and its verified test number (Step 4).
model WappSettings {
  storeId               String    @id @map("store_id")
  workspaceId           String    @map("workspace_id")
  /// What {{store_name}} says (the store's name until it is set).
  businessName          String?   @map("business_name")
  /// unset | opt_in_only | checkout_notice (WA_ORDER_UPDATE_BASES); who chose it and when (also audited).
  orderUpdates          String    @default("unset") @map("order_updates")
  orderUpdatesSetBy     String?   @map("order_updates_set_by")
  orderUpdatesSetAt     DateTime? @map("order_updates_set_at")
  marketingEnabled      Boolean   @default(false) @map("marketing_enabled")
  /// The store says its Shopify text-message marketing consent wording covers WhatsApp too.
  shopifySmsConsent     Boolean   @default(false) @map("shopify_sms_consent")
  /// Store-time hours business-started messages may go out in.
  sendWindowStart       Int       @default(9) @map("send_window_start")
  sendWindowEnd         Int       @default(20) @map("send_window_end")
  /// IANA time zone for the sending hours (null: the store's).
  timeZone              String?   @map("time_zone")
  /// Business-started messages a day (null: the provider's default, WA_DAILY_LIMIT).
  dailyLimit            Int?      @map("daily_limit")
  perCustomerDailyLimit Int       @default(3) @map("per_customer_daily_limit")
  /// Days message texts are kept (then only the record stays).
  retentionDays         Int       @default(90) @map("retention_days")
  /// When the settings were first saved (Step 3 done).
  configuredAt          DateTime? @map("configured_at")
  /// The merchant's own number for tests: keyed hash, encrypted, masked.
  testPhoneHash         String?   @map("test_phone_hash")
  testPhoneEnc          String?   @map("test_phone_enc")
  testPhoneMasked       String?   @map("test_phone_masked")
  /// SHA-256 of the verification code sent to it over WhatsApp, until it is entered or expires.
  testCodeHash          String?   @map("test_code_hash")
  testCodeExpiresAt     DateTime? @map("test_code_expires_at")
  testCodeAttempts      Int       @default(0) @map("test_code_attempts")
  testVerifiedAt        DateTime? @map("test_verified_at")
  /// When a test message to it was reported sent (or further) by the provider (Step 4 done).
  testPassedAt          DateTime? @map("test_passed_at")
  /// "Pause all automation": since when (null: it runs), and who paused it.
  automationPausedAt    DateTime? @map("automation_paused_at")
  automationPausedBy    String?   @map("automation_paused_by")
  updatedByUserId       String?   @map("updated_by_user_id")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@map("wapp_settings")
}

/// A message template written in bizinsights. On cloud_api, Meta's review of it as well.
model WappTemplate {
  id                 String    @id @default(cuid())
  workspaceId        String    @map("workspace_id")
  storeId            String    @map("store_id")
  name               String
  /// transactional | marketing
  category           String
  /// The text with {{variables}} (WA_VARIABLES).
  body               String
  active             Boolean   @default(true)
  /// cloud_api: the name and language it was submitted to Meta under, Meta's id, status and reason.
  metaName           String?   @map("meta_name")
  metaLanguage       String?   @map("meta_language")
  metaId             String?   @map("meta_id")
  metaStatus         String?   @map("meta_status")
  metaReason         String?   @map("meta_reason")
  metaCheckedAt      DateTime? @map("meta_checked_at")
  createdByUserId    String?   @map("created_by_user_id")
  updatedByUserId    String?   @map("updated_by_user_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@unique([storeId, name])
  @@index([workspaceId])
  @@map("wapp_templates")
}

/// A customer's WhatsApp number at a store and what they agreed to. Opt-outs stay while the store uses WhatsApp.
model WappContact {
  id                String    @id @default(cuid())
  workspaceId       String    @map("workspace_id")
  storeId           String    @map("store_id")
  /// HMAC(CUSTOMER_HASH_KEY, "wa:<storeId>:<E.164 digits>"): the same hash data requests are recorded with.
  phoneHash         String    @map("phone_hash")
  phoneEnc          String    @map("phone_enc")
  phoneMasked       String    @map("phone_masked")
  country           String?
  firstNameEnc      String?   @map("first_name_enc")
  shopifyCustomerId String?   @map("shopify_customer_id")
  /// Replied STOP (or was opted out): nothing at all is sent.
  optedOut          Boolean   @default(false) @map("opted_out")
  /// Agreed to order updates themselves (START, recorded by the store).
  optedIn           Boolean   @default(false) @map("opted_in")
  /// opted_in | opted_out | unknown
  marketing         String    @default("unknown")
  consentUpdatedAt  DateTime? @map("consent_updated_at")
  lastInboundAt     DateTime? @map("last_inbound_at")
  lastOutboundAt    DateTime? @map("last_outbound_at")
  /// The provider said the number isn't on WhatsApp (and when): not tried again for 30 days.
  notOnWhatsappAt   DateTime? @map("not_on_whatsapp_at")
  /// From Shopify's events (campaign audiences).
  ordersCount       Int       @default(0) @map("orders_count")
  totalSpent        Decimal   @default(0) @map("total_spent") @db.Decimal(18, 2)
  lastOrderAt       DateTime? @map("last_order_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([storeId, phoneHash])
  @@index([storeId, marketing, optedOut])
  @@index([storeId, shopifyCustomerId])
  @@index([workspaceId])
  @@map("wapp_contacts")
}

/// Every change to a customer's consent and where it came from. Append-only.
model WappConsentEvent {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  storeId     String   @map("store_id")
  contactId   String   @map("contact_id")
  /// all | order_updates | marketing
  scope       String
  /// opted_in | opted_out
  status      String
  /// WA_CONSENT_SOURCES
  source      String
  actorUserId String?  @map("actor_user_id")
  note        String?
  occurredAt  DateTime @map("occurred_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([contactId, occurredAt])
  @@index([storeId, createdAt])
  @@index([workspaceId])
  @@map("wapp_consent_events")
}

/// Numbers the store must not message: everything (all) or marketing only.
model WappSuppression {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  storeId     String   @map("store_id")
  phoneHash   String   @map("phone_hash")
  phoneMasked String   @map("phone_masked")
  /// all | marketing
  scope       String
  /// stop_reply | merchant | invalid_number | redact
  reason      String
  note        String?
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([storeId, phoneHash, scope])
  @@index([workspaceId])
  @@map("wapp_suppressions")
}

/// Every WhatsApp message, sent and received: the queue and the history. A campaign's recipients are its messages.
model WappMessage {
  id                String    @id @default(cuid())
  workspaceId       String    @map("workspace_id")
  storeId           String    @map("store_id")
  connectionId      String?   @map("connection_id")
  provider          String?
  /// out | in
  direction         String    @default("out")
  contactId         String?   @map("contact_id")
  phoneHash         String?   @map("phone_hash")
  phoneEnc          String?   @map("phone_enc")
  phoneMasked       String?   @map("phone_masked")
  /// automation | campaign | manual | test | verification | team_alert | inbound
  source            String
  automationId      String?   @map("automation_id")
  runId             String?   @map("run_id")
  campaignId        String?   @map("campaign_id")
  /// One message per purpose and store: "auto:<automation>:<subject>", "campaign:<id>:<contact>", "manual:<key>"...
  idempotencyKey    String?   @map("idempotency_key")
  /// transactional | marketing
  category          String?
  /// text | image | document (out); the provider's type (in)
  type              String
  templateId        String?   @map("template_id")
  /// What the send needs (text, an attachment's blob key), encrypted; cleared once the message is final.
  payloadEnc        String?   @map("payload_enc")
  /// What the customer reads (or wrote), encrypted, for the history; cleared after the store's retention.
  previewEnc        String?   @map("preview_enc")
  /// WA_MESSAGE_STATUSES
  status            String    @default("queued")
  /// WA_SKIP_REASONS (why skipped, cancelled, held or failed).
  reason            String?
  sendAfter         DateTime  @default(now()) @map("send_after")
  enqueuedAt        DateTime? @map("enqueued_at")
  attempts          Int       @default(0)
  /// The provider's id for it (WhatsApp's message key id; Meta's wamid on cloud_api).
  providerMessageId String?   @map("provider_message_id")
  errorCode         String?   @map("error_code")
  /// The provider's reason, cleaned for the merchant (providerDetail).
  errorDetail       String?   @map("error_detail")
  acceptedAt        DateTime? @map("accepted_at")
  sentAt            DateTime? @map("sent_at")
  deliveredAt       DateTime? @map("delivered_at")
  readAt            DateTime? @map("read_at")
  failedAt          DateTime? @map("failed_at")
  finalAt           DateTime? @map("final_at")
  createdByUserId   String?   @map("created_by_user_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([storeId, idempotencyKey])
  @@unique([connectionId, providerMessageId])
  @@index([status, sendAfter])
  @@index([storeId, createdAt])
  @@index([storeId, direction, acceptedAt])
  @@index([campaignId, status])
  @@index([automationId, createdAt])
  @@index([contactId, createdAt])
  @@index([workspaceId])
  @@map("wapp_messages")
}

/// The provider's reports about a message, once per message and status.
model WappMessageEvent {
  id             String   @id @default(cuid())
  workspaceId    String   @map("workspace_id")
  storeId        String   @map("store_id")
  messageId      String   @map("message_id")
  status         String
  /// The provider's own word (SERVER_ACK, DELIVERY_ACK, READ...).
  providerStatus String?  @map("provider_status")
  occurredAt     DateTime @map("occurred_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([messageId, status])
  @@index([storeId])
  @@index([workspaceId])
  @@map("wapp_message_events")
}

/// Evolution API's webhook deliveries, as received (JWT checked), until applied. Its retries are stored once.
model WappWebhookEvent {
  id           String    @id @default(cuid())
  workspaceId  String    @map("workspace_id")
  storeId      String    @map("store_id")
  connectionId String    @map("connection_id")
  /// CONNECTION_UPDATE, MESSAGES_UPSERT, MESSAGES_UPDATE... (Evolution's event name, upper-cased)
  event        String
  /// SHA-256 of the raw body.
  bodyHash     String    @unique @map("body_hash")
  /// The body, encrypted (it carries customers' numbers and messages); cleared once applied.
  bodyEnc      String?   @map("body_enc")
  /// pending | processed | ignored | dead
  status       String    @default("pending")
  attempts     Int       @default(0)
  lastError    String?   @map("last_error")
  /// The provider's own time on the event.
  providerAt   DateTime? @map("provider_at")
  receivedAt   DateTime  @default(now()) @map("received_at")
  enqueuedAt   DateTime? @map("enqueued_at")
  processedAt  DateTime? @map("processed_at")

  @@index([status, receivedAt])
  @@index([connectionId, receivedAt])
  @@index([workspaceId])
  @@map("wapp_webhook_events")
}

/// An automation: trigger -> conditions -> template -> recipient and timing.
model WappAutomation {
  id              String    @id @default(cuid())
  workspaceId     String    @map("workspace_id")
  storeId         String    @map("store_id")
  name            String
  description     String?
  /// WA_TRIGGERS
  trigger         String
  conditions      Json      @default("[]")
  templateId      String    @map("template_id")
  /// customer | shipping_address | billing_address
  recipient       String    @default("customer")
  delayMinutes    Int       @default(0) @map("delay_minutes")
  /// Its own sending hours (null: the store's).
  sendWindowStart Int?      @map("send_window_start")
  sendWindowEnd   Int?      @map("send_window_end")
  /// Every message goes to the store's verified test number instead of the customer.
  testMode        Boolean   @default(true) @map("test_mode")
  /// message_received: the same customer gets the reply at most once in this many minutes.
  cooldownMinutes Int?      @map("cooldown_minutes")
  /// draft | active | paused
  status          String    @default("draft")
  /// Goes up with every save: a message waiting from an older version checks the automation again.
  version         Int       @default(1)
  createdByUserId String?   @map("created_by_user_id")
  updatedByUserId String?   @map("updated_by_user_id")
  activatedAt     DateTime? @map("activated_at")
  lastRunAt       DateTime? @map("last_run_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([storeId, trigger, status])
  @@index([workspaceId])
  @@map("wapp_automations")
}

/// Each time an automation's trigger fired: at most once per automation and order, checkout, customer or message.
model WappAutomationRun {
  id                String   @id @default(cuid())
  workspaceId       String   @map("workspace_id")
  storeId           String   @map("store_id")
  automationId      String   @map("automation_id")
  automationVersion Int      @map("automation_version")
  trigger           String
  /// "order:<id>", "checkout:<token>", "customer:<id>", "inbound:<contact>:<window>", "test:<id>"
  subjectKey        String   @map("subject_key")
  /// What the merchant recognises: "Order #1042", "Checkout", "Message from +61 •••• 678".
  subjectLabel      String?  @map("subject_label")
  /// queued | skipped
  outcome           String
  reason            String?
  /// The failed conditions or missing values, for the history.
  detail            String?
  messageId         String?  @map("message_id")
  contactId         String?  @map("contact_id")
  testMode          Boolean  @default(false) @map("test_mode")
  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([automationId, subjectKey])
  @@index([storeId, createdAt])
  @@index([automationId, createdAt])
  @@index([workspaceId])
  @@map("wapp_automation_runs")
}

/// A campaign: a marketing template to an audience of opted-in customers, now or later, after the merchant confirms the count.
model WappCampaign {
  id                  String    @id @default(cuid())
  workspaceId         String    @map("workspace_id")
  storeId             String    @map("store_id")
  name                String
  templateId          String    @map("template_id")
  audience            Json
  /// draft | scheduled | sending | completed | cancelled
  status              String    @default("draft")
  scheduledAt         DateTime? @map("scheduled_at")
  /// The count the merchant confirmed when launching, and how many messages were made.
  confirmedRecipients Int?      @map("confirmed_recipients")
  recipients          Int       @default(0)
  /// The last contact id given a message (recipients are made in batches).
  cursor              String?
  materializedAt      DateTime? @map("materialized_at")
  startedAt           DateTime? @map("started_at")
  completedAt         DateTime? @map("completed_at")
  cancelledAt         DateTime? @map("cancelled_at")
  cancelReason        String?   @map("cancel_reason")
  createdByUserId     String?   @map("created_by_user_id")
  launchedByUserId    String?   @map("launched_by_user_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([storeId, status])
  @@index([status, scheduledAt])
  @@index([workspaceId])
  @@map("wapp_campaigns")
}

// ---------------------------------------------------------------------------------------------
// Staff Management, Time & Attendance and Payroll (docs/staff.md).
//
// Every table carries workspace_id (the organization) and has the tenant_isolation RLS policy.
// Money is integer minor units (bigint, `*_minor`) in the row's `currency`; rates and multipliers
// are fixed-point decimals. Instants are UTC timestamps written by the server; "days"
// (YYYY-MM-DD) are the organization's local calendar days. Partial unique indexes that Prisma
// cannot express (one open shift per employee, one open break per shift, one live invitation per
// employee) live in the migration SQL.
// ---------------------------------------------------------------------------------------------

/// Organization-level payroll settings (organization_payroll_settings). One row per workspace.
model StaffSettings {
  workspaceId              String    @id @map("workspace_id")
  /// IANA zone every "day", "week" and "hour" in staff reports is counted in.
  timezone                 String    @default("UTC")
  currency                 String    @default("USD")
  /// daily | weekly | biweekly | semimonthly | monthly
  payCycle                 String    @default("weekly") @map("pay_cycle")
  /// A day that starts a weekly or two-weekly period.
  payCycleAnchor           String    @default("2026-01-05") @map("pay_cycle_anchor")
  /// 0 = Sunday ... 6 = Saturday.
  weekStartsOn             Int       @default(1) @map("week_starts_on")
  invitationExpiryHours    Int       @default(48) @map("invitation_expiry_hours")
  /// An open shift older than this is flagged "forgot to clock out?" and stops adding paid time.
  staleSessionHours        Int       @default(14) @map("stale_session_hours")
  lateGraceMinutes         Int       @default(5) @map("late_grace_minutes")
  /// Hours must be approved before payroll can include them.
  requireApproval          Boolean   @default(true) @map("require_approval")
  allowEmployeeCorrections Boolean   @default(true) @map("allow_employee_corrections")
  /// Free-text region label (e.g. "AU-NSW"), shown on payslips. No statutory rules are applied.
  jurisdiction             String?
  supportEmail             String?   @map("support_email")
  defaultOvertimePolicyId  String?   @map("default_overtime_policy_id")
  defaultBreakPolicyId     String?   @map("default_break_policy_id")
  nextEmployeeNumber       Int       @default(1) @map("next_employee_number")
  updatedByUserId          String?   @map("updated_by_user_id")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")
  workspace                Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("organization_payroll_settings")
}

model Department {
  id          String     @id @default(cuid())
  workspaceId String     @map("workspace_id")
  name        String
  createdAt   DateTime   @default(now()) @map("created_at")
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  employees   Employee[]

  @@unique([workspaceId, name])
  @@map("departments")
}

/// Overtime rules. Thresholds in minutes; null switches a rule off. Multipliers like 1.5.
model OvertimePolicy {
  id                              String     @id @default(cuid())
  workspaceId                     String     @map("workspace_id")
  name                            String
  dailyThresholdMinutes           Int?       @map("daily_threshold_minutes")
  weeklyThresholdMinutes          Int?       @map("weekly_threshold_minutes")
  multiplier                      Decimal    @default(1.5) @db.Decimal(8, 4)
  doubleTimeDailyThresholdMinutes Int?       @map("double_time_daily_threshold_minutes")
  doubleTimeMultiplier            Decimal?   @map("double_time_multiplier") @db.Decimal(8, 4)
  holidayMultiplier               Decimal    @default(1) @map("holiday_multiplier") @db.Decimal(8, 4)
  createdAt                       DateTime   @default(now()) @map("created_at")
  updatedAt                       DateTime   @updatedAt @map("updated_at")
  workspace                       Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  employees                       Employee[]

  @@unique([workspaceId, name])
  @@map("overtime_policies")
}

/// Which breaks are paid and what counts as too many or too long (flagged for review, never blocked mid-shift).
model BreakPolicy {
  id                String     @id @default(cuid())
  workspaceId       String     @map("workspace_id")
  name              String
  restBreaksPaid    Boolean    @default(true) @map("rest_breaks_paid")
  mealBreaksPaid    Boolean    @default(false) @map("meal_breaks_paid")
  maxBreaksPerShift Int?       @map("max_breaks_per_shift")
  maxBreakMinutes   Int?       @map("max_break_minutes")
  createdAt         DateTime   @default(now()) @map("created_at")
  updatedAt         DateTime   @updatedAt @map("updated_at")
  workspace         Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  employees         Employee[]

  @@unique([workspaceId, name])
  @@map("break_policies")
}

/// A public holiday: no one is "absent" on it, and work on it earns the holiday multiplier.
model StaffHoliday {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  day         String
  name        String
  createdAt   DateTime  @default(now()) @map("created_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, day])
  @@map("staff_holidays")
}

model Employee {
  id                    String                @id @default(cuid())
  workspaceId           String                @map("workspace_id")
  /// "EMP-0001": generated, unique within the organization.
  employeeNumber        String                @map("employee_number")
  fullName              String                @map("full_name")
  email                 String
  phone                 String?
  jobTitle              String                @map("job_title")
  departmentId          String?               @map("department_id")
  /// full_time | part_time | casual | contract
  employmentType        String                @map("employment_type")
  joinedOn              String                @map("joined_on")
  currency              String
  standardWeeklyMinutes Int                   @default(2400) @map("standard_weekly_minutes")
  /// Regular working days, 0 = Sunday.
  workingDays           Int[]                 @default([1, 2, 3, 4, 5]) @map("working_days")
  managerUserId         String?               @map("manager_user_id")
  overtimePolicyId      String?               @map("overtime_policy_id")
  breakPolicyId         String?               @map("break_policy_id")
  timezone              String
  /// active | on_leave | inactive (deactivated)
  status                String                @default("active")
  notes                 String?
  /// The sign-in account (employee_auth_links): set when the invitation is accepted.
  userId                String?               @map("user_id")
  accountLinkedAt       DateTime?             @map("account_linked_at")
  deactivatedAt         DateTime?             @map("deactivated_at")
  deactivatedByUserId   String?               @map("deactivated_by_user_id")
  deactivationReason    String?               @map("deactivation_reason")
  createdByUserId       String?               @map("created_by_user_id")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  workspace             Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  department            Department?           @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  user                  User?                 @relation("EmployeeAccount", fields: [userId], references: [id], onDelete: SetNull)
  manager               User?                 @relation("EmployeeManager", fields: [managerUserId], references: [id], onDelete: SetNull)
  overtimePolicy        OvertimePolicy?       @relation(fields: [overtimePolicyId], references: [id], onDelete: SetNull)
  breakPolicy           BreakPolicy?          @relation(fields: [breakPolicyId], references: [id], onDelete: SetNull)
  invitations           EmployeeInvitation[]
  payRates              PayRate[]
  schedules             ShiftSchedule[]
  sessions              AttendanceSession[]
  events                AttendanceEvent[]
  adjustments           TimesheetAdjustment[]
  payrollItems          PayrollItem[]
  payrollAdjustments    PayrollAdjustment[]
  payments              PayrollPayment[]

  @@unique([workspaceId, employeeNumber])
  @@unique([workspaceId, email])
  @@unique([workspaceId, userId])
  @@index([workspaceId, status])
  @@index([userId])
  @@index([managerUserId])
  @@map("employees")
}

/// A single-use invitation to create the employee's account. Only the token's SHA-256 is stored.
model EmployeeInvitation {
  id              String    @id @default(cuid())
  workspaceId     String    @map("workspace_id")
  employeeId      String    @map("employee_id")
  email           String
  tokenHash       String    @unique @map("token_hash")
  expiresAt       DateTime  @map("expires_at")
  /// Sent by email (opening it proves the inbox) vs. a link copied by an admin (the account then
  /// has to verify its email before it can be used).
  emailed         Boolean   @default(false)
  linkRevealed    Boolean   @default(false) @map("link_revealed")
  emailError      String?   @map("email_error")
  acceptedAt      DateTime? @map("accepted_at")
  acceptedUserId  String?   @map("accepted_user_id")
  revokedAt       DateTime? @map("revoked_at")
  revokedByUserId String?   @map("revoked_by_user_id")
  createdByUserId String?   @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([employeeId])
  @@map("employee_invitations")
}

/// Effective-dated hourly rates (pay_rate_history): a rate applies from its local day until the next.
model PayRate {
  id              String   @id @default(cuid())
  workspaceId     String   @map("workspace_id")
  employeeId      String   @map("employee_id")
  hourlyRate      Decimal  @map("hourly_rate") @db.Decimal(14, 4)
  currency        String
  effectiveFrom   String   @map("effective_from")
  reason          String?
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, effectiveFrom])
  @@index([workspaceId])
  @@map("pay_rate_history")
}

model ShiftSchedule {
  id              String              @id @default(cuid())
  workspaceId     String              @map("workspace_id")
  employeeId      String              @map("employee_id")
  startsAt        DateTime            @map("starts_at")
  endsAt          DateTime            @map("ends_at")
  /// Planned unpaid break, for the schedule's expected hours only.
  breakMinutes    Int                 @default(0) @map("break_minutes")
  location        String?
  note            String?
  createdByUserId String?             @map("created_by_user_id")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  employee        Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  sessions        AttendanceSession[]

  @@index([workspaceId, startsAt])
  @@index([employeeId, startsAt])
  @@map("shift_schedules")
}

/// One shift: clock-in to clock-out. At most one open (clock_out_at IS NULL) per employee.
model AttendanceSession {
  id               String                @id @default(cuid())
  workspaceId      String                @map("workspace_id")
  employeeId       String                @map("employee_id")
  scheduleId       String?               @map("schedule_id")
  clockInAt        DateTime              @map("clock_in_at")
  clockOutAt       DateTime?             @map("clock_out_at")
  /// web | mobile | admin | system
  clockInSource    String                @map("clock_in_source")
  clockOutSource   String?               @map("clock_out_source")
  /// The employee's zone at clock-in (display only; pay rules use the organization's zone).
  timezone         String
  /// pending | approved | rejected
  approvalStatus   String                @default("pending") @map("approval_status")
  approvedAt       DateTime?             @map("approved_at")
  approvedByUserId String?               @map("approved_by_user_id")
  rejectedReason   String?               @map("rejected_reason")
  /// late, early_departure, unscheduled, overnight, stale, long_break, ... (attendance.ts)
  flags            String[]              @default([])
  /// Bumped by every correction; the before/after of each is in attendance_events.
  revision         Int                   @default(0)
  /// Set once an approved payroll includes this shift: it cannot be changed after that.
  lockedAt         DateTime?             @map("locked_at")
  note             String?
  staleAlertedAt   DateTime?             @map("stale_alerted_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  employee         Employee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  schedule         ShiftSchedule?        @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  breaks           BreakSession[]
  events           AttendanceEvent[]
  adjustments      TimesheetAdjustment[]
  approvals        TimesheetApproval[]

  @@index([workspaceId, clockInAt])
  @@index([employeeId, clockInAt])
  @@index([workspaceId, approvalStatus])
  @@map("attendance_sessions")
}

model BreakSession {
  id          String            @id @default(cuid())
  workspaceId String            @map("workspace_id")
  sessionId   String            @map("session_id")
  employeeId  String            @map("employee_id")
  startAt     DateTime          @map("start_at")
  endAt       DateTime?         @map("end_at")
  /// rest | meal
  kind        String
  /// Whether the break policy paid this kind of break when it started.
  paid        Boolean
  createdAt   DateTime          @default(now()) @map("created_at")
  session     AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([workspaceId])
  @@map("break_sessions")
}

/// Append-only record of every clock action and correction, with what the device claimed.
model AttendanceEvent {
  id             String             @id @default(cuid())
  workspaceId    String             @map("workspace_id")
  employeeId     String             @map("employee_id")
  sessionId      String?            @map("session_id")
  /// clock_in | clock_out | break_start | break_end | correction | manual_entry | approval | rejection | reopen | auto_flag | deactivation_close
  type           String
  /// Server time of the action (authoritative).
  at             DateTime
  /// What the device said the time was (audit only, never used for pay).
  clientTime     DateTime?          @map("client_time")
  clientTimezone String?            @map("client_timezone")
  source         String
  actorUserId    String?            @map("actor_user_id")
  /// The client's Idempotency-Key: a retried request finds this row instead of acting twice.
  idempotencyKey String?            @map("idempotency_key")
  ip             String?
  userAgent      String?            @map("user_agent")
  before         Json?
  after          Json?
  note           String?
  createdAt      DateTime           @default(now()) @map("created_at")
  employee       Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  session        AttendanceSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([employeeId, idempotencyKey])
  @@index([sessionId])
  @@index([workspaceId, at])
  @@map("attendance_events")
}

/// A requested or applied change to a shift (or a missing shift to add).
model TimesheetAdjustment {
  id                 String             @id @default(cuid())
  workspaceId        String             @map("workspace_id")
  employeeId         String             @map("employee_id")
  /// Null: add a shift that was never clocked.
  sessionId          String?            @map("session_id")
  requestedByUserId  String?            @map("requested_by_user_id")
  /// The employee asked (else a manager made it directly).
  byEmployee         Boolean            @default(false) @map("by_employee")
  proposedClockInAt  DateTime?          @map("proposed_clock_in_at")
  proposedClockOutAt DateTime?          @map("proposed_clock_out_at")
  /// [{ startAt, endAt, kind }] replacing the shift's breaks, when given.
  proposedBreaks     Json?              @map("proposed_breaks")
  reason             String
  /// pending | approved | rejected | cancelled
  status             String             @default("pending")
  decidedByUserId    String?            @map("decided_by_user_id")
  decidedAt          DateTime?          @map("decided_at")
  decisionNote       String?            @map("decision_note")
  createdAt          DateTime           @default(now()) @map("created_at")
  employee           Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  session            AttendanceSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([employeeId])
  @@map("timesheet_adjustments")
}

/// Each approve / reject / reopen of a shift's hours.
model TimesheetApproval {
  id          String            @id @default(cuid())
  workspaceId String            @map("workspace_id")
  sessionId   String            @map("session_id")
  /// approved | rejected | reopened
  action      String
  revision    Int
  actorUserId String?           @map("actor_user_id")
  note        String?
  createdAt   DateTime          @default(now()) @map("created_at")
  session     AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([workspaceId])
  @@map("timesheet_approvals")
}

model PayrollPeriod {
  id                 String              @id @default(cuid())
  workspaceId        String              @map("workspace_id")
  startDate          String              @map("start_date")
  endDate            String              @map("end_date")
  payCycle           String              @map("pay_cycle")
  payDate            String?             @map("pay_date")
  /// draft | pending_approval | approved | partially_paid | paid | cancelled | correction_required | payment_failed | reversed
  status             String              @default("draft")
  timezone           String
  /// Bumped by every calculation; approval names the version that was reviewed.
  version            Int                 @default(0)
  calculatedAt       DateTime?           @map("calculated_at")
  calculatedByUserId String?             @map("calculated_by_user_id")
  submittedAt        DateTime?           @map("submitted_at")
  submittedByUserId  String?             @map("submitted_by_user_id")
  approvedAt         DateTime?           @map("approved_at")
  approvedByUserId   String?             @map("approved_by_user_id")
  lockedAt           DateTime?           @map("locked_at")
  cancelledAt        DateTime?           @map("cancelled_at")
  notes              String?
  createdByUserId    String?             @map("created_by_user_id")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items              PayrollItem[]
  adjustments        PayrollAdjustment[]
  approvals          PayrollApproval[]

  @@index([workspaceId, startDate])
  @@map("payroll_periods")
}

/// One employee's pay for one period. Frozen (with its line breakdown) once the period is approved.
model PayrollItem {
  id                 String              @id @default(cuid())
  workspaceId        String              @map("workspace_id")
  periodId           String              @map("period_id")
  employeeId         String              @map("employee_id")
  currency           String
  regularSeconds     Int                 @default(0) @map("regular_seconds")
  overtimeSeconds    Int                 @default(0) @map("overtime_seconds")
  doubleTimeSeconds  Int                 @default(0) @map("double_time_seconds")
  holidaySeconds     Int                 @default(0) @map("holiday_seconds")
  paidBreakSeconds   Int                 @default(0) @map("paid_break_seconds")
  unpaidBreakSeconds Int                 @default(0) @map("unpaid_break_seconds")
  unpricedSeconds    Int                 @default(0) @map("unpriced_seconds")
  grossMinor         BigInt              @default(0) @map("gross_minor")
  otherEarningsMinor BigInt              @default(0) @map("other_earnings_minor")
  deductionsMinor    BigInt              @default(0) @map("deductions_minor")
  /// gross + other earnings - deductions. An estimate: no statutory tax is calculated.
  netMinor           BigInt              @default(0) @map("net_minor")
  /// Sum of this item's allocations from completed payments (kept in the same transaction).
  paidMinor          BigInt              @default(0) @map("paid_minor")
  /// [{ category, hourlyRate, multiplier, seconds, amountMinor }]
  lines              Json                @default("[]")
  /// The shifts (and their revisions) the figures were calculated from.
  sessions           Json                @default("[]")
  warnings           String[]            @default([])
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  period             PayrollPeriod       @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employee           Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  allocations        PaymentAllocation[]

  @@unique([periodId, employeeId])
  @@index([workspaceId])
  @@index([employeeId])
  @@map("payroll_items")
}

/// An authorized earning (bonus, allowance) or deduction added to an employee's pay for a period.
model PayrollAdjustment {
  id              String        @id @default(cuid())
  workspaceId     String        @map("workspace_id")
  periodId        String        @map("period_id")
  employeeId      String        @map("employee_id")
  /// earning | deduction
  kind            String
  label           String
  amountMinor     BigInt        @map("amount_minor")
  reason          String?
  createdByUserId String?       @map("created_by_user_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  removedAt       DateTime?     @map("removed_at")
  removedByUserId String?       @map("removed_by_user_id")
  period          PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([periodId])
  @@index([workspaceId])
  @@map("payroll_adjustments")
}

/// Every step of a period's approval workflow.
model PayrollApproval {
  id          String        @id @default(cuid())
  workspaceId String        @map("workspace_id")
  periodId    String        @map("period_id")
  /// calculated | submitted | approved | rejected | cancelled | reversed
  action      String
  version     Int
  actorUserId String?       @map("actor_user_id")
  comment     String?
  createdAt   DateTime      @default(now()) @map("created_at")
  period      PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@index([periodId])
  @@index([workspaceId])
  @@map("payroll_approvals")
}

/// A record that an employee was paid (bank transfer, cash, ...). Recording is not transferring:
/// no money moves through bizinsights.
model PayrollPayment {
  id                    String              @id @default(cuid())
  workspaceId           String              @map("workspace_id")
  employeeId            String              @map("employee_id")
  currency              String
  amountMinor           BigInt              @map("amount_minor")
  paidOn                String              @map("paid_on")
  /// bank_transfer | cash | cheque | external_provider | other
  method                String
  reference             String?
  remarks               String?
  /// completed | failed | reversed
  status                String              @default("completed")
  /// The client's Idempotency-Key: the same form submitted twice records one payment.
  idempotencyKey        String              @map("idempotency_key")
  recordedByUserId      String?             @map("recorded_by_user_id")
  failedAt              DateTime?           @map("failed_at")
  reversedAt            DateTime?           @map("reversed_at")
  statusChangedByUserId String?             @map("status_changed_by_user_id")
  statusReason          String?             @map("status_reason")
  createdAt             DateTime            @default(now()) @map("created_at")
  employee              Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  allocations           PaymentAllocation[]

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, paidOn])
  @@index([employeeId])
  @@map("payroll_payments")
}

/// Which pay item(s) a payment settles, and how much of each.
model PaymentAllocation {
  id            String         @id @default(cuid())
  workspaceId   String         @map("workspace_id")
  paymentId     String         @map("payment_id")
  payrollItemId String         @map("payroll_item_id")
  amountMinor   BigInt         @map("amount_minor")
  createdAt     DateTime       @default(now()) @map("created_at")
  payment       PayrollPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  item          PayrollItem    @relation(fields: [payrollItemId], references: [id], onDelete: Cascade)

  @@unique([paymentId, payrollItemId])
  @@index([payrollItemId])
  @@index([workspaceId])
  @@map("payment_allocations")
}

// ---------------------------------------------------------------------------------------------
// Email integrations and automation (docs/email.md).
//
// A workspace is the organization (tenant): every table carries workspace_id and the
// tenant_isolation RLS policy, and every reference between email tables is a composite
// (id, workspace_id) foreign key, so a rule can't point at another workspace's sender or template
// even through a bug in the code. OAuth tokens and SMTP passwords are envelope encrypted
// (packages/core/src/email/vault.ts) and never leave the server. Recipients' addresses are kept
// encrypted, with a keyed hash for lookups (suppressions, frequency limits, redaction) and a
// masked form for lists. Partial unique indexes Prisma can't express live in the migration SQL.
// ---------------------------------------------------------------------------------------------

/// Organization-level email settings (email_settings). One row per workspace, created on first save.
model EmailSettings {
  workspaceId     String    @id @map("workspace_id")
  /// Shown as {{business.name}} (the workspace name when empty).
  businessName    String?   @map("business_name")
  /// Printed in marketing footers: anti-spam laws require a postal address.
  businessAddress String?   @map("business_address")
  /// Messages a day for the whole workspace (null: EMAIL_DEFAULT_DAILY_LIMIT).
  dailyLimit      Int?      @map("daily_limit")
  /// Paused by the workspace's own admins: queued mail waits, nothing is lost.
  sendingPaused   Boolean   @default(false) @map("sending_paused")
  /// Suspended by the platform operator (abuse, complaints). Set by an ops task, never by the API.
  suspendedAt     DateTime? @map("suspended_at")
  suspendedReason String?   @map("suspended_reason")
  updatedByUserId String?   @map("updated_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("email_settings")
}

/// A mailbox the workspace sends from. Disconnecting deletes its credentials and keeps the row
/// (deleted_at) so the activity history still says who sent what.
model EmailAccount {
  id                   String                @id @default(cuid())
  workspaceId          String                @map("workspace_id")
  /// gmail | google_workspace | outlook | microsoft_365 | smtp
  provider             String
  /// oauth_google | oauth_microsoft | smtp
  connectionMethod     String                @map("connection_method")
  /// Lowercased. For OAuth accounts: the address the provider signed in as, never typed in.
  emailAddress         String                @map("email_address")
  displayName          String?               @map("display_name")
  replyToAddress       String?               @map("reply_to_address")
  /// Google `sub` / Microsoft `oid`: the same mailbox reconnecting updates this row.
  providerAccountId    String?               @map("provider_account_id")
  /// Microsoft `tid` (directory) / Google `hd` (Workspace domain).
  providerTenantId     String?               @map("provider_tenant_id")
  /// pending | connected | testing | degraded | reauthorization_required | disabled | revoked | failed
  status               String                @default("pending")
  /// Why it is in that status (an error code from ERROR_LABEL).
  statusReason         String?               @map("status_reason")
  grantedScopes        String[]              @default([]) @map("granted_scopes")
  /// Messages a day from this account (null: the provider's default in PROVIDER_LIMITS).
  dailyLimit           Int?                  @map("daily_limit")
  connectedByUserId    String?               @map("connected_by_user_id")
  lastVerifiedAt       DateTime?             @map("last_verified_at")
  lastSuccessfulSendAt DateTime?             @map("last_successful_send_at")
  lastErrorCode        String?               @map("last_error_code")
  lastErrorAt          DateTime?             @map("last_error_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  deletedAt            DateTime?             @map("deleted_at")
  workspace            Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  oauthCredential      EmailOAuthCredential?
  smtpCredential       EmailSmtpCredential?
  senders              EmailSenderIdentity[]
  messages             EmailMessage[]

  @@unique([id, workspaceId])
  @@index([workspaceId, status])
  @@map("email_accounts")
}

/// An OAuth account's tokens (oauth_credentials). `credential_version` changes with every refresh,
/// so two refreshes racing can't overwrite each other's rotated refresh token.
model EmailOAuthCredential {
  id                   String       @id @default(cuid())
  workspaceId          String       @map("workspace_id")
  emailAccountId       String       @map("email_account_id")
  refreshTokenEnc      String       @map("refresh_token_enc")
  accessTokenEnc       String?      @map("access_token_enc")
  tokenExpiresAt       DateTime?    @map("token_expires_at")
  encryptionKeyVersion Int          @map("encryption_key_version")
  credentialVersion    Int          @default(1) @map("credential_version")
  lastRefreshedAt      DateTime?    @map("last_refreshed_at")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  account              EmailAccount @relation(fields: [emailAccountId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([emailAccountId, workspaceId])
  @@index([workspaceId])
  @@map("email_oauth_credentials")
}

/// An SMTP account's server and password (smtp_credentials). The password is write-only.
model EmailSmtpCredential {
  id                   String       @id @default(cuid())
  workspaceId          String       @map("workspace_id")
  emailAccountId       String       @map("email_account_id")
  host                 String
  port                 Int
  /// tls (implicit, 465) | starttls (587, 2525). There is no unencrypted mode.
  encryptionMode       String       @map("encryption_mode")
  username             String
  secretEnc            String       @map("secret_enc")
  encryptionKeyVersion Int          @map("encryption_key_version")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  account              EmailAccount @relation(fields: [emailAccountId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([emailAccountId, workspaceId])
  @@index([workspaceId])
  @@map("email_smtp_credentials")
}

/// A sending domain and its DNS checks (verified_domains). Several workspaces may each prove the
/// same domain; each has its own challenge.
model EmailDomain {
  id                    String    @id @default(cuid())
  workspaceId           String    @map("workspace_id")
  domain                String
  /// dns_txt
  verificationMethod    String    @default("dns_txt") @map("verification_method")
  /// The challenge is compared by hash; the encrypted copy is only for showing the record again.
  verificationTokenHash String    @map("verification_token_hash")
  verificationTokenEnc  String    @map("verification_token_enc")
  /// unverified | pending | verified | failed | expired | recheck_required
  verificationStatus    String    @default("unverified") @map("verification_status")
  ownershipVerifiedAt   DateTime? @map("ownership_verified_at")
  verificationExpiresAt DateTime  @map("verification_expires_at")
  /// google | microsoft | other: which SPF include and DKIM selectors to look for.
  sendingService        String    @default("other") @map("sending_service")
  dkimSelectors         String[]  @default([]) @map("dkim_selectors")
  /// pass | warn | fail | missing | unknown (null: not checked yet)
  spfStatus             String?   @map("spf_status")
  dkimStatus            String?   @map("dkim_status")
  dmarcStatus           String?   @map("dmarc_status")
  /// What the last check found, record by record, with explanations.
  dnsResults            Json?     @map("dns_results")
  consecutiveFailures   Int       @default(0) @map("consecutive_failures")
  lastCheckedAt         DateTime? @map("last_checked_at")
  nextCheckAt           DateTime? @map("next_check_at")
  createdByUserId       String?   @map("created_by_user_id")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, domain])
  @@unique([id, workspaceId])
  @@index([verificationStatus, nextCheckAt])
  @@map("email_domains")
}

/// A From address an account may send as (sender_identities). Only `verified` ones send.
model EmailSenderIdentity {
  id                        String                @id @default(cuid())
  workspaceId               String                @map("workspace_id")
  emailAccountId            String                @map("email_account_id")
  /// The verified domain that authorized it (domain_ownership), if any.
  domainId                  String?               @map("domain_id")
  senderEmail               String                @map("sender_email")
  senderName                String?               @map("sender_name")
  /// pending | verified | revoked
  authorizationStatus       String                @default("pending") @map("authorization_status")
  /// provider_oauth | smtp_confirmation | domain_ownership
  verificationMethod        String?               @map("verification_method")
  verificationCodeHash      String?               @map("verification_code_hash")
  verificationCodeExpiresAt DateTime?             @map("verification_code_expires_at")
  verificationAttempts      Int                   @default(0) @map("verification_attempts")
  verifiedAt                DateTime?             @map("verified_at")
  /// The workspace's default sender (at most one: a partial unique index).
  isDefault                 Boolean               @default(false) @map("is_default")
  createdAt                 DateTime              @default(now()) @map("created_at")
  updatedAt                 DateTime              @updatedAt @map("updated_at")
  account                   EmailAccount          @relation(fields: [emailAccountId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  rules                     EmailAutomationRule[]

  @@unique([emailAccountId, senderEmail])
  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@map("email_sender_identities")
}

/// An email template. Saving an active template's content makes a new version; the old ones stay
/// in email_template_versions (history, restore).
model EmailTemplate {
  id               String                 @id @default(cuid())
  workspaceId      String                 @map("workspace_id")
  name             String
  description      String?
  /// transactional | marketing
  category         String                 @default("transactional")
  /// The event whose variables it uses (null: customer and business variables only).
  eventType        String?                @map("event_type")
  subjectTemplate  String                 @map("subject_template")
  /// Sanitized on save (sanitizeHtml), and again after rendering.
  htmlTemplate     String                 @map("html_template")
  textTemplate     String                 @map("text_template")
  /// The variables it uses, checked against the event on save.
  allowedVariables String[]               @default([]) @map("allowed_variables")
  version          Int                    @default(1)
  /// draft | active | archived
  status           String                 @default("draft")
  replyToAddress   String?                @map("reply_to_address")
  createdByUserId  String?                @map("created_by_user_id")
  updatedByUserId  String?                @map("updated_by_user_id")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  deletedAt        DateTime?              @map("deleted_at")
  workspace        Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions         EmailTemplateVersion[]
  rules            EmailAutomationRule[]

  @@unique([id, workspaceId])
  @@index([workspaceId, status])
  @@map("email_templates")
}

model EmailTemplateVersion {
  id              String        @id @default(cuid())
  workspaceId     String        @map("workspace_id")
  templateId      String        @map("template_id")
  version         Int
  category        String
  eventType       String?       @map("event_type")
  subjectTemplate String        @map("subject_template")
  htmlTemplate    String        @map("html_template")
  textTemplate    String        @map("text_template")
  createdByUserId String?       @map("created_by_user_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  template        EmailTemplate @relation(fields: [templateId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([templateId, version])
  @@index([workspaceId])
  @@map("email_template_versions")
}

/// Event → conditions → send this template from this sender to this recipient, after a delay.
model EmailAutomationRule {
  id               String                     @id @default(cuid())
  workspaceId      String                     @map("workspace_id")
  name             String
  description      String?
  eventType        String                     @map("event_type")
  /// Only events from this Shopify store (null: any).
  storeId          String?                    @map("store_id")
  /// The condition tree (conditionNodeSchema); null runs for every event.
  conditionJson    Json?                      @map("condition_json")
  /// { type: "send_email", recipient: { type: "customer" } | { type: "fixed", address } }
  actionJson       Json                       @map("action_json")
  senderIdentityId String                     @map("sender_identity_id")
  templateId       String                     @map("template_id")
  delayMinutes     Int                        @default(0) @map("delay_minutes")
  /// frequencySchema
  frequencyPolicy  Json                       @map("frequency_policy")
  maxAttempts      Int                        @default(5) @map("max_attempts")
  enabled          Boolean                    @default(false)
  /// Lower runs first when several rules match one event.
  priority         Int                        @default(100)
  lastTriggeredAt  DateTime?                  @map("last_triggered_at")
  createdByUserId  String?                    @map("created_by_user_id")
  updatedByUserId  String?                    @map("updated_by_user_id")
  createdAt        DateTime                   @default(now()) @map("created_at")
  updatedAt        DateTime                   @updatedAt @map("updated_at")
  deletedAt        DateTime?                  @map("deleted_at")
  workspace        Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sender           EmailSenderIdentity        @relation(fields: [senderIdentityId, workspaceId], references: [id, workspaceId], onDelete: NoAction)
  template         EmailTemplate              @relation(fields: [templateId, workspaceId], references: [id, workspaceId], onDelete: NoAction)
  executions       EmailAutomationExecution[]

  @@unique([id, workspaceId])
  @@index([workspaceId, eventType, enabled])
  @@map("email_automation_rules")
}

/// A business event (from Shopify or the event API), normalized. Its data is encrypted and kept
/// only as long as automations may still need it (retention clears it).
model EmailBusinessEvent {
  id            String                     @id @default(cuid())
  workspaceId   String                     @map("workspace_id")
  storeId       String?                    @map("store_id")
  /// shopify | api
  source        String
  eventType     String                     @map("event_type")
  /// The source's own id for it: the same event arriving twice is stored once.
  externalId    String                     @map("external_id")
  occurredAt    DateTime                   @map("occurred_at")
  /// Keyed hash of the customer's email (finds their events for GDPR redaction).
  recipientHash String?                    @map("recipient_hash")
  payloadEnc    String?                    @map("payload_enc")
  /// pending_detection (an abandoned checkout still being watched) | received | processed | cancelled | failed
  status        String                     @default("received")
  /// pending_detection: when it counts as abandoned if nothing else happens.
  detectAfter   DateTime?                  @map("detect_after")
  rulesMatched  Int                        @default(0) @map("rules_matched")
  processedAt   DateTime?                  @map("processed_at")
  error         String?
  createdAt     DateTime                   @default(now()) @map("created_at")
  updatedAt     DateTime                   @updatedAt @map("updated_at")
  workspace     Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  executions    EmailAutomationExecution[]

  @@unique([workspaceId, source, externalId])
  @@unique([id, workspaceId])
  @@index([status, detectAfter])
  @@index([workspaceId, createdAt])
  @@index([storeId, recipientHash])
  @@map("email_business_events")
}

/// One rule evaluated against one event (automation_executions). The idempotency key makes a
/// redelivered event or a retried job evaluate each rule once.
model EmailAutomationExecution {
  id             String              @id @default(cuid())
  workspaceId    String              @map("workspace_id")
  ruleId         String              @map("rule_id")
  eventId        String              @map("event_id")
  recipientHash  String?             @map("recipient_hash")
  /// rule:<ruleId>:event:<eventId>
  idempotencyKey String              @map("idempotency_key")
  /// pending | skipped | scheduled | suppressed | failed | cancelled
  status         String              @default("pending")
  /// What happened, in words.
  detail         String?
  /// An ERROR_LABEL code, when it didn't send.
  failureReason  String?             @map("failure_reason")
  messageId      String?             @map("message_id")
  evaluatedAt    DateTime            @default(now()) @map("evaluated_at")
  scheduledAt    DateTime?           @map("scheduled_at")
  completedAt    DateTime?           @map("completed_at")
  createdAt      DateTime            @default(now()) @map("created_at")
  rule           EmailAutomationRule @relation(fields: [ruleId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  event          EmailBusinessEvent  @relation(fields: [eventId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@unique([workspaceId, idempotencyKey])
  @@index([ruleId, createdAt])
  @@index([ruleId, recipientHash, createdAt])
  @@index([eventId])
  @@map("email_automation_executions")
}

/// Every email: the queue (queued → processing → accepted_by_provider, or deferred / failed /
/// suppressed / cancelled / unknown) and the history. The body is never stored: it is rendered from
/// the template and the event when sent.
model EmailMessage {
  id                  String              @id @default(cuid())
  workspaceId         String              @map("workspace_id")
  emailAccountId      String              @map("email_account_id")
  senderIdentityId    String?             @map("sender_identity_id")
  ruleId              String?             @map("rule_id")
  executionId         String?             @map("execution_id")
  eventId             String?             @map("event_id")
  templateId          String?             @map("template_id")
  templateVersion     Int?                @map("template_version")
  storeId             String?             @map("store_id")
  /// automation | test | verification
  kind                String
  /// transactional | marketing
  category            String              @default("transactional")
  provider            String
  senderAddress       String              @map("sender_address")
  recipientEnc        String              @map("recipient_enc")
  recipientHash       String              @map("recipient_hash")
  recipientMasked     String              @map("recipient_masked")
  subject             String
  /// One message per purpose (automation: the execution's key; tests: random).
  idempotencyKey      String              @map("idempotency_key")
  /// Our Message-ID header (without angle brackets).
  internetMessageId   String              @map("internet_message_id")
  /// Gmail's message id, or the SMTP server's queue id. Microsoft's sendMail returns none.
  providerMessageId   String?             @map("provider_message_id")
  /// queued | processing | accepted_by_provider | delivered | bounced | deferred | failed | suppressed | cancelled | unknown
  status              String              @default("queued")
  attempts            Int                 @default(0)
  maxAttempts         Int                 @default(5) @map("max_attempts")
  scheduledAt         DateTime            @map("scheduled_at")
  enqueuedAt          DateTime?           @map("enqueued_at")
  processingStartedAt DateTime?           @map("processing_started_at")
  providerAcceptedAt  DateTime?           @map("provider_accepted_at")
  deliveredAt         DateTime?           @map("delivered_at")
  failedAt            DateTime?           @map("failed_at")
  cancelledAt         DateTime?           @map("cancelled_at")
  lastErrorCode       String?             @map("last_error_code")
  /// Sanitized: never a token, password or the provider's raw response.
  lastErrorMessage    String?             @map("last_error_message")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  account             EmailAccount        @relation(fields: [emailAccountId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  events              EmailMessageEvent[]

  @@unique([workspaceId, idempotencyKey])
  @@unique([id, workspaceId])
  @@index([status, scheduledAt])
  @@index([workspaceId, createdAt])
  /// An automation's messages, newest first (the Automations hub's history and counts).
  @@index([workspaceId, ruleId, createdAt])
  @@index([emailAccountId, createdAt])
  @@index([ruleId, createdAt])
  @@index([workspaceId, recipientHash])
  @@index([storeId])
  @@map("email_messages")
}

/// What happened to a message, in order (email_events). Insert-only: a trigger refuses updates.
model EmailMessageEvent {
  id              String       @id @default(cuid())
  workspaceId     String       @map("workspace_id")
  messageId       String       @map("message_id")
  /// queued | processing | accepted | retry_scheduled | failed | bounced | suppressed | cancelled | unknown | delivered
  eventType       String       @map("event_type")
  providerEventId String?      @map("provider_event_id")
  eventTimestamp  DateTime     @default(now()) @map("event_timestamp")
  /// Sanitized details (error code, attempt, retry time). Never message content or credentials.
  metadata        Json?
  createdAt       DateTime     @default(now()) @map("created_at")
  message         EmailMessage @relation(fields: [messageId, workspaceId], references: [id, workspaceId], onDelete: Cascade)

  @@index([messageId, eventTimestamp])
  @@index([workspaceId])
  @@map("email_message_events")
}

/// Addresses not to email (suppression_entries), by keyed hash: the list itself holds no address.
model EmailSuppression {
  id              String    @id @default(cuid())
  workspaceId     String    @map("workspace_id")
  emailHash       String    @map("email_hash")
  emailMasked     String    @map("email_masked")
  /// unsubscribed | bounced | complained | manual | invalid
  reason          String
  /// marketing | all
  scope           String    @default("all")
  /// unsubscribe_link | one_click | manual | smtp_rejection | api
  source          String
  createdByUserId String?   @map("created_by_user_id")
  messageId       String?   @map("message_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, emailHash, scope])
  @@index([workspaceId, createdAt])
  @@map("email_suppressions")
}

/// Keys for POST /api/v1/events (custom business events). Only the hash is stored.
model EmailIngestKey {
  id              String    @id @default(cuid())
  workspaceId     String    @map("workspace_id")
  name            String
  prefix          String
  keyHash         String    @unique @map("key_hash")
  createdByUserId String    @map("created_by_user_id")
  lastUsedAt      DateTime? @map("last_used_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("email_ingest_keys")
}

/// A customer's request, through Shopify, for the data bizinsights holds about them (the mandatory
/// customers/data_request webhook). Shopify asks the app to give that data to the store owner, so
/// the owner downloads it from Settings → Privacy requests: the export is compiled from the live
/// records when they do (packages/core/src/privacy.ts), and this row keeps only what identifies
/// the customer, as the same keyed hashes the records carry, never their email or number.
model DataRequest {
  id               String    @id @default(cuid())
  workspaceId      String    @map("workspace_id")
  storeId          String    @map("store_id")
  /// Shopify's id for the request (data_request.id); a redelivery records nothing new.
  shopifyRequestId String    @map("shopify_request_id")
  /// The Shopify customer id, as Shopify sent it.
  customerId       String?   @map("customer_id")
  /// orders.customer_key / whatsapp_contacts.customer_key for this customer.
  customerKey      String?   @map("customer_key")
  /// whatsapp_contacts.phone_hash for the number Shopify sent.
  phoneHash        String?   @map("phone_hash")
  /// email_messages.recipient_hash for the address Shopify sent.
  emailHash        String?   @map("email_hash")
  /// Shopify order ids the request names.
  ordersRequested  String[]  @default([]) @map("orders_requested")
  receivedAt       DateTime  @default(now()) @map("received_at")
  /// When someone in the workspace last downloaded the export.
  downloadedAt     DateTime? @map("downloaded_at")
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([storeId, shopifyRequestId])
  @@index([workspaceId, receivedAt])
  @@map("data_requests")
}

// ---------------------------------------------------------------------------
// Customer Messaging: SMS through AWS End User Messaging (docs/sms.md). Every table carries
// workspace_id (the tenant) and store_id, under the same row-level-security policy as the rest.
// Customers' numbers are encrypted (AAD sms:<storeId>:<kind>), found by a keyed hash, and shown
// masked; a message's text is encrypted and dropped once its outcome is known.
// ---------------------------------------------------------------------------

/// How a store sends: its AWS origination identity, the countries it may reach, its budget and
/// limits, and the basis for order updates. Sending stays off until the merchant turns it on.
model SmsSenderConfiguration {
  id                   String    @id @default(cuid())
  workspaceId          String    @map("workspace_id")
  storeId              String    @unique @map("store_id")
  /// sender_id | long_code | toll_free | ten_dlc | short_code | pool
  senderType           String    @map("sender_type")
  /// The AWS origination identity (ARN or id). Accepted only when AWS tags it for this workspace, or as shared.
  originationIdentity  String    @map("origination_identity")
  /// What AWS reported at the last check: the sender ID or a masked number, its country and status.
  identityLabel        String?   @map("identity_label")
  identityCountry      String?   @map("identity_country")
  identityStatus       String?   @map("identity_status")
  twoWay               Boolean   @default(false) @map("two_way")
  /// unchecked | verified | not_found | not_allowed | error
  identityCheck        String    @default("unchecked") @map("identity_check")
  identityCheckedAt    DateTime? @map("identity_checked_at")
  /// complete | in_review | required | not_required | unknown
  registrationStatus   String    @default("unknown") @map("registration_status")
  awsRegion            String    @map("aws_region")
  configurationSet     String?   @map("configuration_set")
  optOutList           String?   @map("opt_out_list")
  countries            String[]  @default([])
  sendingEnabled       Boolean   @default(false) @map("sending_enabled")
  marketingEnabled     Boolean   @default(false) @map("marketing_enabled")
  monthlyBudgetUsd     Decimal   @default(0) @map("monthly_budget_usd") @db.Decimal(12, 4)
  hardStop             Boolean   @default(true) @map("hard_stop")
  monthlyMessageQuota  Int?      @map("monthly_message_quota")
  /// The budget alerts already raised this month: month and levels.
  budgetAlerts         Json      @default("{}") @map("budget_alerts")
  /// none | checkout_notice | sms_consent, and who chose it.
  transactionalBasis   String    @default("none") @map("transactional_basis")
  transactionalBasisBy String?   @map("transactional_basis_by")
  transactionalBasisAt DateTime? @map("transactional_basis_at")
  quietStart           Int       @default(21) @map("quiet_start")
  quietEnd             Int       @default(9) @map("quiet_end")
  maxPerCustomerDay    Int       @default(3) @map("max_per_customer_day")
  maxMarketingPerWeek  Int       @default(2) @map("max_marketing_per_week")
  dltEntityId          String?   @map("dlt_entity_id")
  /// Set by the circuit breaker (repeated AWS failures, a missing sender): messages wait until then.
  heldUntil            DateTime? @map("held_until")
  heldReason           String?   @map("held_reason")
  updatedBy            String?   @map("updated_by")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@map("sms_sender_configurations")
}

/// The simple SMS setup (Customer Messaging → Set up SMS): the step the merchant is on, the
/// connection check, what they typed so far and the sender name they asked for. The sender,
/// templates and rules live in their own tables; this row points at the ones the setup made.
model SmsSetup {
  id                  String    @id @default(cuid())
  workspaceId         String    @map("workspace_id")
  storeId             String    @unique @map("store_id")
  /// connect | sender | message | test | automate: where "Continue later" picks up.
  step                String    @default("connect")
  /// connected | failed | disconnected; null until the merchant first presses Connect.
  connection          String?
  /// Why the last connection check failed (platform_off, aws_unreachable…).
  connectionError     String?   @map("connection_error")
  connectionCheckedAt DateTime? @map("connection_checked_at")
  connectedBy         String?   @map("connected_by")
  connectedAt         DateTime? @map("connected_at")
  /// What {{business_name}} says (the store's name until it is set).
  businessName        String?   @map("business_name")
  /// The sender ID asked for, and the country most customers are in (where it is checked and registered).
  senderName          String?   @map("sender_name")
  country             String?
  /// SENDER_NAME_STATUSES (@app/shared/sms): approved only on AWS's word.
  senderNameStatus    String    @default("draft") @map("sender_name_status")
  senderRequestedAt   DateTime? @map("sender_requested_at")
  senderRequestedBy   String?   @map("sender_requested_by")
  senderCheckedAt     DateTime? @map("sender_checked_at")
  /// AWS's registration status at the last check (null: none needed, or AWS has no such sender ID).
  senderRegistration  String?   @map("sender_registration")
  /// The message step's text until it is saved as its template, and that template.
  message             String?
  templateId          String?   @map("template_id")
  /// Per trigger, the template and rule the Automatic SMS step made: {"order_created": {"templateId": "…", "ruleId": "…"}}.
  automations         Json      @default("{}")
  /// The budget and the basis for order updates chosen before the store had a sender (the sender's own after).
  monthlyBudgetUsd    Decimal?  @map("monthly_budget_usd") @db.Decimal(12, 4)
  transactionalBasis  String?   @map("transactional_basis")
  completedAt         DateTime? @map("completed_at")
  updatedBy           String?   @map("updated_by")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@map("sms_setups")
}

/// A message template. Each edit is a new version; messages use the approved one.
model SmsTemplate {
  id              String               @id @default(cuid())
  workspaceId     String               @map("workspace_id")
  storeId         String               @map("store_id")
  name            String
  /// transactional | marketing: the approved version's (the latest one's until a version is approved).
  category        String
  /// draft | in_review | approved | archived: the latest version's state, or archived.
  status          String               @default("draft")
  latestVersion   Int                  @default(1) @map("latest_version")
  /// The version messages use; null until one is approved.
  approvedVersion Int?                 @map("approved_version")
  /// Destination countries the merchant picked for the cost estimate.
  countries       String[]             @default([])
  createdBy       String?              @map("created_by")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  versions        SmsTemplateVersion[]

  @@unique([storeId, name])
  @@index([workspaceId])
  @@map("sms_templates")
}

model SmsTemplateVersion {
  id            String      @id @default(cuid())
  workspaceId   String      @map("workspace_id")
  storeId       String      @map("store_id")
  templateId    String      @map("template_id")
  version       Int
  category      String
  body          String
  /// India: the DLT template id and the text as registered ({#var#} for variables).
  dltTemplateId String?     @map("dlt_template_id")
  dltText       String?     @map("dlt_text")
  /// GSM | UCS2, and the parts of the template with every variable at its longest.
  encoding      String
  segments      Int
  /// draft | in_review | approved | rejected | superseded
  status        String      @default("draft")
  reviewNote    String?     @map("review_note")
  createdBy     String?     @map("created_by")
  submittedBy   String?     @map("submitted_by")
  submittedAt   DateTime?   @map("submitted_at")
  approvedBy    String?     @map("approved_by")
  approvedAt    DateTime?   @map("approved_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  template      SmsTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
  @@index([workspaceId])
  @@map("sms_template_versions")
}

/// WHEN an event, IF conditions, WAIT a delay, THEN a template. `config` is the rule as last
/// edited; `active_config` the approved version, which is what runs.
model SmsAutomationRule {
  id            String    @id @default(cuid())
  workspaceId   String    @map("workspace_id")
  storeId       String    @map("store_id")
  name          String
  /// draft | pending_approval | active | paused | disabled
  status        String    @default("draft")
  config        Json
  version       Int       @default(1)
  activeConfig  Json?     @map("active_config")
  activeVersion Int?      @map("active_version")
  /// The approved version's trigger and priority, for finding the rules an event runs.
  activeTrigger String?   @map("active_trigger")
  priority      Int       @default(50)
  submittedBy   String?   @map("submitted_by")
  submittedAt   DateTime? @map("submitted_at")
  approvedBy    String?   @map("approved_by")
  approvedAt    DateTime? @map("approved_at")
  lastRunAt     DateTime? @map("last_run_at")
  createdBy     String?   @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([storeId, activeTrigger, status])
  @@index([workspaceId])
  @@map("sms_automation_rules")
}

/// A saved audience (segmentFilterSchema). Marketing consent is always required on top.
model SmsSegment {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  storeId     String   @map("store_id")
  name        String
  filter      Json
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([storeId, name])
  @@index([workspaceId])
  @@map("sms_segments")
}

/// A marketing campaign: written, approved, then scheduled with the exact recipient count confirmed.
model SmsCampaign {
  id                  String                 @id @default(cuid())
  workspaceId         String                 @map("workspace_id")
  storeId             String                 @map("store_id")
  name                String
  templateId          String                 @map("template_id")
  /// The template version it sends, fixed when it is approved.
  templateVersion     Int?                   @map("template_version")
  segmentId           String?                @map("segment_id")
  filter              Json
  discountCode        String?                @map("discount_code")
  attributionDays     Int                    @default(3) @map("attribution_days")
  /// draft | pending_approval | approved | scheduled | sending | paused | completed | cancelled
  status              String                 @default("draft")
  estimatedRecipients Int?                   @map("estimated_recipients")
  estimatedCostUsd    Decimal?               @map("estimated_cost_usd") @db.Decimal(14, 6)
  confirmedRecipients Int?                   @map("confirmed_recipients")
  scheduledAt         DateTime?              @map("scheduled_at")
  startedAt           DateTime?              @map("started_at")
  completedAt         DateTime?              @map("completed_at")
  cancelledAt         DateTime?              @map("cancelled_at")
  submittedBy         String?                @map("submitted_by")
  submittedAt         DateTime?              @map("submitted_at")
  approvedBy          String?                @map("approved_by")
  approvedAt          DateTime?              @map("approved_at")
  scheduledBy         String?                @map("scheduled_by")
  createdBy           String?                @map("created_by")
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  recipients          SmsCampaignRecipient[]

  @@index([storeId, status])
  @@index([status, scheduledAt])
  @@index([workspaceId])
  @@map("sms_campaigns")
}

model SmsCampaignRecipient {
  id          String      @id @default(cuid())
  workspaceId String      @map("workspace_id")
  storeId     String      @map("store_id")
  campaignId  String      @map("campaign_id")
  contactId   String      @map("contact_id")
  /// pending | scheduled | skipped
  status      String      @default("pending")
  jobId       String?     @map("job_id")
  reason      String?
  createdAt   DateTime    @default(now()) @map("created_at")
  campaign    SmsCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@index([workspaceId])
  @@map("sms_campaign_recipients")
}

/// A customer's mobile number at a store, with their current SMS consent and suppression.
model SmsContact {
  id                   String             @id @default(cuid())
  workspaceId          String             @map("workspace_id")
  storeId              String             @map("store_id")
  phoneHash            String             @map("phone_hash")
  phoneEnc             String             @map("phone_enc")
  phoneMasked          String             @map("phone_masked")
  country              String?
  firstNameEnc         String?            @map("first_name_enc")
  /// Shopify's customer id (for re-reading consent live), and orders.customer_key for it.
  shopifyCustomerId    String?            @map("shopify_customer_id")
  customerKey          String?            @map("customer_key")
  /// Shopify's SMS marketing state: subscribed | not_subscribed | unsubscribed | pending | redacted | invalid | unknown
  consentState         String             @default("unknown") @map("consent_state")
  consentOptInLevel    String?            @map("consent_opt_in_level")
  consentSource        String?            @map("consent_source")
  consentCollectedFrom String?            @map("consent_collected_from")
  consentUpdatedAt     DateTime?          @map("consent_updated_at")
  suppressedAll        Boolean            @default(false) @map("suppressed_all")
  suppressedMarketing  Boolean            @default(false) @map("suppressed_marketing")
  /// From the orders bizinsights saw for this number (sms_contact_orders).
  ordersCount          Int                @default(0) @map("orders_count")
  totalSpent           Decimal            @default(0) @map("total_spent") @db.Decimal(18, 2)
  lastOrderAt          DateTime?          @map("last_order_at")
  lastMessageAt        DateTime?          @map("last_message_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  consentRecords       SmsConsentRecord[]
  orders               SmsContactOrder[]

  @@unique([storeId, phoneHash])
  @@index([storeId, consentState])
  @@index([storeId, customerKey])
  @@index([workspaceId])
  @@map("sms_contacts")
}

/// The orders seen for a contact: their order count, spend and last order, and attribution.
model SmsContactOrder {
  id             String     @id @default(cuid())
  workspaceId    String     @map("workspace_id")
  storeId        String     @map("store_id")
  contactId      String     @map("contact_id")
  shopifyOrderId String     @map("shopify_order_id")
  orderName      String?    @map("order_name")
  total          Decimal    @db.Decimal(18, 2)
  currency       String
  placedAt       DateTime   @map("placed_at")
  cancelled      Boolean    @default(false)
  createdAt      DateTime   @default(now()) @map("created_at")
  contact        SmsContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([storeId, shopifyOrderId])
  @@index([contactId, placedAt])
  @@index([workspaceId])
  @@map("sms_contact_orders")
}

/// Every change to a contact's consent, with where it came from and the evidence. Append-only.
model SmsConsentRecord {
  id          String     @id @default(cuid())
  workspaceId String     @map("workspace_id")
  storeId     String     @map("store_id")
  contactId   String     @map("contact_id")
  /// marketing | all
  purpose     String
  state       String
  optInLevel  String?    @map("opt_in_level")
  /// shopify_order | shopify_checkout | shopify_customer | shopify_import | opt_out_link | aws_opt_out | provider | merchant | customer_redact
  source      String
  /// What showed it: the webhook topic and id, Shopify's consent_collected_from and consent_updated_at, who in the team.
  evidence    Json       @default("{}")
  effectiveAt DateTime   @map("effective_at")
  recordedAt  DateTime   @default(now()) @map("recorded_at")
  contact     SmsContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, recordedAt])
  @@index([workspaceId])
  @@map("sms_consent_records")
}

/// Numbers that must not get texts from the store: everything (scope all) or marketing only.
model SmsSuppression {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  storeId     String   @map("store_id")
  phoneHash   String   @map("phone_hash")
  phoneMasked String   @map("phone_masked")
  /// all | marketing
  scope       String
  /// SUPPRESSION_REASONS in @app/shared/sms
  reason      String
  note        String?
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([storeId, phoneHash, scope])
  @@index([workspaceId])
  @@map("sms_suppression_list")
}

/// A checkout with a mobile number that wasn't finished: what an abandoned-checkout rule waits on.
model SmsCheckout {
  id               String    @id @default(cuid())
  workspaceId      String    @map("workspace_id")
  storeId          String    @map("store_id")
  checkoutToken    String    @map("checkout_token")
  contactId        String?   @map("contact_id")
  /// open | completed | expired
  status           String    @default("open")
  productTitle     String?   @map("product_title")
  total            Decimal?  @db.Decimal(18, 2)
  currency         String?
  /// Shopify's recovery link (it opens the customer's checkout): encrypted.
  recoveryUrlEnc   String?   @map("recovery_url_enc")
  lastActivityAt   DateTime  @map("last_activity_at")
  completedAt      DateTime? @map("completed_at")
  completedOrderId String?   @map("completed_order_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@unique([storeId, checkoutToken])
  @@index([storeId, status, lastActivityAt])
  @@index([workspaceId])
  @@map("sms_checkouts")
}

/// One text: the queue and the history. Unique per store and purpose (dedupe_key), so a Shopify
/// retry, a duplicate queue delivery or two rules firing together still send it once.
model SmsMessageJob {
  id                  String             @id @default(cuid())
  workspaceId         String             @map("workspace_id")
  storeId             String             @map("store_id")
  /// "rule:<id>:<subject>", "campaign:<id>:<contact>", "test:<id>"
  dedupeKey           String             @map("dedupe_key")
  /// automation | campaign | test
  purpose             String
  category            String
  trigger             String?
  ruleId              String?            @map("rule_id")
  ruleVersion         Int?               @map("rule_version")
  campaignId          String?            @map("campaign_id")
  templateId          String?            @map("template_id")
  templateVersion     Int?               @map("template_version")
  contactId           String?            @map("contact_id")
  testNumberId        String?            @map("test_number_id")
  phoneHash           String?            @map("phone_hash")
  phoneMasked         String?            @map("phone_masked")
  destinationCountry  String?            @map("destination_country")
  /// The values the template needs from the event, encrypted; cleared once the outcome is known.
  valuesEnc           String?            @map("values_enc")
  /// The text as sent, encrypted; cleared once the outcome is known.
  bodyEnc             String?            @map("body_enc")
  encoding            String?
  segments            Int?
  /// SMS_STATUSES in @app/shared/sms
  status              String             @default("scheduled")
  reason              String?
  sendAfter           DateTime           @map("send_after")
  enqueuedAt          DateTime?          @map("enqueued_at")
  claimedAt           DateTime?          @map("claimed_at")
  attempts            Int                @default(0)
  dryRun              Boolean            @default(false) @map("dry_run")
  awsRegion           String?            @map("aws_region")
  originationIdentity String?            @map("origination_identity")
  providerMessageId   String?            @unique @map("provider_message_id")
  acceptedAt          DateTime?          @map("accepted_at")
  /// AWS's last messageStatus and when it happened.
  providerStatus      String?            @map("provider_status")
  providerStatusAt    DateTime?          @map("provider_status_at")
  finalAt             DateTime?          @map("final_at")
  errorCode           String?            @map("error_code")
  estimatedCostUsd    Decimal?           @map("estimated_cost_usd") @db.Decimal(14, 6)
  /// What AWS charged (US dollars), from its delivery events.
  priceUsd            Decimal?           @map("price_usd") @db.Decimal(14, 6)
  carrierFeeUsd       Decimal?           @map("carrier_fee_usd") @db.Decimal(14, 6)
  partsBilled         Int?               @map("parts_billed")
  /// SHA-256 of this message's opt-out link code (/api/sms/u/<code>).
  optOutCodeHash      String?            @unique @map("opt_out_code_hash")
  /// What it is about: an order id, a checkout token, a customer.
  subjectKey          String?            @map("subject_key")
  orderId             String?            @map("order_id")
  checkoutToken       String?            @map("checkout_token")
  attributedOrderId   String?            @map("attributed_order_id")
  attributedRevenue   Decimal?           @map("attributed_revenue") @db.Decimal(18, 2)
  attributedCurrency  String?            @map("attributed_currency")
  attributedAt        DateTime?          @map("attributed_at")
  createdBy           String?            @map("created_by")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  events              SmsDeliveryEvent[]

  @@unique([storeId, dedupeKey])
  @@unique([storeId, attributedOrderId])
  @@index([status, sendAfter])
  @@index([storeId, createdAt])
  @@index([campaignId])
  @@index([ruleId])
  /// A store's texts of one automation, newest first (the Automations hub's history).
  @@index([storeId, ruleId, createdAt])
  @@index([contactId, acceptedAt])
  @@index([storeId, checkoutToken])
  @@index([workspaceId])
  @@map("sms_message_jobs")
}

/// AWS's delivery events, once each (a replayed event changes nothing).
model SmsDeliveryEvent {
  id                String        @id @default(cuid())
  workspaceId       String        @map("workspace_id")
  storeId           String        @map("store_id")
  jobId             String        @map("job_id")
  providerMessageId String        @map("provider_message_id")
  eventType         String        @map("event_type")
  messageStatus     String        @map("message_status")
  isFinal           Boolean       @map("is_final")
  eventAt           DateTime      @map("event_at")
  isoCountry        String?       @map("iso_country")
  parts             Int?
  priceUsd          Decimal?      @map("price_usd") @db.Decimal(14, 6)
  carrierFeeUsd     Decimal?      @map("carrier_fee_usd") @db.Decimal(14, 6)
  receivedAt        DateTime      @default(now()) @map("received_at")
  job               SmsMessageJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([providerMessageId, eventType, eventAt])
  @@index([jobId])
  @@index([workspaceId])
  @@map("sms_delivery_events")
}

/// What each message cost, as AWS reported it. One row per message, the month it was accepted in.
model SmsCostRecord {
  id            String   @id @default(cuid())
  workspaceId   String   @map("workspace_id")
  storeId       String   @map("store_id")
  jobId         String   @unique @map("job_id")
  campaignId    String?  @map("campaign_id")
  ruleId        String?  @map("rule_id")
  country       String?
  /// "2026-10" (UTC)
  month         String
  parts         Int
  priceUsd      Decimal  @map("price_usd") @db.Decimal(14, 6)
  carrierFeeUsd Decimal  @map("carrier_fee_usd") @db.Decimal(14, 6)
  totalUsd      Decimal  @map("total_usd") @db.Decimal(14, 6)
  recordedAt    DateTime @default(now()) @map("recorded_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([storeId, month])
  @@index([month])
  @@index([workspaceId])
  @@map("sms_cost_records")
}

/// Who changed what in Customer Messaging, with the version's snapshot (template and rule history). Append-only.
model SmsAuditLog {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  storeId     String?  @map("store_id")
  actorUserId String?  @map("actor_user_id")
  action      String
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id")
  version     Int?
  snapshot    Json?
  metadata    Json?
  ip          String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([storeId, createdAt])
  @@index([targetId])
  @@index([workspaceId])
  @@map("sms_audit_logs")
}

/// A team member's own number, verified with AWS, that test texts may go to (AWS's sandbox reaches only these).
model SmsTestNumber {
  id            String    @id @default(cuid())
  workspaceId   String    @map("workspace_id")
  storeId       String    @map("store_id")
  phoneHash     String    @map("phone_hash")
  phoneEnc      String    @map("phone_enc")
  phoneMasked   String    @map("phone_masked")
  country       String?
  /// AWS's verified destination number id.
  awsVerifiedId String?   @map("aws_verified_id")
  /// pending | verified
  status        String    @default("pending")
  createdBy     String?   @map("created_by")
  verifiedAt    DateTime? @map("verified_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@unique([storeId, phoneHash])
  @@index([workspaceId])
  @@map("sms_test_numbers")
}

// ---------------------------------------------------------------------------------------------------
// Zapier (docs/zapier.md): the "bizinsights" app on Zapier's Developer Platform. bizinsights is the
// OAuth provider: a member who may manage integrations allows Zapier to reach one store, and Zapier
// subscribes REST hooks for its triggers. No Prisma relation to users, workspaces or stores: like
// ad_connections, the rows are removed by the code that removes those (member removal, account
// deletion, store purge). Added by migration 20261028120000_zapier_integration.
// ---------------------------------------------------------------------------------------------------

/// One "Connect bizinsights" in a merchant's Zapier account: Zapier may reach this store, for as long as
/// the member who allowed it may manage its integrations (checked on every request and delivery).
model ZapierGrant {
  id            String        @id @default(cuid())
  workspaceId   String        @map("workspace_id")
  storeId       String        @map("store_id")
  /// The member who allowed it on bizinsights' consent page (/connect/zapier).
  userId        String        @map("user_id")
  /// The OAuth client it was issued to (ZAPIER_CLIENT_ID at the time).
  clientId      String        @map("client_id")
  /// What it may do beyond triggers and searches, as ticked on the consent page: whatsapp_send.
  scopes        String[]      @default([])
  /// The last request Zapier made with it (at most once a minute).
  lastUsedAt    DateTime?     @map("last_used_at")
  revokedAt     DateTime?     @map("revoked_at")
  /// disconnected | member_removed | account_deleted | account_taken_over | store_erased | refresh_token_reused | code_reused
  revokedReason String?       @map("revoked_reason")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  tokens        ZapierToken[]
  hooks         ZapierHook[]

  @@index([workspaceId])
  @@index([storeId])
  @@index([userId])
  @@map("zapier_grants")
}

/// A grant's access and refresh tokens, as SHA-256 hashes only: the tokens themselves are never kept.
model ZapierToken {
  id          String      @id @default(cuid())
  workspaceId String      @map("workspace_id")
  grantId     String      @map("grant_id")
  /// access | refresh
  kind        String
  tokenHash   String      @unique @map("token_hash")
  expiresAt   DateTime    @map("expires_at")
  /// A refresh token: when it was exchanged. Presented again after the grace period, it revokes the whole grant.
  usedAt      DateTime?   @map("used_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  grant       ZapierGrant @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@index([grantId])
  @@index([workspaceId])
  @@index([expiresAt])
  @@map("zapier_tokens")
}

/// A Zap's trigger, subscribed by Zapier (REST hook): where the trigger's events are posted.
model ZapierHook {
  id              String           @id @default(cuid())
  workspaceId     String           @map("workspace_id")
  storeId         String           @map("store_id")
  grantId         String           @map("grant_id")
  /// ZAPIER_EVENTS in @app/shared/zapier
  event           String
  /// Zapier's subscription URL, always https://hooks.zapier.com/hooks/... (isZapierHookUrl).
  targetUrl       String           @map("target_url")
  /// The trigger's own fields as checked when it was made (thresholds: platform, period, amount).
  inputs          Json             @default("{}")
  /// Zapier's id for the Zap, when it sends one (for support).
  zapId           String?          @map("zap_id")
  lastDeliveredAt DateTime?        @map("last_delivered_at")
  /// Thresholds: when the store's figures were last checked against it, and why they couldn't be (mixed currencies).
  checkedAt       DateTime?        @map("checked_at")
  checkNote       String?          @map("check_note")
  createdAt       DateTime         @default(now()) @map("created_at")
  grant           ZapierGrant      @relation(fields: [grantId], references: [id], onDelete: Cascade)
  deliveries      ZapierDelivery[]

  @@index([storeId, event])
  @@index([grantId])
  @@index([workspaceId])
  @@map("zapier_hooks")
}

/// The outbox: one row per thing that happened, written where it happened, delivered by the worker.
/// Kept 30 days (the cron sweep), which is also what a trigger's samples come from.
model ZapierEvent {
  id          String           @id @default(cuid())
  workspaceId String           @map("workspace_id")
  storeId     String           @map("store_id")
  event       String
  /// An event meant for one trigger only (a threshold crossed for that trigger's amount).
  hookId      String?          @map("hook_id")
  /// One row per happening: a retried job or a repeated alert can't make a second.
  dedupeKey   String           @unique @map("dedupe_key")
  /// What Zapier receives, before the per-person redaction at delivery.
  payload     Json
  createdAt   DateTime         @default(now()) @map("created_at")
  deliveries  ZapierDelivery[]

  @@index([storeId, event, createdAt])
  @@index([createdAt])
  @@index([workspaceId])
  @@map("zapier_events")
}

/// One event for one Zap's trigger: its attempts and outcome (Settings → Integrations shows the last ones).
model ZapierDelivery {
  id             String      @id @default(cuid())
  workspaceId    String      @map("workspace_id")
  storeId        String      @map("store_id")
  eventId        String      @map("event_id")
  /// Null once the trigger is gone (unsubscribed, a 410 from Zapier, a disconnect): the record stays.
  hookId         String?     @map("hook_id")
  event          String
  /// ZAPIER_DELIVERY_STATUSES: pending | delivering | retrying | delivered | failed | cancelled
  status         String      @default("pending")
  attempts       Int         @default(0)
  nextAttemptAt  DateTime    @default(now()) @map("next_attempt_at")
  /// When a queue message was last sent for it (the sweep sends one for anything due that has none).
  enqueuedAt     DateTime?   @map("enqueued_at")
  lastAttemptAt  DateTime?   @map("last_attempt_at")
  deliveredAt    DateTime?   @map("delivered_at")
  /// Zapier's HTTP status on the last attempt (null: no answer).
  responseStatus Int?        @map("response_status")
  /// Why the last attempt didn't land (ZAPIER_DELIVERY_ERRORS in @app/shared/zapier).
  errorCode      String?     @map("error_code")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  zapierEvent    ZapierEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  hook           ZapierHook? @relation(fields: [hookId], references: [id], onDelete: SetNull)

  @@unique([eventId, hookId])
  @@index([status, nextAttemptAt])
  @@index([storeId, createdAt])
  @@index([hookId])
  @@index([workspaceId])
  @@map("zapier_deliveries")
}
