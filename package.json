{
  "name": "shopify-insights",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/** dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0 && node scripts/check-import-cycles.mjs",
    "test": "pnpm --filter @app/shared --filter @app/core --filter @app/aws test",
    "test:integration": "pnpm --workspace-concurrency=1 --filter @app/api --filter @app/worker test",
    "e2e": "pnpm --filter @app/web e2e",
    "db:generate": "pnpm --filter @app/db generate",
    "db:migrate": "pnpm --filter @app/db migrate:deploy",
    "db:migrate:dev": "pnpm --filter @app/db migrate:dev",
    "test:all": "pnpm test && pnpm test:integration"
  },
  "pnpm": {
    "overrides": {
      "mysql2@<3.23.1": "^3.24.5",
      "deepmerge-ts@<8.0.0": "^8.0.2",
      "sharp@<0.35.5": "^0.35.5",
      "@grpc/grpc-js@<1.13.6": "^1.14.6",
      "vite@<7.3.7": "^7.3.7"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "typescript-eslint": "^8.71.2"
  }
}
