# env/cloudflared.env: the tunnel's token (Cloudflare dashboard → Zero Trust → Networks → Tunnels →
# create "bizinsights" → Docker → the value after --token). Its public hostnames are set there:
#   bizinsights.io, www.bizinsights.io  → http://web:8080   (at the cutover only)
#   staging.bizinsights.io              → http://web:8080 of the staging project, behind Cloudflare Access
#   grafana.bizinsights.io              → http://grafana:3000, behind Cloudflare Access
TUNNEL_TOKEN=
