# env/postgres-exporter.env: the PostgreSQL exporter's read-only login. scripts/deploy.sh makes the
# role `monitor` (pg_monitor: statistics only, no table data) with MONITOR_DB_PASSWORD.
MONITOR_DB_PASSWORD=CHANGE_ME_MONITOR_PASSWORD
DATA_SOURCE_NAME=postgresql://monitor:CHANGE_ME_MONITOR_PASSWORD@postgres:5432/app?sslmode=disable
