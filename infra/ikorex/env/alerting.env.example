# env/alerting.env: read by scripts/render-monitoring.sh only (no container gets this file).
# Where alerts go, who they come from (a sender on bizinsights.io, which Resend sends for), and
# Resend's SMTP password (the API key).
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=alerts@bizinsights.io
RESEND_SMTP_PASSWORD=
