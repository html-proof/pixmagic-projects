# env/owner.env: only for `docker compose --profile admin run --rm admin <command>` (migrate, counts,
# evolution-db). The database owner's login and the passwords `migrate` gives the app's roles.
# Generate each password once (e.g. `openssl rand -base64 32 | tr -d '/+='`) and keep a copy off the server.
OWNER_DATABASE_URL=postgresql://app:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/app
SYSTEM_DB_PASSWORD=CHANGE_ME_SYSTEM_DB_PASSWORD
APP_RLS_PASSWORD=CHANGE_ME_APP_RLS_PASSWORD
EVOLUTION_DB_USER=evolution
EVOLUTION_DB_PASSWORD=CHANGE_ME_EVOLUTION_DB_PASSWORD
