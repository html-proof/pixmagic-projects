# env/app.env: the web, worker and admin containers' settings and secrets (mode 600, never in Git).
# Values from AWS: `node infra/ikorex/scripts/export-env.mjs | ssh ikorex 'umask 077; cat > ~/bizinsights/env/app.env.from-aws'`,
# then merge with the database lines below. The app's own settings (apps/aws/src/settings.ts) ship
# in the image; anything here wins over them.

# --- Where it runs
APP_URL=https://bizinsights.io
APP_ENVIRONMENT=production
LOG_LEVEL=info

# --- Database: this project's PostgreSQL. The two role passwords are the ones in env/owner.env
# (`admin migrate` sets them on the roles).
DATABASE_URL=postgresql://app_system:CHANGE_ME_SYSTEM_DB_PASSWORD@postgres:5432/app
APP_DATABASE_URL=postgresql://app_rls:CHANGE_ME_APP_RLS_PASSWORD@postgres:5432/app
# The WhatsApp service's own database, for the nightly prune of what it keeps (7 days).
EVOLUTION_DATABASE_URL=postgresql://evolution:CHANGE_ME_EVOLUTION_DB_PASSWORD@postgres:5432/evolution

# --- The app's own secrets: copied from AWS (insights/production/app), never regenerated, or every
# stored token, session and customer hash stops matching.
SESSION_SECRET=
TOKEN_ENCRYPTION_KEYS=
OTP_PEPPER=

# --- Providers (insights/production/app). One left empty turns that provider off.
SHOPIFY_API_SECRET=
# SHOPIFY_APP_SECRET_<KEY>=   one per extra Shopify app, as on AWS
META_APP_SECRET=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_SIGNIN_CLIENT_SECRET=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
EMAIL_GOOGLE_CLIENT_SECRET=
EMAIL_MICROSOFT_CLIENT_SECRET=
EMAIL_CREDENTIAL_KEYS=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# --- Sign-in: Cognito stays on AWS (docs/ikorex-migration/AWS_TO_IKOREX_MIGRATION_MATRIX.md).
# From the runtime parameter /insights/production/runtime and the secret insights/production/worker-cognito.
COGNITO_REGION=ap-southeast-2
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=https://auth.bizinsights.io
COGNITO_IDENTITY_PROVIDERS=Google

# --- AWS keys of the IAM user that replaces the functions' role: Cognito's admin calls on this pool,
# End User Messaging SMS sends, reading the smsEvents queue, and (if COST_REPORT_TO is set)
# ce:GetCostAndUsage. Nothing else.
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# COST_REPORT_TO=   the owner's daily AWS cost email, while there is an AWS bill

# --- Texts (docs/sms.md, "Twilio"). Twilio once the owner has switched (the image's settings.ts says
# which); its status reports and STOP replies come back to API_URL/webhooks/sms/twilio/*, through
# the tunnel like every request. TWILIO_ACCOUNT_SID ships in settings.ts; the token is a secret.
# SMS_PROVIDER=twilio
TWILIO_AUTH_TOKEN=
# Only while SMS_PROVIDER is aws: AWS End User Messaging's configuration set, and its delivery events
# (apps/aws/src/sqsBridge.ts), production only and read only with SCHEDULES=on. A staging copy
# leaves the queue empty, or it would take the live copy's events.
SMS_CONFIGURATION_SET=
# SMS_EVENTS_QUEUE_URL=https://sqs.ap-southeast-2.amazonaws.com/<account>/insights-production-smsEvents

# --- The WhatsApp service (the evolution container). EVOLUTION_API_KEY is also in env/evolution.env.
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_URL=http://web:8080/api

# --- The self-hosted runtime (apps/aws/src/selfhost.ts)
BLOB_DIR=/data/blobs
# The header Cloudflare puts the client's address in; "none" trusts none.
TRUSTED_IP_HEADER=cf-connecting-ip
# Jobs at once per queue in each worker, over the AWS defaults (2, 2, 2, 2, 2, 3); keep the sum
# under the worker's DB_POOL_MAX (docker-compose.yml).
# QUEUE_CONCURRENCY={"sync":2,"webhooks":2,"aggregate":2,"email":2,"smsEvents":2,"whatsapp":3}
