# env/app.env: the web, worker and admin containers' settings and secrets (mode 600, never in Git).
# A new copy of the server takes the app's secrets from the running project's env/app.env (saved as
# env/app.env.from-aws here, setup-env.sh merges it), beside the database lines below. The app's own settings (apps/aws/src/settings.ts) ship
# in the image; anything here wins over them.

# --- Where it runs
APP_URL=https://bizinsights.io
APP_ENVIRONMENT=production
LOG_LEVEL=info

# --- Database: this project's PostgreSQL. The two role passwords are the ones in env/owner.env
# (`admin migrate` sets them on the roles).
DATABASE_URL=postgresql://app_system:CHANGE_ME_SYSTEM_DB_PASSWORD@postgres:5432/app
APP_DATABASE_URL=postgresql://app_rls:CHANGE_ME_APP_RLS_PASSWORD@postgres:5432/app
# The WhatsApp service's own database, for the nightly prune of what it keeps (7 days).
EVOLUTION_DATABASE_URL=postgresql://evolution:CHANGE_ME_EVOLUTION_DB_PASSWORD@postgres:5432/evolution

# --- The app's own secrets: the ones production has always used, never regenerated, or every
# stored token, session and customer hash stops matching.
SESSION_SECRET=
TOKEN_ENCRYPTION_KEYS=
OTP_PEPPER=

# --- Providers (insights/production/app). One left empty turns that provider off.
SHOPIFY_API_SECRET=
# SHOPIFY_APP_SECRET_<KEY>=   one per extra Shopify app, as on AWS
META_APP_SECRET=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_SIGNIN_CLIENT_SECRET=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# --- Sign-in: the app's own (apps/api/src/localAuth.ts); nothing to set for passwords and emailed
# codes. Google on the app's own OAuth client, with GOOGLE_SIGNIN_CLIENT_SECRET above: its redirect
# URIs at Google must hold https://bizinsights.io/auth/callback.
GOOGLE_SIGNIN_CLIENT_ID=567753266621-ltq5j5kij5s3em8gr0err3tbrh5fqciq.apps.googleusercontent.com

# --- The WhatsApp service (the evolution container). EVOLUTION_API_KEY is also in env/evolution.env.
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_URL=http://web:8080/api

# --- The self-hosted runtime (apps/aws/src/selfhost.ts)
BLOB_DIR=/data/blobs
# The header Cloudflare puts the client's address in; "none" trusts none.
TRUSTED_IP_HEADER=cf-connecting-ip
# Jobs at once per queue in each worker, over the AWS defaults (2, 2, 2, 2, 3); keep the sum
# under the worker's DB_POOL_MAX (docker-compose.yml).
# QUEUE_CONCURRENCY={"sync":2,"webhooks":2,"aggregate":2,"email":2,"whatsapp":3}
