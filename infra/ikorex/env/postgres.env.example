# env/postgres.env: the postgres and backup containers.
# The owner's password: read only when the data volume is first created.
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

# pgBackRest's bucket off the server (Cloudflare R2: an R2 API token with Object Read & Write on this
# bucket only). Endpoint: <account id>.r2.cloudflarestorage.com
PGBACKREST_REPO1_S3_ENDPOINT=
PGBACKREST_REPO1_S3_BUCKET=bizinsights-backups
PGBACKREST_REPO1_S3_KEY=
PGBACKREST_REPO1_S3_KEY_SECRET=
# An AWS S3 bucket instead (production since 2026-11-13: bizinsights-backups-<account>, the IAM user
# bizinsights-backups): endpoint s3.ap-southeast-2.amazonaws.com, and these two over
# pgbackrest.conf's R2 values (an environment variable wins over the file).
# PGBACKREST_REPO1_S3_REGION=ap-southeast-2
# PGBACKREST_REPO1_S3_URI_STYLE=host
# Encrypts every backup before it leaves the server. Lose it and the backups can't be read: keep a
# copy in the owner's password manager, not only here.
PGBACKREST_REPO1_CIPHER_PASS=

# Production since 2026-11-13 08:18 UTC keeps its backups ONLY on the server's own disk (the
# owner's choice; lost with the server): no bucket lines above and no REPO2 lines below, and
# instead these two, which make the folder (the volume `pgbackups`) repo1. The passphrase stays.
# PGBACKREST_REPO1_TYPE=posix
# PGBACKREST_REPO1_PATH=/var/lib/pgbackrest-local

# With a bucket as repo1: a second copy of the backups and of the write-ahead log on this server's
# own disk (the volume `pgbackups`), beside the bucket: quick to restore from, and there when the
# bucket's provider is not. It is lost with the server. Encrypted like the bucket's, with the same
# passphrase. Uncomment all six to switch it on. (Never both this and the two lines above: one
# folder can't be two repositories.)
# PGBACKREST_REPO2_TYPE=posix
# PGBACKREST_REPO2_PATH=/var/lib/pgbackrest-local
# PGBACKREST_REPO2_CIPHER_TYPE=aes-256-cbc
# PGBACKREST_REPO2_CIPHER_PASS=
# PGBACKREST_REPO2_RETENTION_FULL_TYPE=time
# PGBACKREST_REPO2_RETENTION_FULL=14

# The external check the nightly backup pings (e.g. https://hc-ping.com/<uuid>); no ping in a day = alarm.
BACKUP_PING_URL=
BACKUP_HOUR_UTC=02
