# .env: what docker-compose.yml itself reads (no secrets here). scripts/deploy.sh sets APP_TAG.
APP_TAG=
# on only in production, from the cutover (docs/ikorex-migration)
SCHEDULES=off

# A server short of memory (under 8 GB): the smaller limits of docker-compose.lean.yml on top.
# COMPOSE_FILE=docker-compose.yml:docker-compose.lean.yml
# With those, and only while env/postgres.env has no backup bucket yet: don't keep the write-ahead
# log for a bucket that isn't there (it would fill the disk). Remove the line once the bucket is set.
# ARCHIVE_MODE=off
