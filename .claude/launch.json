{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "local",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@app/aws",
        "dev"
      ],
      "port": 8787
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@app/web",
        "dev"
      ],
      "port": 3001
    },
    {
      "name": "demo",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        ".claude/demo-server.mjs"
      ],
      "port": 8789
    },
    {
      "name": "ads-demo",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        ".claude/ads-demo-server.mjs"
      ],
      "port": 8789
    },
    {
      "name": "demo-nomail",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        ".claude/demo-server.mjs",
        "--no-mail"
      ],
      "port": 8789
    },
    {
      "name": "staff-demo",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        ".claude/staff-demo-server.mjs"
      ],
      "port": 8795
    },
    {
      "name": "staff-demo-nodocker",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        ".claude/staff-demo-server.mjs",
        "--pg",
        "5440",
        "--auth",
        "127.0.0.1:9199",
        "--mail",
        "http://localhost:8125"
      ],
      "port": 8795
    }
  ]
}
